1
00:00:00,000 --> 00:00:07,587
أَعُوذُ بِٱللَّهِ مِنَ الشَّيْطَانِ الرَّجِيم

2
00:00:07,588 --> 00:00:15,153
بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيم

3
00:00:15,154 --> 00:00:24,233
الٓمٓ ١

4
00:00:24,234 --> 00:00:30,293
ذَٰلِكَ ٱلۡكِتَٰبُ لَا رَيۡبَۛ فِيهِۛ

5
00:00:30,294 --> 00:00:34,407
هُدٗى لِّلۡمُتَّقِينَ ٢

6
00:00:34,408 --> 00:00:44,040
ٱلَّذِينَ يُؤۡمِنُونَ بِٱلۡغَيۡبِ وَيُقِيمُونَ ٱلصَّلَوٰةَ وَمِمَّا رَزَقۡنَٰهُمۡ

7
00:00:44,041 --> 00:00:52,407
وَمِمَّا رَزَقۡنَٰهُمۡ يُنفِقُونَ ٣

8
00:00:52,408 --> 00:01:06,287
وَٱلَّذِينَ يُؤۡمِنُونَ بِمَآ أُنزِلَ إِلَيۡكَ وَمَآ أُنزِلَ مِن قَبۡلِكَ

9
00:01:06,288 --> 00:01:17,647
وَمَآ أُنزِلَ مِن قَبۡلِكَ وَبِٱلۡأٓخِرَةِ هُمۡ يُوقِنُونَ ٤

10
00:01:17,648 --> 00:01:25,753
أُوْلَـٰٓئِكَ عَلَىٰ هُدٗى مِّن رَّبِّهِمۡۖ

11
00:01:25,754 --> 00:01:32,627
وَأُوْلَـٰٓئِكَ هُمُ ٱلۡمُفۡلِحُونَ ٥

12
00:01:32,628 --> 00:01:45,660
إِنَّ ٱلَّذِينَ كَفَرُواْ سَوَآءٌ عَلَيۡهِمۡ ءَأَنذَرۡتَهُمۡ

13
00:01:45,661 --> 00:01:54,693
ءَأَنذَرۡتَهُمۡ أَمۡ لَمۡ تُنذِرۡهُمۡ لَا يُؤۡمِنُونَ ٦

14
00:01:54,694 --> 00:02:01,513
خَتَمَ ٱللَّهُ عَلَىٰ قُلُوبِهِمۡ وَعَلَىٰ سَمۡعِهِمۡۖ

15
00:02:01,514 --> 00:02:09,060
وَعَلَىٰٓ أَبۡصَٰرِهِمۡ غِشَٰوَةٞۖ

16
00:02:09,061 --> 00:02:13,660
وَلَهُمۡ عَذَابٌ عَظِيمٞ ٧

17
00:02:13,661 --> 00:02:23,860
وَمِنَ ٱلنَّاسِ مَن يَقُولُ ءَامَنَّا بِٱللَّهِ وَبِٱلۡيَوۡمِ ٱلۡأٓخِرِ

18
00:02:23,861 --> 00:02:29,953
وَمَا هُم بِمُؤۡمِنِينَ ٨

19
00:02:29,954 --> 00:02:40,180
يُخَٰدِعُونَ ٱللَّهَ وَٱلَّذِينَ ءَامَنُواْ وَمَا يَخۡدَعُونَ إِلَّآ أَنفُسَهُمۡ

20
00:02:40,181 --> 00:02:50,020
وَمَا يَخۡدَعُونَ إِلَّآ أَنفُسَهُمۡ وَمَا يَشۡعُرُونَ ٩

21
00:02:50,021 --> 00:02:59,893
فِي قُلُوبِهِم مَّرَضٞ فَزَادَهُمُ ٱللَّهُ مَرَضٗاۖ

22
00:02:59,894 --> 00:03:08,293
وَلَهُمۡ عَذَابٌ أَلِيمُۢ بِمَا كَانُواْ يَكۡذِبُونَ ١٠

23
00:03:08,294 --> 00:03:14,773
وَإِذَا قِيلَ لَهُمۡ لَا تُفۡسِدُواْ فِي ٱلۡأَرۡضِ قَالُوٓاْ

24
00:03:14,774 --> 00:03:22,880
قَالُوٓاْ إِنَّمَا نَحۡنُ مُصۡلِحُونَ ١١

25
00:03:22,881 --> 00:03:32,913
أَلَآ إِنَّهُمۡ هُمُ ٱلۡمُفۡسِدُونَ وَلَٰكِن لَّا يَشۡعُرُونَ ١٢

26
00:03:32,914 --> 00:03:42,947
وَإِذَا قِيلَ لَهُمۡ ءَامِنُواْ كَمَآ ءَامَنَ ٱلنَّاسُ قَالُوٓاْ

27
00:03:42,948 --> 00:03:52,860
قَالُوٓاْ أَنُؤۡمِنُ كَمَآ ءَامَنَ ٱلسُّفَهَآءُۗ

28
00:03:52,861 --> 00:04:06,900
أَلَآ إِنَّهُمۡ هُمُ ٱلسُّفَهَآءُ وَلَٰكِن لَّا يَعۡلَمُونَ ١٣

29
00:04:06,901 --> 00:04:15,847
وَإِذَا لَقُواْ ٱلَّذِينَ ءَامَنُواْ قَالُوٓاْ ءَامَنَّا

30
00:04:15,848 --> 00:04:26,867
قَالُوٓاْ ءَامَنَّا وَإِذَا خَلَوۡاْ إِلَىٰ شَيَٰطِينِهِمۡ قَالُوٓاْ

31
00:04:26,868 --> 00:04:38,120
قَالُوٓاْ إِنَّا مَعَكُمۡ إِنَّمَا نَحۡنُ مُسۡتَهۡزِءُونَ ١٤

32
00:04:38,121 --> 00:04:47,700
ٱللَّهُ يَسۡتَهۡزِئُ بِهِمۡ وَيَمُدُّهُمۡ فِي طُغۡيَٰنِهِمۡ يَعۡمَهُونَ ١٥

33
00:04:47,701 --> 00:04:59,653
أُوْلَـٰٓئِكَ ٱلَّذِينَ ٱشۡتَرَوُاْ ٱلضَّلَٰلَةَ بِٱلۡهُدَىٰ فَمَا رَبِحَت تِّجَٰرَتُهُمۡ

34
00:04:59,654 --> 00:05:07,987
فَمَا رَبِحَت تِّجَٰرَتُهُمۡ وَمَا كَانُواْ مُهۡتَدِينَ ١٦

35
00:05:07,988 --> 00:05:21,740
مَثَلُهُمۡ كَمَثَلِ ٱلَّذِي ٱسۡتَوۡقَدَ نَارٗا فَلَمَّآ أَضَآءَتۡ

36
00:05:21,741 --> 00:05:35,320
فَلَمَّآ أَضَآءَتۡ مَا حَوۡلَهُۥ ذَهَبَ ٱللَّهُ بِنُورِهِمۡ وَتَرَكَهُمۡ

37
00:05:35,321 --> 00:05:42,353
وَتَرَكَهُمۡ فِي ظُلُمَٰتٖ لَّا يُبۡصِرُونَ ١٧

38
00:05:42,354 --> 00:05:52,420
صُمُّۢ بُكۡمٌ عُمۡيٞ فَهُمۡ لَا يَرۡجِعُونَ ١٨

39
00:05:52,421 --> 00:06:05,367
أَوۡ كَصَيِّبٖ مِّنَ ٱلسَّمَآءِ فِيهِ ظُلُمَٰتٞ وَرَعۡدٞ وَبَرۡقٞ

40
00:06:05,368 --> 00:06:16,753
فِيهِ ظُلُمَٰتٞ وَرَعۡدٞ وَبَرۡقٞ يَجۡعَلُونَ أَصَٰبِعَهُمۡ فِيٓ ءَاذَانِهِم

41
00:06:16,754 --> 00:06:28,580
يَجۡعَلُونَ أَصَٰبِعَهُمۡ فِيٓ ءَاذَانِهِم مِّنَ ٱلصَّوَٰعِقِ حَذَرَ ٱلۡمَوۡتِۚ

42
00:06:28,581 --> 00:06:35,333
وَٱللَّهُ مُحِيطُۢ بِٱلۡكَٰفِرِينَ ١٩

43
00:06:35,334 --> 00:06:48,253
يَكَادُ ٱلۡبَرۡقُ يَخۡطَفُ أَبۡصَٰرَهُمۡۖ كُلَّمَآ أَضَآءَ لَهُم مَّشَوۡاْ فِيهِ

44
00:06:48,254 --> 00:07:00,933
كُلَّمَآ أَضَآءَ لَهُم مَّشَوۡاْ فِيهِ وَإِذَآ أَظۡلَمَ عَلَيۡهِمۡ قَامُواْۚ

45
00:07:00,934 --> 00:07:10,747
وَلَوۡ شَآءَ ٱللَّهُ لَذَهَبَ بِسَمۡعِهِمۡ وَأَبۡصَٰرِهِمۡۚ

46
00:07:10,748 --> 00:07:19,407
إِنَّ ٱللَّهَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ ٢٠

47
00:07:19,408 --> 00:07:32,340
يَـٰٓأَيُّهَا ٱلنَّاسُ ٱعۡبُدُواْ رَبَّكُمُ ٱلَّذِي خَلَقَكُمۡ وَٱلَّذِينَ مِن قَبۡلِكُمۡ

48
00:07:32,560 --> 00:07:41,933
وَٱلَّذِينَ مِن قَبۡلِكُمۡ لَعَلَّكُمۡ تَتَّقُونَ ٢١

49
00:07:41,934 --> 00:07:55,067
ٱلَّذِي جَعَلَ لَكُمُ ٱلۡأَرۡضَ فِرَٰشٗا وَٱلسَّمَآءَ بِنَآءٗ وَأَنزَلَ

50
00:07:55,068 --> 00:08:09,940
وَأَنزَلَ مِنَ ٱلسَّمَآءِ مَآءٗ فَأَخۡرَجَ بِهِۦ مِنَ ٱلثَّمَرَٰتِ رِزۡقٗا لَّكُمۡۖ

51
00:08:09,941 --> 00:08:20,760
فَلَا تَجۡعَلُواْ لِلَّهِ أَندَادٗا وَأَنتُمۡ تَعۡلَمُونَ ٢٢

52
00:08:20,761 --> 00:08:34,187
وَإِن كُنتُمۡ فِي رَيۡبٖ مِّمَّا نَزَّلۡنَا عَلَىٰ عَبۡدِنَا فَأۡتُواْ بِسُورَةٖ

53
00:08:34,188 --> 00:08:43,880
فَأۡتُواْ بِسُورَةٖ مِّن مِّثۡلِهِۦ وَٱدۡعُواْ شُهَدَآءَكُم

54
00:08:43,881 --> 00:08:58,060
وَٱدۡعُواْ شُهَدَآءَكُم مِّن دُونِ ٱللَّهِ إِن كُنتُمۡ صَٰدِقِينَ ٢٣

55
00:08:58,061 --> 00:09:06,507
فَإِن لَّمۡ تَفۡعَلُواْ وَلَن تَفۡعَلُواْ فَٱتَّقُواْ ٱلنَّارَ

56
00:09:06,508 --> 00:09:15,000
فَٱتَّقُواْ ٱلنَّارَ ٱلَّتِي وَقُودُهَا ٱلنَّاسُ وَٱلۡحِجَارَةُۖ

57
00:09:15,001 --> 00:09:19,533
أُعِدَّتۡ لِلۡكَٰفِرِينَ ٢٤

58
00:09:19,534 --> 00:09:23,787
وَبَشِّرِ ٱلَّذِينَ ءَامَنُواْ

59
00:09:23,788 --> 00:09:38,487
وَبَشِّرِ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ أَنَّ لَهُمۡ جَنَّـٰتٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُۖ

60
00:09:38,488 --> 00:09:48,167
كُلَّمَا رُزِقُواْ مِنۡهَا مِن ثَمَرَةٖ رِّزۡقٗا قَالُواْ

61
00:09:48,168 --> 00:09:58,533
قَالُواْ هَٰذَا ٱلَّذِي رُزِقۡنَا مِن قَبۡلُۖ وَأُتُواْ بِهِۦ مُتَشَٰبِهٗاۖ

62
00:09:58,534 --> 00:10:09,820
وَأُتُواْ بِهِۦ مُتَشَٰبِهٗاۖ وَلَهُمۡ فِيهَآ أَزۡوَٰجٞ مُّطَهَّرَةٞۖ

63
00:10:09,821 --> 00:10:15,940
وَهُمۡ فِيهَا خَٰلِدُونَ ٢٥

64
00:10:15,941 --> 00:10:29,333
إِنَّ ٱللَّهَ لَا يَسۡتَحۡيِۦٓ أَن يَضۡرِبَ مَثَلٗا مَّا بَعُوضَةٗ فَمَا فَوۡقَهَاۚ

65
00:10:29,334 --> 00:10:39,240
فَأَمَّا ٱلَّذِينَ ءَامَنُواْ فَيَعۡلَمُونَ أَنَّهُ ٱلۡحَقُّ مِن رَّبِّهِمۡۖ

66
00:10:39,241 --> 00:10:51,520
وَأَمَّا ٱلَّذِينَ كَفَرُواْ فَيَقُولُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَٰذَا مَثَلٗاۘ

67
00:10:51,521 --> 00:10:59,607
يُضِلُّ بِهِۦ كَثِيرٗا وَيَهۡدِي بِهِۦ كَثِيرٗاۚ

68
00:10:59,608 --> 00:11:07,133
وَمَا يُضِلُّ بِهِۦٓ إِلَّا ٱلۡفَٰسِقِينَ ٢٦

69
00:11:07,134 --> 00:11:19,813
ٱلَّذِينَ يَنقُضُونَ عَهۡدَ ٱللَّهِ مِنۢ بَعۡدِ مِيثَٰقِهِۦ وَيَقۡطَعُونَ

70
00:11:19,814 --> 00:11:28,980
وَيَقۡطَعُونَ مَآ أَمَرَ ٱللَّهُ بِهِۦٓ أَن يُوصَلَ

71
00:11:28,981 --> 00:11:39,573
وَيَقۡطَعُونَ مَآ أَمَرَ ٱللَّهُ بِهِۦٓ أَن يُوصَلَ وَيُفۡسِدُونَ فِي ٱلۡأَرۡضِۚ

72
00:11:39,574 --> 00:11:47,300
أُوْلَـٰٓئِكَ هُمُ ٱلۡخَٰسِرُونَ ٢٧

73
00:11:47,301 --> 00:11:57,060
كَيۡفَ تَكۡفُرُونَ بِٱللَّهِ وَكُنتُمۡ أَمۡوَٰتٗا فَأَحۡيَٰكُمۡۖ

74
00:11:57,061 --> 00:12:05,200
فَأَحۡيَٰكُمۡۖ ثُمَّ يُمِيتُكُمۡ ثُمَّ يُحۡيِيكُمۡ

75
00:12:05,201 --> 00:12:13,627
ثُمَّ يُحۡيِيكُمۡ ثُمَّ إِلَيۡهِ تُرۡجَعُونَ ٢٨

76
00:12:13,628 --> 00:12:29,633
هُوَ ٱلَّذِي خَلَقَ لَكُم مَّا فِي ٱلۡأَرۡضِ جَمِيعٗا ثُمَّ ٱسۡتَوَىٰٓ إِلَى ٱلسَّمَآءِ فَسَوَّىٰهُنَّ

77
00:12:29,634 --> 00:12:36,340
فَسَوَّىٰهُنَّ سَبۡعَ سَمَٰوَٰتٖۚ

78
00:12:36,341 --> 00:12:42,560
وَهُوَ بِكُلِّ شَيۡءٍ عَلِيمٞ ٢٩

79
00:12:42,561 --> 00:12:54,607
وَإِذۡ قَالَ رَبُّكَ لِلۡمَلَـٰٓئِكَةِ إِنِّي جَاعِلٞ فِي ٱلۡأَرۡضِ خَلِيفَةٗۖ

80
00:12:54,608 --> 00:13:05,753
قَالُوٓاْ أَتَجۡعَلُ فِيهَا مَن يُفۡسِدُ فِيهَا وَيَسۡفِكُ ٱلدِّمَآءَ

81
00:13:05,754 --> 00:13:15,940
وَيَسۡفِكُ ٱلدِّمَآءَ وَنَحۡنُ نُسَبِّحُ بِحَمۡدِكَ وَنُقَدِّسُ لَكَۖ

82
00:13:15,941 --> 00:13:24,080
قَالَ إِنِّيٓ أَعۡلَمُ مَا لَا تَعۡلَمُونَ ٣٠

83
00:13:24,081 --> 00:13:36,120
وَعَلَّمَ ءَادَمَ ٱلۡأَسۡمَآءَ كُلَّهَا ثُمَّ عَرَضَهُمۡ عَلَى ٱلۡمَلَـٰٓئِكَةِ

84
00:13:36,121 --> 00:13:52,493
ثُمَّ عَرَضَهُمۡ عَلَى ٱلۡمَلَـٰٓئِكَةِ فَقَالَ أَنۢبِـُٔونِي بِأَسۡمَآءِ هَـٰٓؤُلَآءِ

85
00:13:52,494 --> 00:14:08,047
فَقَالَ أَنۢبِـُٔونِي بِأَسۡمَآءِ هَـٰٓؤُلَآءِ إِن كُنتُمۡ صَٰدِقِينَ ٣١

86
00:14:08,048 --> 00:14:17,067
قَالُواْ سُبۡحَٰنَكَ لَا عِلۡمَ لَنَآ إِلَّا مَا عَلَّمۡتَنَآۖ

87
00:14:17,068 --> 00:14:24,160
إِنَّكَ أَنتَ ٱلۡعَلِيمُ ٱلۡحَكِيمُ ٣٢

88
00:14:24,161 --> 00:14:36,633
قَالَ يَـٰٓـَٔادَمُ أَنۢبِئۡهُم بِأَسۡمَآئِهِمۡۖ

89
00:14:36,634 --> 00:14:48,540
فَلَمَّآ أَنۢبَأَهُم بِأَسۡمَآئِهِمۡ قَالَ أَلَمۡ أَقُل لَّكُمۡ

90
00:14:48,541 --> 00:14:59,560
قَالَ أَلَمۡ أَقُل لَّكُمۡ إِنِّيٓ أَعۡلَمُ غَيۡبَ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَأَعۡلَمُ

91
00:14:59,561 --> 00:15:08,093
وَأَعۡلَمُ مَا تُبۡدُونَ وَمَا كُنتُمۡ تَكۡتُمُونَ ٣٣

92
00:15:08,094 --> 00:15:21,800
وَإِذۡ قُلۡنَا لِلۡمَلَـٰٓئِكَةِ ٱسۡجُدُواْ لِأٓدَمَ فَسَجَدُوٓاْ إِلَّآ إِبۡلِيسَ

93
00:15:21,801 --> 00:15:35,000
فَسَجَدُوٓاْ إِلَّآ إِبۡلِيسَ أَبَىٰ وَٱسۡتَكۡبَرَ وَكَانَ مِنَ ٱلۡكَٰفِرِينَ ٣٤

94
00:15:35,001 --> 00:15:44,807
وَقُلۡنَا يَـٰٓـَٔادَمُ ٱسۡكُنۡ أَنتَ وَزَوۡجُكَ ٱلۡجَنَّةَ

95
00:15:44,808 --> 00:15:53,493
وَكُلَا مِنۡهَا رَغَدًا حَيۡثُ شِئۡتُمَا وَلَا تَقۡرَبَا هَٰذِهِ ٱلشَّجَرَةَ

96
00:15:53,494 --> 00:16:02,920
وَلَا تَقۡرَبَا هَٰذِهِ ٱلشَّجَرَةَ فَتَكُونَا مِنَ ٱلظَّـٰلِمِينَ ٣٥

97
00:16:02,921 --> 00:16:13,307
فَأَزَلَّهُمَا ٱلشَّيۡطَٰنُ عَنۡهَا فَأَخۡرَجَهُمَا مِمَّا كَانَا فِيهِۖ

98
00:16:13,308 --> 00:16:18,513
وَقُلۡنَا ٱهۡبِطُواْ بَعۡضُكُمۡ لِبَعۡضٍ عَدُوّٞۖ

99
00:16:18,514 --> 00:16:28,387
وَلَكُمۡ فِي ٱلۡأَرۡضِ مُسۡتَقَرّٞ وَمَتَٰعٌ إِلَىٰ حِينٖ ٣٦

100
00:16:28,388 --> 00:16:39,800
فَتَلَقَّىٰٓ ءَادَمُ مِن رَّبِّهِۦ كَلِمَٰتٖ فَتَابَ عَلَيۡهِۚ

101
00:16:39,801 --> 00:16:48,140
إِنَّهُۥ هُوَ ٱلتَّوَّابُ ٱلرَّحِيمُ ٣٧

102
00:16:48,141 --> 00:16:52,873
قُلۡنَا ٱهۡبِطُواْ مِنۡهَا جَمِيعٗاۖ

103
00:16:52,874 --> 00:17:06,093
فَإِمَّا يَأۡتِيَنَّكُم مِّنِّي هُدٗى فَمَن تَبِعَ هُدَايَ

104
00:17:06,094 --> 00:17:15,640
فَمَن تَبِعَ هُدَايَ فَلَا خَوۡفٌ عَلَيۡهِمۡ وَلَا هُمۡ يَحۡزَنُونَ ٣٨

105
00:17:15,641 --> 00:17:26,213
وَٱلَّذِينَ كَفَرُواْ وَكَذَّبُواْ بِـَٔايَٰتِنَآ أُوْلَـٰٓئِكَ

106
00:17:26,214 --> 00:17:36,027
أُوْلَـٰٓئِكَ أَصۡحَٰبُ ٱلنَّارِۖ هُمۡ فِيهَا خَٰلِدُونَ ٣٩

107
00:17:36,028 --> 00:17:49,747
يَٰبَنِيٓ إِسۡرَـٰٓءِيلَ ٱذۡكُرُواْ نِعۡمَتِيَ ٱلَّتِيٓ أَنۡعَمۡتُ عَلَيۡكُمۡ وَأَوۡفُواْ

108
00:17:49,748 --> 00:17:59,520
وَأَوۡفُواْ بِعَهۡدِيٓ أُوفِ بِعَهۡدِكُمۡ وَإِيَّـٰيَ فَٱرۡهَبُونِ ٤٠

109
00:17:59,521 --> 00:18:13,220
وَءَامِنُواْ بِمَآ أَنزَلۡتُ مُصَدِّقٗا لِّمَا مَعَكُمۡ وَلَا تَكُونُوٓاْ أَوَّلَ كَافِرِۭ بِهِۦۖ

110
00:18:13,221 --> 00:18:24,373
وَلَا تَكُونُوٓاْ أَوَّلَ كَافِرِۭ بِهِۦۖ وَلَا تَشۡتَرُواْ بِـَٔايَٰتِي

111
00:18:24,374 --> 00:18:35,507
وَلَا تَشۡتَرُواْ بِـَٔايَٰتِي ثَمَنٗا قَلِيلٗا وَإِيَّـٰيَ فَٱتَّقُونِ ٤١

112
00:18:35,508 --> 00:18:46,513
وَلَا تَلۡبِسُواْ ٱلۡحَقَّ بِٱلۡبَٰطِلِ وَتَكۡتُمُواْ ٱلۡحَقَّ وَأَنتُمۡ تَعۡلَمُونَ ٤٢

113
00:18:46,514 --> 00:18:56,247
وَأَقِيمُواْ ٱلصَّلَوٰةَ وَءَاتُواْ ٱلزَّكَوٰةَ وَٱرۡكَعُواْ مَعَ ٱلرَّـٰكِعِينَ ٤٣

114
00:18:56,248 --> 00:19:10,627
أَتَأۡمُرُونَ ٱلنَّاسَ بِٱلۡبِرِّ وَتَنسَوۡنَ أَنفُسَكُمۡ وَأَنتُمۡ تَتۡلُونَ ٱلۡكِتَٰبَۚ

115
00:19:10,628 --> 00:19:16,060
أَفَلَا تَعۡقِلُونَ ٤٤

116
00:19:16,061 --> 00:19:22,300
وَٱسۡتَعِينُواْ بِٱلصَّبۡرِ وَٱلصَّلَوٰةِۚ

117
00:19:22,301 --> 00:19:28,580
وَٱسۡتَعِينُواْ بِٱلصَّبۡرِ وَٱلصَّلَوٰةِۚ

118
00:19:28,581 --> 00:19:36,933
وَإِنَّهَا لَكَبِيرَةٌ إِلَّا عَلَى ٱلۡخَٰشِعِينَ ٤٥

119
00:19:36,934 --> 00:19:46,640
ٱلَّذِينَ يَظُنُّونَ أَنَّهُم مُّلَٰقُواْ رَبِّهِمۡ وَأَنَّهُمۡ

120
00:19:46,641 --> 00:19:53,107
وَأَنَّهُمۡ إِلَيۡهِ رَٰجِعُونَ ٤٦

121
00:19:53,108 --> 00:20:07,620
يَٰبَنِيٓ إِسۡرَـٰٓءِيلَ ٱذۡكُرُواْ نِعۡمَتِيَ ٱلَّتِيٓ أَنۡعَمۡتُ عَلَيۡكُمۡ وَأَنِّي

122
00:20:07,621 --> 00:20:15,167
وَأَنِّي فَضَّلۡتُكُمۡ عَلَى ٱلۡعَٰلَمِينَ ٤٧

123
00:20:15,168 --> 00:20:26,940
وَٱتَّقُواْ يَوۡمٗا لَّا تَجۡزِي نَفۡسٌ عَن نَّفۡسٖ شَيۡـٔٗا وَلَا يُقۡبَلُ مِنۡهَا شَفَٰعَةٞ

124
00:20:26,941 --> 00:20:38,860
وَلَا يُقۡبَلُ مِنۡهَا شَفَٰعَةٞ وَلَا يُؤۡخَذُ مِنۡهَا عَدۡلٞ وَلَا هُمۡ يُنصَرُونَ ٤٨

125
00:20:38,861 --> 00:20:50,933
وَإِذۡ نَجَّيۡنَٰكُم مِّنۡ ءَالِ فِرۡعَوۡنَ يَسُومُونَكُمۡ سُوٓءَ ٱلۡعَذَابِ

126
00:20:50,934 --> 00:21:00,780
يُذَبِّحُونَ أَبۡنَآءَكُمۡ وَيَسۡتَحۡيُونَ نِسَآءَكُمۡۚ

127
00:21:00,781 --> 00:21:10,907
وَفِي ذَٰلِكُم بَلَآءٞ مِّن رَّبِّكُمۡ عَظِيمٞ ٤٩

128
00:21:10,908 --> 00:21:24,287
وَإِذۡ فَرَقۡنَا بِكُمُ ٱلۡبَحۡرَ فَأَنجَيۡنَٰكُمۡ وَأَغۡرَقۡنَآ ءَالَ فِرۡعَوۡنَ

129
00:21:24,288 --> 00:21:35,933
وَأَغۡرَقۡنَآ ءَالَ فِرۡعَوۡنَ وَأَنتُمۡ تَنظُرُونَ ٥٠

130
00:21:35,934 --> 00:21:48,200
وَإِذۡ وَٰعَدۡنَا مُوسَىٰٓ أَرۡبَعِينَ لَيۡلَةٗ ثُمَّ ٱتَّخَذۡتُمُ ٱلۡعِجۡلَ

131
00:21:48,500 --> 00:21:59,367
ثُمَّ ٱتَّخَذۡتُمُ ٱلۡعِجۡلَ مِنۢ بَعۡدِهِۦ وَأَنتُمۡ ظَٰلِمُونَ ٥١

132
00:21:59,368 --> 00:22:11,120
ثُمَّ عَفَوۡنَا عَنكُم مِّنۢ بَعۡدِ ذَٰلِكَ لَعَلَّكُمۡ تَشۡكُرُونَ ٥٢

133
00:22:11,121 --> 00:22:20,560
وَإِذۡ ءَاتَيۡنَا مُوسَى ٱلۡكِتَٰبَ وَٱلۡفُرۡقَانَ لَعَلَّكُمۡ تَهۡتَدُونَ ٥٣

134
00:22:20,561 --> 00:22:35,220
وَإِذۡ قَالَ مُوسَىٰ لِقَوۡمِهِۦ يَٰقَوۡمِ إِنَّكُمۡ ظَلَمۡتُمۡ أَنفُسَكُم بِٱتِّخَاذِكُمُ ٱلۡعِجۡلَ فَتُوبُوٓاْ

135
00:22:35,221 --> 00:22:46,000
فَتُوبُوٓاْ إِلَىٰ بَارِئِكُمۡ فَٱقۡتُلُوٓاْ أَنفُسَكُمۡ

136
00:22:46,001 --> 00:22:58,520
فَٱقۡتُلُوٓاْ أَنفُسَكُمۡ ذَٰلِكُمۡ خَيۡرٞ لَّكُمۡ عِندَ بَارِئِكُمۡ فَتَابَ عَلَيۡكُمۡۚ

137
00:22:58,521 --> 00:23:05,480
إِنَّهُۥ هُوَ ٱلتَّوَّابُ ٱلرَّحِيمُ ٥٤

138
00:23:05,481 --> 00:23:13,773
وَإِذۡ قُلۡتُمۡ يَٰمُوسَىٰ لَن نُّؤۡمِنَ لَكَ حَتَّىٰ نَرَى ٱللَّهَ جَهۡرَةٗ

139
00:23:13,774 --> 00:23:22,853
فَأَخَذَتۡكُمُ ٱلصَّـٰعِقَةُ وَأَنتُمۡ تَنظُرُونَ ٥٥

140
00:23:22,854 --> 00:23:33,493
ثُمَّ بَعَثۡنَٰكُم مِّنۢ بَعۡدِ مَوۡتِكُمۡ لَعَلَّكُمۡ تَشۡكُرُونَ ٥٦

141
00:23:33,494 --> 00:23:43,820
وَظَلَّلۡنَا عَلَيۡكُمُ ٱلۡغَمَامَ وَأَنزَلۡنَا عَلَيۡكُمُ ٱلۡمَنَّ وَٱلسَّلۡوَىٰۖ

142
00:23:43,821 --> 00:23:50,913
كُلُواْ مِن طَيِّبَٰتِ مَا رَزَقۡنَٰكُمۡۚ

143
00:23:50,914 --> 00:24:01,313
وَمَا ظَلَمُونَا وَلَٰكِن كَانُوٓاْ أَنفُسَهُمۡ يَظۡلِمُونَ ٥٧

144
00:24:01,314 --> 00:24:10,933
وَإِذۡ قُلۡنَا ٱدۡخُلُواْ هَٰذِهِ ٱلۡقَرۡيَةَ فَكُلُواْ مِنۡهَا حَيۡثُ شِئۡتُمۡ رَغَدٗا

145
00:24:10,934 --> 00:24:20,100
فَكُلُواْ مِنۡهَا حَيۡثُ شِئۡتُمۡ رَغَدٗا وَٱدۡخُلُواْ ٱلۡبَابَ سُجَّدٗا

146
00:24:20,101 --> 00:24:27,900
وَقُولُواْ حِطَّةٞ نَّغۡفِرۡ لَكُمۡ خَطَٰيَٰكُمۡۚ

147
00:24:27,901 --> 00:24:32,507
وَسَنَزِيدُ ٱلۡمُحۡسِنِينَ ٥٨

148
00:24:32,508 --> 00:24:39,987
فَبَدَّلَ ٱلَّذِينَ ظَلَمُواْ قَوۡلًا غَيۡرَ ٱلَّذِي قِيلَ لَهُمۡ

149
00:24:39,988 --> 00:24:54,833
فَأَنزَلۡنَا عَلَى ٱلَّذِينَ ظَلَمُواْ رِجۡزٗا مِّنَ ٱلسَّمَآءِ بِمَا كَانُواْ يَفۡسُقُونَ ٥٩

150
00:24:54,834 --> 00:25:04,853
وَإِذِ ٱسۡتَسۡقَىٰ مُوسَىٰ لِقَوۡمِهِۦ فَقُلۡنَا ٱضۡرِب بِّعَصَاكَ ٱلۡحَجَرَۖ فَٱنفَجَرَتۡ

151
00:25:04,854 --> 00:25:12,013
فَٱنفَجَرَتۡ مِنۡهُ ٱثۡنَتَا عَشۡرَةَ عَيۡنٗاۖ

152
00:25:12,014 --> 00:25:17,967
قَدۡ عَلِمَ كُلُّ أُنَاسٖ مَّشۡرَبَهُمۡۖ

153
00:25:17,968 --> 00:25:27,240
كُلُواْ وَٱشۡرَبُواْ مِن رِّزۡقِ ٱللَّهِ وَلَا تَعۡثَوۡاْ فِي ٱلۡأَرۡضِ مُفۡسِدِينَ ٦٠

154
00:25:27,241 --> 00:25:39,960
وَإِذۡ قُلۡتُمۡ يَٰمُوسَىٰ لَن نَّصۡبِرَ عَلَىٰ طَعَامٖ وَٰحِدٖ فَٱدۡعُ لَنَا رَبَّكَ

155
00:25:39,961 --> 00:25:53,513
فَٱدۡعُ لَنَا رَبَّكَ يُخۡرِجۡ لَنَا مِمَّا تُنۢبِتُ ٱلۡأَرۡضُ مِنۢ بَقۡلِهَا وَقِثَّآئِهَا

156
00:25:53,514 --> 00:26:02,927
وَقِثَّآئِهَا وَفُومِهَا وَعَدَسِهَا وَبَصَلِهَاۖ

157
00:26:02,928 --> 00:26:11,320
قَالَ أَتَسۡتَبۡدِلُونَ ٱلَّذِي هُوَ أَدۡنَىٰ بِٱلَّذِي هُوَ خَيۡرٌۚ

158
00:26:11,321 --> 00:26:19,600
ٱهۡبِطُواْ مِصۡرٗا فَإِنَّ لَكُم مَّا سَأَلۡتُمۡۗ

159
00:26:19,601 --> 00:26:32,460
وَضُرِبَتۡ عَلَيۡهِمُ ٱلذِّلَّةُ وَٱلۡمَسۡكَنَةُ وَبَآءُو بِغَضَبٖ مِّنَ ٱللَّهِۚ

160
00:26:32,461 --> 00:26:45,160
ذَٰلِكَ بِأَنَّهُمۡ كَانُواْ يَكۡفُرُونَ بِـَٔايَٰتِ ٱللَّهِ وَيَقۡتُلُونَ ٱلنَّبِيِّـۧنَ بِغَيۡرِ ٱلۡحَقِّۚ

161
00:26:45,161 --> 00:26:52,453
ذَٰلِكَ بِمَا عَصَواْ وَّكَانُواْ يَعۡتَدُونَ ٦١

162
00:26:52,454 --> 00:27:03,307
إِنَّ ٱلَّذِينَ ءَامَنُواْ وَٱلَّذِينَ هَادُواْ وَٱلنَّصَٰرَىٰ وَٱلصَّـٰبِـِٔينَ

163
00:27:03,308 --> 00:27:14,247
وَٱلنَّصَٰرَىٰ وَٱلصَّـٰبِـِٔينَ مَنۡ ءَامَنَ بِٱللَّهِ وَٱلۡيَوۡمِ ٱلۡأٓخِرِ وَعَمِلَ صَٰلِحٗا

164
00:27:14,248 --> 00:27:25,893
وَعَمِلَ صَٰلِحٗا فَلَهُمۡ أَجۡرُهُمۡ عِندَ رَبِّهِمۡ وَلَا خَوۡفٌ عَلَيۡهِمۡ

165
00:27:25,894 --> 00:27:32,560
وَلَا خَوۡفٌ عَلَيۡهِمۡ وَلَا هُمۡ يَحۡزَنُونَ ٦٢

166
00:27:32,561 --> 00:27:46,733
وَإِذۡ أَخَذۡنَا مِيثَٰقَكُمۡ وَرَفَعۡنَا فَوۡقَكُمُ ٱلطُّورَ خُذُواْ مَآ ءَاتَيۡنَٰكُم بِقُوَّةٖ وَٱذۡكُرُواْ

167
00:27:46,734 --> 00:27:52,680
وَٱذۡكُرُواْ مَا فِيهِ لَعَلَّكُمۡ تَتَّقُونَ ٦٣

168
00:27:52,681 --> 00:28:05,927
ثُمَّ تَوَلَّيۡتُم مِّنۢ بَعۡدِ ذَٰلِكَۖ فَلَوۡلَا فَضۡلُ ٱللَّهِ عَلَيۡكُمۡ وَرَحۡمَتُهُۥ لَكُنتُم

169
00:28:05,928 --> 00:28:12,147
لَكُنتُم مِّنَ ٱلۡخَٰسِرِينَ ٦٤

170
00:28:12,148 --> 00:28:20,260
وَلَقَدۡ عَلِمۡتُمُ ٱلَّذِينَ ٱعۡتَدَوۡاْ مِنكُمۡ فِي ٱلسَّبۡتِ فَقُلۡنَا لَهُمۡ

171
00:28:20,261 --> 00:28:26,473
فَقُلۡنَا لَهُمۡ كُونُواْ قِرَدَةً خَٰسِـِٔينَ ٦٥

172
00:28:26,474 --> 00:28:34,307
فَجَعَلۡنَٰهَا نَكَٰلٗا لِّمَا بَيۡنَ يَدَيۡهَا وَمَا خَلۡفَهَا

173
00:28:34,308 --> 00:28:38,667
وَمَوۡعِظَةٗ لِّلۡمُتَّقِينَ ٦٦

174
00:28:38,668 --> 00:28:49,653
وَإِذۡ قَالَ مُوسَىٰ لِقَوۡمِهِۦٓ إِنَّ ٱللَّهَ يَأۡمُرُكُمۡ أَن تَذۡبَحُواْ بَقَرَةٗۖ

175
00:28:49,654 --> 00:28:55,680
قَالُوٓاْ أَتَتَّخِذُنَا هُزُوٗاۖ

176
00:28:55,681 --> 00:29:03,393
قَالَ أَعُوذُ بِٱللَّهِ أَنۡ أَكُونَ مِنَ ٱلۡجَٰهِلِينَ ٦٧

177
00:29:03,394 --> 00:29:09,220
قَالُواْ ٱدۡعُ لَنَا رَبَّكَ يُبَيِّن لَّنَا مَا هِيَۚ

178
00:29:09,221 --> 00:29:22,393
قَالَ إِنَّهُۥ يَقُولُ إِنَّهَا بَقَرَةٞ لَّا فَارِضٞ وَلَا بِكۡرٌ عَوَانُۢ بَيۡنَ ذَٰلِكَۖ

179
00:29:22,394 --> 00:29:26,607
فَٱفۡعَلُواْ مَا تُؤۡمَرُونَ ٦٨

180
00:29:26,608 --> 00:29:33,373
قَالُواْ ٱدۡعُ لَنَا رَبَّكَ يُبَيِّن لَّنَا مَا لَوۡنُهَاۚ

181
00:29:33,374 --> 00:29:45,673
قَالَ إِنَّهُۥ يَقُولُ إِنَّهَا بَقَرَةٞ صَفۡرَآءُ فَاقِعٞ لَّوۡنُهَا

182
00:29:45,674 --> 00:29:55,260
صَفۡرَآءُ فَاقِعٞ لَّوۡنُهَا تَسُرُّ ٱلنَّـٰظِرِينَ ٦٩

183
00:29:55,261 --> 00:30:05,047
قَالُواْ ٱدۡعُ لَنَا رَبَّكَ يُبَيِّن لَّنَا مَا هِيَ إِنَّ ٱلۡبَقَرَ تَشَٰبَهَ عَلَيۡنَا

184
00:30:05,048 --> 00:30:15,200
وَإِنَّآ إِن شَآءَ ٱللَّهُ لَمُهۡتَدُونَ ٧٠

185
00:30:15,201 --> 00:30:25,273
قَالَ إِنَّهُۥ يَقُولُ إِنَّهَا بَقَرَةٞ لَّا ذَلُولٞ تُثِيرُ ٱلۡأَرۡضَ

186
00:30:25,274 --> 00:30:33,673
تُثِيرُ ٱلۡأَرۡضَ وَلَا تَسۡقِي ٱلۡحَرۡثَ مُسَلَّمَةٞ لَّا شِيَةَ فِيهَاۚ

187
00:30:33,674 --> 00:30:43,460
قَالُواْ ٱلۡـَٰٔنَ جِئۡتَ بِٱلۡحَقِّۚ فَذَبَحُوهَا وَمَا كَادُواْ يَفۡعَلُونَ ٧١

188
00:30:43,461 --> 00:30:50,987
وَإِذۡ قَتَلۡتُمۡ نَفۡسٗا فَٱدَّـٰرَ ٰٔتُمۡ فِيهَاۖ

189
00:30:50,988 --> 00:30:59,940
وَٱللَّهُ مُخۡرِجٞ مَّا كُنتُمۡ تَكۡتُمُونَ ٧٢

190
00:30:59,941 --> 00:31:04,100
فَقُلۡنَا ٱضۡرِبُوهُ بِبَعۡضِهَاۚ

191
00:31:04,101 --> 00:31:11,293
كَذَٰلِكَ يُحۡيِ ٱللَّهُ ٱلۡمَوۡتَىٰ وَيُرِيكُمۡ ءَايَٰتِهِۦ

192
00:31:11,294 --> 00:31:18,707
وَيُرِيكُمۡ ءَايَٰتِهِۦ لَعَلَّكُمۡ تَعۡقِلُونَ ٧٣

193
00:31:18,708 --> 00:31:28,153
ثُمَّ قَسَتۡ قُلُوبُكُم مِّنۢ بَعۡدِ ذَٰلِكَ فَهِيَ كَٱلۡحِجَارَةِ

194
00:31:28,154 --> 00:31:32,533
فَهِيَ كَٱلۡحِجَارَةِ أَوۡ أَشَدُّ قَسۡوَةٗۚ

195
00:31:32,534 --> 00:31:40,287
وَإِنَّ مِنَ ٱلۡحِجَارَةِ لَمَا يَتَفَجَّرُ مِنۡهُ ٱلۡأَنۡهَٰرُۚ

196
00:31:40,288 --> 00:31:48,253
وَإِنَّ مِنۡهَا لَمَا يَشَّقَّقُ فَيَخۡرُجُ مِنۡهُ ٱلۡمَآءُۚ

197
00:31:48,254 --> 00:31:55,880
وَإِنَّ مِنۡهَا لَمَا يَهۡبِطُ مِنۡ خَشۡيَةِ ٱللَّهِۗ

198
00:31:55,881 --> 00:32:03,400
وَمَا ٱللَّهُ بِغَٰفِلٍ عَمَّا تَعۡمَلُونَ ٧٤

199
00:32:03,401 --> 00:32:17,800
أَفَتَطۡمَعُونَ أَن يُؤۡمِنُواْ لَكُمۡ وَقَدۡ كَانَ فَرِيقٞ مِّنۡهُمۡ يَسۡمَعُونَ كَلَٰمَ ٱللَّهِ ثُمَّ يُحَرِّفُونَهُۥ

200
00:32:17,801 --> 00:32:27,420
ثُمَّ يُحَرِّفُونَهُۥ مِنۢ بَعۡدِ مَا عَقَلُوهُ وَهُمۡ يَعۡلَمُونَ ٧٥

201
00:32:27,421 --> 00:32:35,680
وَإِذَا لَقُواْ ٱلَّذِينَ ءَامَنُواْ قَالُوٓاْ ءَامَنَّا

202
00:32:35,681 --> 00:32:42,667
وَإِذَا خَلَا بَعۡضُهُمۡ إِلَىٰ بَعۡضٖ قَالُوٓاْ

203
00:32:42,668 --> 00:32:55,353
قَالُوٓاْ أَتُحَدِّثُونَهُم بِمَا فَتَحَ ٱللَّهُ عَلَيۡكُمۡ لِيُحَآجُّوكُم بِهِۦ

204
00:32:55,354 --> 00:33:06,027
لِيُحَآجُّوكُم بِهِۦ عِندَ رَبِّكُمۡۚ أَفَلَا تَعۡقِلُونَ ٧٦

205
00:33:06,028 --> 00:33:15,747
أَوَلَا يَعۡلَمُونَ أَنَّ ٱللَّهَ يَعۡلَمُ مَا يُسِرُّونَ وَمَا يُعۡلِنُونَ ٧٧

206
00:33:15,748 --> 00:33:29,453
وَمِنۡهُمۡ أُمِّيُّونَ لَا يَعۡلَمُونَ ٱلۡكِتَٰبَ إِلَّآ أَمَانِيَّ وَإِنۡ هُمۡ إِلَّا يَظُنُّونَ ٧٨

207
00:33:29,454 --> 00:33:41,547
فَوَيۡلٞ لِّلَّذِينَ يَكۡتُبُونَ ٱلۡكِتَٰبَ بِأَيۡدِيهِمۡ ثُمَّ يَقُولُونَ هَٰذَا مِنۡ عِندِ ٱللَّهِ

208
00:33:41,548 --> 00:33:52,393
ثُمَّ يَقُولُونَ هَٰذَا مِنۡ عِندِ ٱللَّهِ لِيَشۡتَرُواْ بِهِۦ ثَمَنٗا قَلِيلٗاۖ

209
00:33:52,394 --> 00:34:03,740
فَوَيۡلٞ لَّهُم مِّمَّا كَتَبَتۡ أَيۡدِيهِمۡ وَوَيۡلٞ لَّهُم مِّمَّا يَكۡسِبُونَ ٧٩

210
00:34:03,741 --> 00:34:15,053
وَقَالُواْ لَن تَمَسَّنَا ٱلنَّارُ إِلَّآ أَيَّامٗا مَّعۡدُودَةٗۚ

211
00:34:15,054 --> 00:34:25,313
قُلۡ أَتَّخَذۡتُمۡ عِندَ ٱللَّهِ عَهۡدٗا فَلَن يُخۡلِفَ ٱللَّهُ عَهۡدَهُۥٓۖ

212
00:34:25,314 --> 00:34:31,960
أَمۡ تَقُولُونَ عَلَى ٱللَّهِ مَا لَا تَعۡلَمُونَ ٨٠

213
00:34:31,961 --> 00:34:44,793
بَلَىٰۚ مَن كَسَبَ سَيِّئَةٗ وَأَحَٰطَتۡ بِهِۦ خَطِيٓـَٔتُهُۥ فَأُوْلَـٰٓئِكَ

214
00:34:44,794 --> 00:34:54,687
فَأُوْلَـٰٓئِكَ أَصۡحَٰبُ ٱلنَّارِۖ هُمۡ فِيهَا خَٰلِدُونَ ٨١

215
00:34:54,688 --> 00:35:05,227
وَٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ أُوْلَـٰٓئِكَ أَصۡحَٰبُ ٱلۡجَنَّةِۖ

216
00:35:05,228 --> 00:35:10,673
هُمۡ فِيهَا خَٰلِدُونَ ٨٢

217
00:35:10,674 --> 00:35:24,380
وَإِذۡ أَخَذۡنَا مِيثَٰقَ بَنِيٓ إِسۡرَـٰٓءِيلَ لَا تَعۡبُدُونَ إِلَّا ٱللَّهَ وَبِٱلۡوَٰلِدَيۡنِ إِحۡسَانٗا

218
00:35:24,381 --> 00:35:37,067
وَبِٱلۡوَٰلِدَيۡنِ إِحۡسَانٗا وَذِي ٱلۡقُرۡبَىٰ وَٱلۡيَتَٰمَىٰ وَٱلۡمَسَٰكِينِ وَقُولُواْ لِلنَّاسِ حُسۡنٗا

219
00:35:37,068 --> 00:35:47,820
وَأَقِيمُواْ ٱلصَّلَوٰةَ وَءَاتُواْ ٱلزَّكَوٰةَ ثُمَّ تَوَلَّيۡتُمۡ إِلَّا قَلِيلٗا مِّنكُمۡ

220
00:35:47,821 --> 00:36:00,353
ثُمَّ تَوَلَّيۡتُمۡ إِلَّا قَلِيلٗا مِّنكُمۡ وَأَنتُم مُّعۡرِضُونَ ٨٣

221
00:36:00,354 --> 00:36:12,827
وَإِذۡ أَخَذۡنَا مِيثَٰقَكُمۡ لَا تَسۡفِكُونَ دِمَآءَكُمۡ وَلَا تُخۡرِجُونَ أَنفُسَكُم

222
00:36:12,828 --> 00:36:23,933
وَلَا تُخۡرِجُونَ أَنفُسَكُم مِّن دِيَٰرِكُمۡ ثُمَّ أَقۡرَرۡتُمۡ

223
00:36:23,934 --> 00:36:31,953
ثُمَّ أَقۡرَرۡتُمۡ وَأَنتُمۡ تَشۡهَدُونَ ٨٤

224
00:36:31,954 --> 00:36:47,413
ثُمَّ أَنتُمۡ هَـٰٓؤُلَآءِ تَقۡتُلُونَ أَنفُسَكُمۡ وَتُخۡرِجُونَ

225
00:36:47,414 --> 00:36:57,713
وَتُخۡرِجُونَ فَرِيقٗا مِّنكُم مِّن دِيَٰرِهِمۡ تَظَٰهَرُونَ عَلَيۡهِم

226
00:36:57,714 --> 00:37:06,087
تَظَٰهَرُونَ عَلَيۡهِم بِٱلۡإِثۡمِ وَٱلۡعُدۡوَٰنِ

227
00:37:06,088 --> 00:37:15,700
وَإِن يَأۡتُوكُمۡ أُسَٰرَىٰ تُفَٰدُوهُمۡ وَهُوَ مُحَرَّمٌ عَلَيۡكُمۡ إِخۡرَاجُهُمۡۚ

228
00:37:15,701 --> 00:37:22,713
أَفَتُؤۡمِنُونَ بِبَعۡضِ ٱلۡكِتَٰبِ وَتَكۡفُرُونَ بِبَعۡضٖۚ

229
00:37:22,714 --> 00:37:35,807
فَمَا جَزَآءُ مَن يَفۡعَلُ ذَٰلِكَ مِنكُمۡ إِلَّا خِزۡيٞ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَاۖ

230
00:37:35,808 --> 00:37:46,067
وَيَوۡمَ ٱلۡقِيَٰمَةِ يُرَدُّونَ إِلَىٰٓ أَشَدِّ ٱلۡعَذَابِۗ

231
00:37:46,068 --> 00:37:53,793
وَمَا ٱللَّهُ بِغَٰفِلٍ عَمَّا تَعۡمَلُونَ ٨٥

232
00:37:53,794 --> 00:38:03,313
أُوْلَـٰٓئِكَ ٱلَّذِينَ ٱشۡتَرَوُاْ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا بِٱلۡأٓخِرَةِۖ

233
00:38:03,314 --> 00:38:12,013
فَلَا يُخَفَّفُ عَنۡهُمُ ٱلۡعَذَابُ وَلَا هُمۡ يُنصَرُونَ ٨٦

234
00:38:12,014 --> 00:38:21,620
وَلَقَدۡ ءَاتَيۡنَا مُوسَى ٱلۡكِتَٰبَ وَقَفَّيۡنَا مِنۢ بَعۡدِهِۦ بِٱلرُّسُلِۖ

235
00:38:21,621 --> 00:38:31,260
وَءَاتَيۡنَا عِيسَى ٱبۡنَ مَرۡيَمَ ٱلۡبَيِّنَٰتِ وَأَيَّدۡنَٰهُ بِرُوحِ ٱلۡقُدُسِۗ

236
00:38:31,261 --> 00:38:45,440
أَفَكُلَّمَا جَآءَكُمۡ رَسُولُۢ بِمَا لَا تَهۡوَىٰٓ أَنفُسُكُمُ ٱسۡتَكۡبَرۡتُمۡ

237
00:38:45,441 --> 00:38:55,747
فَفَرِيقٗا كَذَّبۡتُمۡ وَفَرِيقٗا تَقۡتُلُونَ ٨٧

238
00:38:55,748 --> 00:39:04,793
وَقَالُواْ قُلُوبُنَا غُلۡفُۢۚ بَل لَّعَنَهُمُ ٱللَّهُ بِكُفۡرِهِمۡ

239
00:39:04,794 --> 00:39:15,167
بَل لَّعَنَهُمُ ٱللَّهُ بِكُفۡرِهِمۡ فَقَلِيلٗا مَّا يُؤۡمِنُونَ ٨٨

240
00:39:15,168 --> 00:39:28,120
وَلَمَّا جَآءَهُمۡ كِتَٰبٞ مِّنۡ عِندِ ٱللَّهِ مُصَدِّقٞ لِّمَا مَعَهُمۡ

241
00:39:28,121 --> 00:39:41,133
مُصَدِّقٞ لِّمَا مَعَهُمۡ وَكَانُواْ مِن قَبۡلُ يَسۡتَفۡتِحُونَ عَلَى ٱلَّذِينَ كَفَرُواْ فَلَمَّا

242
00:39:41,134 --> 00:39:50,247
فَلَمَّا جَآءَهُم مَّا عَرَفُواْ كَفَرُواْ بِهِۦۚ

243
00:39:50,248 --> 00:39:56,133
فَلَعۡنَةُ ٱللَّهِ عَلَى ٱلۡكَٰفِرِينَ ٨٩

244
00:39:56,134 --> 00:40:15,720
بِئۡسَمَا ٱشۡتَرَوۡاْ بِهِۦٓ أَنفُسَهُمۡ أَن يَكۡفُرُواْ بِمَآ أَنزَلَ ٱللَّهُ بَغۡيًا أَن يُنَزِّلَ ٱللَّهُ مِن فَضۡلِهِۦ عَلَىٰ مَن يَشَآءُ مِنۡ عِبَادِهِۦۖ

245
00:40:15,721 --> 00:40:22,600
فَبَآءُو بِغَضَبٍ عَلَىٰ غَضَبٖۚ

246
00:40:22,601 --> 00:40:29,560
وَلِلۡكَٰفِرِينَ عَذَابٞ مُّهِينٞ ٩٠

247
00:40:29,561 --> 00:40:39,120
وَإِذَا قِيلَ لَهُمۡ ءَامِنُواْ بِمَآ أَنزَلَ ٱللَّهُ قَالُواْ

248
00:40:39,121 --> 00:40:49,647
قَالُواْ نُؤۡمِنُ بِمَآ أُنزِلَ عَلَيۡنَا وَيَكۡفُرُونَ بِمَا وَرَآءَهُۥ

249
00:40:49,648 --> 00:40:59,260
وَيَكۡفُرُونَ بِمَا وَرَآءَهُۥ وَهُوَ ٱلۡحَقُّ مُصَدِّقٗا لِّمَا مَعَهُمۡۗ

250
00:40:59,261 --> 00:41:14,027
قُلۡ فَلِمَ تَقۡتُلُونَ أَنۢبِيَآءَ ٱللَّهِ مِن قَبۡلُ إِن كُنتُم مُّؤۡمِنِينَ ٩١

251
00:41:14,028 --> 00:41:31,067
وَلَقَدۡ جَآءَكُم مُّوسَىٰ بِٱلۡبَيِّنَٰتِ ثُمَّ ٱتَّخَذۡتُمُ ٱلۡعِجۡلَ مِنۢ بَعۡدِهِۦ وَأَنتُمۡ ظَٰلِمُونَ ٩٢

252
00:41:31,068 --> 00:41:45,000
وَإِذۡ أَخَذۡنَا مِيثَٰقَكُمۡ وَرَفَعۡنَا فَوۡقَكُمُ ٱلطُّورَ خُذُواْ مَآ ءَاتَيۡنَٰكُم بِقُوَّةٖ وَٱسۡمَعُواْۖ

253
00:41:45,001 --> 00:41:49,507
قَالُواْ سَمِعۡنَا وَعَصَيۡنَا

254
00:41:49,508 --> 00:41:58,427
قَالُواْ سَمِعۡنَا وَعَصَيۡنَا وَأُشۡرِبُواْ فِي قُلُوبِهِمُ ٱلۡعِجۡلَ بِكُفۡرِهِمۡۚ

255
00:41:58,428 --> 00:42:10,787
قُلۡ بِئۡسَمَا يَأۡمُرُكُم بِهِۦٓ إِيمَٰنُكُمۡ إِن كُنتُم مُّؤۡمِنِينَ ٩٣

256
00:42:10,788 --> 00:42:26,187
قُلۡ إِن كَانَتۡ لَكُمُ ٱلدَّارُ ٱلۡأٓخِرَةُ عِندَ ٱللَّهِ خَالِصَةٗ مِّن دُونِ ٱلنَّاسِ

257
00:42:26,188 --> 00:42:35,593
فَتَمَنَّوُاْ ٱلۡمَوۡتَ إِن كُنتُمۡ صَٰدِقِينَ ٩٤

258
00:42:35,594 --> 00:42:44,993
وَلَن يَتَمَنَّوۡهُ أَبَدَۢا بِمَا قَدَّمَتۡ أَيۡدِيهِمۡۚ

259
00:42:44,994 --> 00:42:51,840
وَٱللَّهُ عَلِيمُۢ بِٱلظَّـٰلِمِينَ ٩٥

260
00:42:51,841 --> 00:43:00,940
وَلَتَجِدَنَّهُمۡ أَحۡرَصَ ٱلنَّاسِ عَلَىٰ حَيَوٰةٖ

261
00:43:00,941 --> 00:43:12,607
وَلَتَجِدَنَّهُمۡ أَحۡرَصَ ٱلنَّاسِ عَلَىٰ حَيَوٰةٖ وَمِنَ ٱلَّذِينَ أَشۡرَكُواْۚ

262
00:43:12,608 --> 00:43:26,240
يَوَدُّ أَحَدُهُمۡ لَوۡ يُعَمَّرُ أَلۡفَ سَنَةٖ وَمَا هُوَ بِمُزَحۡزِحِهِۦ مِنَ ٱلۡعَذَابِ أَن يُعَمَّرَۗ

263
00:43:26,241 --> 00:43:32,420
وَٱللَّهُ بَصِيرُۢ بِمَا يَعۡمَلُونَ ٩٦

264
00:43:32,421 --> 00:43:45,293
قُلۡ مَن كَانَ عَدُوّٗا لِّـجِبۡرِيلَ فَإِنَّهُۥ نَزَّلَهُۥ عَلَىٰ قَلۡبِكَ بِإِذۡنِ ٱللَّهِ

265
00:43:45,294 --> 00:43:59,167
فَإِنَّهُۥ نَزَّلَهُۥ عَلَىٰ قَلۡبِكَ بِإِذۡنِ ٱللَّهِ مُصَدِّقٗا لِّمَا بَيۡنَ يَدَيۡهِ وَهُدٗى وَبُشۡرَىٰ

266
00:43:59,168 --> 00:44:06,713
وَهُدٗى وَبُشۡرَىٰ لِلۡمُؤۡمِنِينَ ٩٧

267
00:44:06,714 --> 00:44:24,920
مَن كَانَ عَدُوّٗا لِّلَّهِ وَمَلَـٰٓئِكَتِهِۦ وَرُسُلِهِۦ وَجِبۡرِيلَ وَمِيكَىٰلَ فَإِنَّ ٱللَّهَ عَدُوّٞ لِّلۡكَٰفِرِينَ ٩٨

268
00:44:24,921 --> 00:44:36,733
وَلَقَدۡ أَنزَلۡنَآ إِلَيۡكَ ءَايَٰتِۭ بَيِّنَٰتٖۖ

269
00:44:36,734 --> 00:44:45,933
وَمَا يَكۡفُرُ بِهَآ إِلَّا ٱلۡفَٰسِقُونَ ٩٩

270
00:44:45,934 --> 00:44:54,540
أَوَكُلَّمَا عَٰهَدُواْ عَهۡدٗا نَّبَذَهُۥ فَرِيقٞ مِّنۡهُمۚ

271
00:44:54,541 --> 00:44:59,707
بَلۡ أَكۡثَرُهُمۡ لَا يُؤۡمِنُونَ ١٠٠

272
00:44:59,708 --> 00:45:12,180
وَلَمَّا جَآءَهُمۡ رَسُولٞ مِّنۡ عِندِ ٱللَّهِ مُصَدِّقٞ لِّمَا مَعَهُمۡ

273
00:45:12,181 --> 00:45:27,913
مُصَدِّقٞ لِّمَا مَعَهُمۡ نَبَذَ فَرِيقٞ مِّنَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ كِتَٰبَ ٱللَّهِ وَرَآءَ ظُهُورِهِمۡ

274
00:45:27,914 --> 00:45:39,353
كِتَٰبَ ٱللَّهِ وَرَآءَ ظُهُورِهِمۡ كَأَنَّهُمۡ لَا يَعۡلَمُونَ ١٠١

275
00:45:39,354 --> 00:45:50,313
وَٱتَّبَعُواْ مَا تَتۡلُواْ ٱلشَّيَٰطِينُ عَلَىٰ مُلۡكِ سُلَيۡمَٰنَۖ وَمَا كَفَرَ سُلَيۡمَٰنُ

276
00:45:50,314 --> 00:46:01,347
وَمَا كَفَرَ سُلَيۡمَٰنُ وَلَٰكِنَّ ٱلشَّيَٰطِينَ كَفَرُواْ يُعَلِّمُونَ ٱلنَّاسَ ٱلسِّحۡرَ

277
00:46:01,348 --> 00:46:14,440
يُعَلِّمُونَ ٱلنَّاسَ ٱلسِّحۡرَ وَمَآ أُنزِلَ عَلَى ٱلۡمَلَكَيۡنِ بِبَابِلَ هَٰرُوتَ وَمَٰرُوتَۚ

278
00:46:14,441 --> 00:46:27,387
وَمَا يُعَلِّمَانِ مِنۡ أَحَدٍ حَتَّىٰ يَقُولَآ إِنَّمَا نَحۡنُ فِتۡنَةٞ فَلَا تَكۡفُرۡۖ

279
00:46:27,388 --> 00:46:35,920
فَيَتَعَلَّمُونَ مِنۡهُمَا مَا يُفَرِّقُونَ بِهِۦ بَيۡنَ ٱلۡمَرۡءِ وَزَوۡجِهِۦۚ

280
00:46:35,921 --> 00:46:47,347
وَمَا هُم بِضَآرِّينَ بِهِۦ مِنۡ أَحَدٍ إِلَّا بِإِذۡنِ ٱللَّهِۚ

281
00:46:47,348 --> 00:46:55,000
وَيَتَعَلَّمُونَ مَا يَضُرُّهُمۡ وَلَا يَنفَعُهُمۡۚ

282
00:46:55,001 --> 00:47:05,667
وَلَقَدۡ عَلِمُواْ لَمَنِ ٱشۡتَرَىٰهُ مَا لَهُۥ فِي ٱلۡأٓخِرَةِ مِنۡ خَلَٰقٖۚ

283
00:47:05,668 --> 00:47:15,847
وَلَبِئۡسَ مَا شَرَوۡاْ بِهِۦٓ أَنفُسَهُمۡۚ لَوۡ كَانُواْ يَعۡلَمُونَ ١٠٢

284
00:47:15,848 --> 00:47:29,787
وَلَوۡ أَنَّهُمۡ ءَامَنُواْ وَٱتَّقَوۡاْ لَمَثُوبَةٞ مِّنۡ عِندِ ٱللَّهِ خَيۡرٞۚ لَّوۡ كَانُواْ يَعۡلَمُونَ ١٠٣

285
00:47:29,788 --> 00:47:41,807
يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تَقُولُواْ رَٰعِنَا وَقُولُواْ ٱنظُرۡنَا

286
00:47:41,808 --> 00:47:51,673
وَقُولُواْ ٱنظُرۡنَا وَٱسۡمَعُواْۗ وَلِلۡكَٰفِرِينَ عَذَابٌ أَلِيمٞ ١٠٤

287
00:47:51,674 --> 00:48:06,200
مَّا يَوَدُّ ٱلَّذِينَ كَفَرُواْ مِنۡ أَهۡلِ ٱلۡكِتَٰبِ وَلَا ٱلۡمُشۡرِكِينَ أَن يُنَزَّلَ عَلَيۡكُم مِّنۡ خَيۡرٖ مِّن رَّبِّكُمۡۚ

288
00:48:06,201 --> 00:48:14,920
وَٱللَّهُ يَخۡتَصُّ بِرَحۡمَتِهِۦ مَن يَشَآءُۚ

289
00:48:14,921 --> 00:48:20,053
وَٱللَّهُ ذُو ٱلۡفَضۡلِ ٱلۡعَظِيمِ ١٠٥

290
00:48:20,054 --> 00:48:32,793
مَا نَنسَخۡ مِنۡ ءَايَةٍ أَوۡ نُنسِهَا نَأۡتِ بِخَيۡرٖ مِّنۡهَآ أَوۡ مِثۡلِهَآۗ

291
00:48:32,794 --> 00:48:41,327
أَلَمۡ تَعۡلَمۡ أَنَّ ٱللَّهَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٌ ١٠٦

292
00:48:41,328 --> 00:48:48,733
أَلَمۡ تَعۡلَمۡ أَنَّ ٱللَّهَ لَهُۥ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۗ

293
00:48:48,734 --> 00:48:59,093
وَمَا لَكُم مِّن دُونِ ٱللَّهِ مِن وَلِيّٖ وَلَا نَصِيرٍ ١٠٧

294
00:48:59,094 --> 00:49:09,020
أَمۡ تُرِيدُونَ أَن تَسۡـَٔلُواْ رَسُولَكُمۡ كَمَا سُئِلَ مُوسَىٰ مِن قَبۡلُۗ

295
00:49:09,021 --> 00:49:19,973
وَمَن يَتَبَدَّلِ ٱلۡكُفۡرَ بِٱلۡإِيمَٰنِ فَقَدۡ ضَلَّ سَوَآءَ ٱلسَّبِيلِ ١٠٨

296
00:49:19,974 --> 00:49:36,260
وَدَّ كَثِيرٞ مِّنۡ أَهۡلِ ٱلۡكِتَٰبِ لَوۡ يَرُدُّونَكُم مِّنۢ بَعۡدِ إِيمَٰنِكُمۡ كُفَّارًا حَسَدٗا مِّنۡ عِندِ أَنفُسِهِم

297
00:49:36,261 --> 00:49:52,200
لَوۡ يَرُدُّونَكُم مِّنۢ بَعۡدِ إِيمَٰنِكُمۡ كُفَّارًا حَسَدٗا مِّنۡ عِندِ أَنفُسِهِم مِّنۢ بَعۡدِ مَا تَبَيَّنَ لَهُمُ ٱلۡحَقُّۖ

298
00:49:52,201 --> 00:49:57,760
فَٱعۡفُواْ وَٱصۡفَحُواْ حَتَّىٰ يَأۡتِيَ ٱللَّهُ بِأَمۡرِهِۦٓۗ

299
00:49:57,761 --> 00:50:05,573
إِنَّ ٱللَّهَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ ١٠٩

300
00:50:05,574 --> 00:50:20,653
وَأَقِيمُواْ ٱلصَّلَوٰةَ وَءَاتُواْ ٱلزَّكَوٰةَۚ وَمَا تُقَدِّمُواْ لِأَنفُسِكُم مِّنۡ خَيۡرٖ تَجِدُوهُ عِندَ ٱللَّهِۗ

301
00:50:20,654 --> 00:50:26,913
إِنَّ ٱللَّهَ بِمَا تَعۡمَلُونَ بَصِيرٞ ١١٠

302
00:50:26,914 --> 00:50:37,967
وَقَالُواْ لَن يَدۡخُلَ ٱلۡجَنَّةَ إِلَّا مَن كَانَ هُودًا أَوۡ نَصَٰرَىٰۗ

303
00:50:37,968 --> 00:50:40,553
تِلۡكَ أَمَانِيُّهُمۡۗ

304
00:50:40,554 --> 00:50:48,747
قُلۡ هَاتُواْ بُرۡهَٰنَكُمۡ إِن كُنتُمۡ صَٰدِقِينَ ١١١

305
00:50:48,748 --> 00:50:50,200
بَلَىٰۚ

306
00:50:50,201 --> 00:51:04,647
بَلَىٰۚ مَنۡ أَسۡلَمَ وَجۡهَهُۥ لِلَّهِ وَهُوَ مُحۡسِنٞ فَلَهُۥٓ أَجۡرُهُۥ عِندَ رَبِّهِۦ وَلَا خَوۡفٌ عَلَيۡهِمۡ

307
00:51:04,648 --> 00:51:12,033
وَلَا خَوۡفٌ عَلَيۡهِمۡ وَلَا هُمۡ يَحۡزَنُونَ ١١٢

308
00:51:12,034 --> 00:51:29,040
وَقَالَتِ ٱلۡيَهُودُ لَيۡسَتِ ٱلنَّصَٰرَىٰ عَلَىٰ شَيۡءٖ وَقَالَتِ ٱلنَّصَٰرَىٰ لَيۡسَتِ ٱلۡيَهُودُ عَلَىٰ شَيۡءٖ وَهُمۡ يَتۡلُونَ ٱلۡكِتَٰبَۗ

309
00:51:29,041 --> 00:51:35,587
كَذَٰلِكَ قَالَ ٱلَّذِينَ لَا يَعۡلَمُونَ مِثۡلَ قَوۡلِهِمۡۚ

310
00:51:35,588 --> 00:51:46,687
فَٱللَّهُ يَحۡكُمُ بَيۡنَهُمۡ يَوۡمَ ٱلۡقِيَٰمَةِ فِيمَا كَانُواْ فِيهِ يَخۡتَلِفُونَ ١١٣

311
00:51:46,688 --> 00:51:59,547
وَمَنۡ أَظۡلَمُ مِمَّن مَّنَعَ مَسَٰجِدَ ٱللَّهِ أَن يُذۡكَرَ فِيهَا ٱسۡمُهُۥ وَسَعَىٰ فِي خَرَابِهَآۚ

312
00:51:59,548 --> 00:52:13,773
أُوْلَـٰٓئِكَ مَا كَانَ لَهُمۡ أَن يَدۡخُلُوهَآ إِلَّا خَآئِفِينَۚ

313
00:52:13,774 --> 00:52:24,247
لَهُمۡ فِي ٱلدُّنۡيَا خِزۡيٞ وَلَهُمۡ فِي ٱلۡأٓخِرَةِ عَذَابٌ عَظِيمٞ ١١٤

314
00:52:24,248 --> 00:52:28,340
وَلِلَّهِ ٱلۡمَشۡرِقُ وَٱلۡمَغۡرِبُۚ

315
00:52:28,341 --> 00:52:36,860
فَأَيۡنَمَا تُوَلُّواْ فَثَمَّ وَجۡهُ ٱللَّهِۚ

316
00:52:36,861 --> 00:52:42,713
إِنَّ ٱللَّهَ وَٰسِعٌ عَلِيمٞ ١١٥

317
00:52:42,714 --> 00:52:47,233
وَقَالُواْ ٱتَّخَذَ ٱللَّهُ وَلَدٗاۗ

318
00:52:47,234 --> 00:52:49,393
سُبۡحَٰنَهُۥۖ

319
00:52:49,394 --> 00:52:59,453
سُبۡحَٰنَهُۥۖ بَل لَّهُۥ مَا فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ كُلّٞ لَّهُۥ قَٰنِتُونَ ١١٦

320
00:52:59,454 --> 00:53:03,400
بَدِيعُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ

321
00:53:03,401 --> 00:53:15,353
وَإِذَا قَضَىٰٓ أَمۡرٗا فَإِنَّمَا يَقُولُ لَهُۥ كُن فَيَكُونُ ١١٧

322
00:53:15,354 --> 00:53:26,467
وَقَالَ ٱلَّذِينَ لَا يَعۡلَمُونَ لَوۡلَا يُكَلِّمُنَا ٱللَّهُ أَوۡ تَأۡتِينَآ ءَايَةٞۗ

323
00:53:26,468 --> 00:53:34,913
كَذَٰلِكَ قَالَ ٱلَّذِينَ مِن قَبۡلِهِم مِّثۡلَ قَوۡلِهِمۡۘ

324
00:53:34,914 --> 00:53:46,820
تَشَٰبَهَتۡ قُلُوبُهُمۡۗ قَدۡ بَيَّنَّا ٱلۡأٓيَٰتِ لِقَوۡمٖ يُوقِنُونَ ١١٨

325
00:53:46,821 --> 00:53:56,093
إِنَّآ أَرۡسَلۡنَٰكَ بِٱلۡحَقِّ بَشِيرٗا وَنَذِيرٗاۖ

326
00:53:56,094 --> 00:54:02,320
وَلَا تُسۡـَٔلُ عَنۡ أَصۡحَٰبِ ٱلۡجَحِيمِ ١١٩

327
00:54:02,321 --> 00:54:14,000
وَلَن تَرۡضَىٰ عَنكَ ٱلۡيَهُودُ وَلَا ٱلنَّصَٰرَىٰ حَتَّىٰ تَتَّبِعَ مِلَّتَهُمۡۗ

328
00:54:14,001 --> 00:54:19,740
قُلۡ إِنَّ هُدَى ٱللَّهِ هُوَ ٱلۡهُدَىٰۗ

329
00:54:19,741 --> 00:54:36,413
وَلَئِنِ ٱتَّبَعۡتَ أَهۡوَآءَهُم بَعۡدَ ٱلَّذِي جَآءَكَ مِنَ ٱلۡعِلۡمِ مَا لَكَ مِنَ ٱللَّهِ مِن وَلِيّٖ وَلَا نَصِيرٍ ١٢٠

330
00:54:36,414 --> 00:54:49,847
ٱلَّذِينَ ءَاتَيۡنَٰهُمُ ٱلۡكِتَٰبَ يَتۡلُونَهُۥ حَقَّ تِلَاوَتِهِۦٓ أُوْلَـٰٓئِكَ

331
00:54:49,848 --> 00:54:55,167
أُوْلَـٰٓئِكَ يُؤۡمِنُونَ بِهِۦۗ

332
00:54:55,168 --> 00:55:05,213
وَمَن يَكۡفُرۡ بِهِۦ فَأُوْلَـٰٓئِكَ هُمُ ٱلۡخَٰسِرُونَ ١٢١

333
00:55:05,214 --> 00:55:16,360
يَٰبَنِيٓ إِسۡرَـٰٓءِيلَ ٱذۡكُرُواْ نِعۡمَتِيَ ٱلَّتِيٓ أَنۡعَمۡتُ عَلَيۡكُمۡ

334
00:55:16,361 --> 00:55:23,347
وَأَنِّي فَضَّلۡتُكُمۡ عَلَى ٱلۡعَٰلَمِينَ ١٢٢

335
00:55:23,348 --> 00:55:35,320
وَٱتَّقُواْ يَوۡمٗا لَّا تَجۡزِي نَفۡسٌ عَن نَّفۡسٖ شَيۡـٔٗا وَلَا يُقۡبَلُ مِنۡهَا عَدۡلٞ

336
00:55:35,321 --> 00:55:43,907
وَلَا يُقۡبَلُ مِنۡهَا عَدۡلٞ وَلَا تَنفَعُهَا شَفَٰعَةٞ

337
00:55:43,908 --> 00:55:49,267
وَلَا هُمۡ يُنصَرُونَ ١٢٣

338
00:55:49,268 --> 00:56:01,300
وَإِذِ ٱبۡتَلَىٰٓ إِبۡرَٰهِـۧمَ رَبُّهُۥ بِكَلِمَٰتٖ فَأَتَمَّهُنَّۖ

339
00:56:01,301 --> 00:56:08,420
قَالَ إِنِّي جَاعِلُكَ لِلنَّاسِ إِمَامٗاۖ

340
00:56:08,421 --> 00:56:12,967
قَالَ وَمِن ذُرِّيَّتِيۖ

341
00:56:12,968 --> 00:56:18,480
قَالَ لَا يَنَالُ عَهۡدِي ٱلظَّـٰلِمِينَ ١٢٤

342
00:56:18,481 --> 00:56:26,780
وَإِذۡ جَعَلۡنَا ٱلۡبَيۡتَ مَثَابَةٗ لِّلنَّاسِ وَأَمۡنٗا وَٱتَّخِذُواْ

343
00:56:26,781 --> 00:56:33,127
وَٱتَّخِذُواْ مِن مَّقَامِ إِبۡرَٰهِـۧمَ مُصَلّٗىۖ

344
00:56:33,128 --> 00:56:45,720
وَعَهِدۡنَآ إِلَىٰٓ إِبۡرَٰهِـۧمَ وَإِسۡمَٰعِيلَ أَن طَهِّرَا بَيۡتِيَ

345
00:56:45,721 --> 00:56:57,920
أَن طَهِّرَا بَيۡتِيَ لِلطَّآئِفِينَ وَٱلۡعَٰكِفِينَ وَٱلرُّكَّعِ ٱلسُّجُودِ ١٢٥

346
00:56:57,921 --> 00:57:11,807
وَإِذۡ قَالَ إِبۡرَٰهِـۧمُ رَبِّ ٱجۡعَلۡ هَٰذَا بَلَدًا ءَامِنٗا وَٱرۡزُقۡ أَهۡلَهُۥ مِنَ ٱلثَّمَرَٰتِ مَنۡ ءَامَنَ مِنۡهُم بِٱللَّهِ

347
00:57:11,808 --> 00:57:21,160
وَٱرۡزُقۡ أَهۡلَهُۥ مِنَ ٱلثَّمَرَٰتِ مَنۡ ءَامَنَ مِنۡهُم بِٱللَّهِ وَٱلۡيَوۡمِ ٱلۡأٓخِرِۚ

348
00:57:21,161 --> 00:57:36,127
قَالَ وَمَن كَفَرَ فَأُمَتِّعُهُۥ قَلِيلٗا ثُمَّ أَضۡطَرُّهُۥٓ إِلَىٰ عَذَابِ ٱلنَّارِۖ

349
00:57:36,128 --> 00:57:39,233
وَبِئۡسَ ٱلۡمَصِيرُ ١٢٦

350
00:57:39,234 --> 00:57:50,567
وَإِذۡ يَرۡفَعُ إِبۡرَٰهِـۧمُ ٱلۡقَوَاعِدَ مِنَ ٱلۡبَيۡتِ وَإِسۡمَٰعِيلُ رَبَّنَا تَقَبَّلۡ مِنَّآۖ

351
00:57:50,568 --> 00:58:01,833
رَبَّنَا تَقَبَّلۡ مِنَّآۖ إِنَّكَ أَنتَ ٱلسَّمِيعُ ٱلۡعَلِيمُ ١٢٧

352
00:58:01,834 --> 00:58:16,013
رَبَّنَا وَٱجۡعَلۡنَا مُسۡلِمَيۡنِ لَكَ وَمِن ذُرِّيَّتِنَآ أُمَّةٗ مُّسۡلِمَةٗ لَّكَ وَأَرِنَا مَنَاسِكَنَا

353
00:58:16,014 --> 00:58:27,667
وَأَرِنَا مَنَاسِكَنَا وَتُبۡ عَلَيۡنَآۖ إِنَّكَ أَنتَ ٱلتَّوَّابُ ٱلرَّحِيمُ ١٢٨

354
00:58:27,668 --> 00:58:37,300
رَبَّنَا وَٱبۡعَثۡ فِيهِمۡ رَسُولٗا مِّنۡهُمۡ يَتۡلُواْ عَلَيۡهِمۡ ءَايَٰتِكَ وَيُعَلِّمُهُمُ

355
00:58:37,301 --> 00:58:43,620
وَيُعَلِّمُهُمُ ٱلۡكِتَٰبَ وَٱلۡحِكۡمَةَ وَيُزَكِّيهِمۡۖ

356
00:58:43,621 --> 00:58:49,833
إِنَّكَ أَنتَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ ١٢٩

357
00:58:49,834 --> 00:58:59,307
وَمَن يَرۡغَبُ عَن مِّلَّةِ إِبۡرَٰهِـۧمَ إِلَّا مَن سَفِهَ نَفۡسَهُۥۚ

358
00:58:59,308 --> 00:59:03,753
وَلَقَدِ ٱصۡطَفَيۡنَٰهُ فِي ٱلدُّنۡيَاۖ

359
00:59:03,754 --> 00:59:09,700
وَإِنَّهُۥ فِي ٱلۡأٓخِرَةِ لَمِنَ ٱلصَّـٰلِحِينَ ١٣٠

360
00:59:09,701 --> 00:59:15,120
إِذۡ قَالَ لَهُۥ رَبُّهُۥٓ أَسۡلِمۡۖ

361
00:59:15,121 --> 00:59:20,133
قَالَ أَسۡلَمۡتُ لِرَبِّ ٱلۡعَٰلَمِينَ ١٣١

362
00:59:20,134 --> 00:59:28,760
وَوَصَّىٰ بِهَآ إِبۡرَٰهِـۧمُ بَنِيهِ وَيَعۡقُوبُ يَٰبَنِيَّ

363
00:59:28,761 --> 00:59:37,767
يَٰبَنِيَّ إِنَّ ٱللَّهَ ٱصۡطَفَىٰ لَكُمُ ٱلدِّينَ فَلَا تَمُوتُنَّ

364
00:59:37,768 --> 00:59:46,680
فَلَا تَمُوتُنَّ إِلَّا وَأَنتُم مُّسۡلِمُونَ ١٣٢

365
00:59:46,681 --> 00:59:57,267
أَمۡ كُنتُمۡ شُهَدَآءَ إِذۡ حَضَرَ يَعۡقُوبَ ٱلۡمَوۡتُ

366
00:59:57,268 --> 01:00:04,173
إِذۡ قَالَ لِبَنِيهِ مَا تَعۡبُدُونَ مِنۢ بَعۡدِيۖ

367
01:00:04,174 --> 01:00:18,207
قَالُواْ نَعۡبُدُ إِلَٰهَكَ وَإِلَٰهَ ءَابَآئِكَ إِبۡرَٰهِـۧمَ وَإِسۡمَٰعِيلَ وَإِسۡحَٰقَ إِلَٰهٗا وَٰحِدٗا

368
01:00:18,208 --> 01:00:22,033
وَنَحۡنُ لَهُۥ مُسۡلِمُونَ ١٣٣

369
01:00:22,034 --> 01:00:26,860
تِلۡكَ أُمَّةٞ قَدۡ خَلَتۡۖ

370
01:00:26,861 --> 01:00:32,680
لَهَا مَا كَسَبَتۡ وَلَكُم مَّا كَسَبۡتُمۡۖ

371
01:00:32,681 --> 01:00:40,247
وَلَا تُسۡـَٔلُونَ عَمَّا كَانُواْ يَعۡمَلُونَ ١٣٤

372
01:00:40,248 --> 01:00:46,500
وَقَالُواْ كُونُواْ هُودًا أَوۡ نَصَٰرَىٰ تَهۡتَدُواْۗ

373
01:00:46,501 --> 01:00:55,980
قُلۡ بَلۡ مِلَّةَ إِبۡرَٰهِـۧمَ حَنِيفٗاۖ وَمَا كَانَ مِنَ ٱلۡمُشۡرِكِينَ ١٣٥

374
01:00:55,981 --> 01:01:12,580
قُولُوٓاْ ءَامَنَّا بِٱللَّهِ وَمَآ أُنزِلَ إِلَيۡنَا وَمَآ أُنزِلَ إِلَىٰٓ إِبۡرَٰهِـۧمَ

375
01:01:12,581 --> 01:01:29,280
وَمَآ أُنزِلَ إِلَىٰٓ إِبۡرَٰهِـۧمَ وَإِسۡمَٰعِيلَ وَإِسۡحَٰقَ وَيَعۡقُوبَ وَٱلۡأَسۡبَاطِ وَمَآ أُوتِيَ مُوسَىٰ وَعِيسَىٰ

376
01:01:29,281 --> 01:01:40,200
وَمَآ أُوتِيَ مُوسَىٰ وَعِيسَىٰ وَمَآ أُوتِيَ ٱلنَّبِيُّونَ مِن رَّبِّهِمۡ

377
01:01:40,201 --> 01:01:48,020
لَا نُفَرِّقُ بَيۡنَ أَحَدٖ مِّنۡهُمۡ وَنَحۡنُ لَهُۥ مُسۡلِمُونَ ١٣٦

378
01:01:48,021 --> 01:01:57,493
فَإِنۡ ءَامَنُواْ بِمِثۡلِ مَآ ءَامَنتُم بِهِۦ فَقَدِ ٱهۡتَدَواْۖ

379
01:01:57,494 --> 01:02:08,827
وَّإِن تَوَلَّوۡاْ فَإِنَّمَا هُمۡ فِي شِقَاقٖۖ فَسَيَكۡفِيكَهُمُ ٱللَّهُۚ

380
01:02:08,828 --> 01:02:12,860
وَهُوَ ٱلسَّمِيعُ ٱلۡعَلِيمُ ١٣٧

381
01:02:12,861 --> 01:02:16,260
صِبۡغَةَ ٱللَّهِ

382
01:02:16,261 --> 01:02:21,967
صِبۡغَةَ ٱللَّهِ وَمَنۡ أَحۡسَنُ مِنَ ٱللَّهِ صِبۡغَةٗۖ

383
01:02:21,968 --> 01:02:26,127
وَنَحۡنُ لَهُۥ عَٰبِدُونَ ١٣٨

384
01:02:26,128 --> 01:02:38,593
قُلۡ أَتُحَآجُّونَنَا فِي ٱللَّهِ وَهُوَ رَبُّنَا وَرَبُّكُمۡ وَلَنَآ أَعۡمَٰلُنَا

385
01:02:38,594 --> 01:02:45,400
وَلَنَآ أَعۡمَٰلُنَا وَلَكُمۡ أَعۡمَٰلُكُمۡ

386
01:02:45,401 --> 01:02:49,720
وَنَحۡنُ لَهُۥ مُخۡلِصُونَ ١٣٩

387
01:02:49,721 --> 01:03:04,493
أَمۡ تَقُولُونَ إِنَّ إِبۡرَٰهِـۧمَ وَإِسۡمَٰعِيلَ وَإِسۡحَٰقَ وَيَعۡقُوبَ وَٱلۡأَسۡبَاطَ كَانُواْ هُودًا أَوۡ نَصَٰرَىٰۗ

388
01:03:04,494 --> 01:03:10,693
قُلۡ ءَأَنتُمۡ أَعۡلَمُ أَمِ ٱللَّهُۗ

389
01:03:10,694 --> 01:03:20,567
وَمَنۡ أَظۡلَمُ مِمَّن كَتَمَ شَهَٰدَةً عِندَهُۥ مِنَ ٱللَّهِۗ

390
01:03:20,568 --> 01:03:27,713
وَمَا ٱللَّهُ بِغَٰفِلٍ عَمَّا تَعۡمَلُونَ ١٤٠

391
01:03:27,714 --> 01:03:32,700
تِلۡكَ أُمَّةٞ قَدۡ خَلَتۡۖ

392
01:03:32,701 --> 01:03:38,480
لَهَا مَا كَسَبَتۡ وَلَكُم مَّا كَسَبۡتُمۡۖ

393
01:03:38,481 --> 01:03:46,633
وَلَا تُسۡـَٔلُونَ عَمَّا كَانُواْ يَعۡمَلُونَ ١٤١

394
01:03:46,634 --> 01:04:01,160
سَيَقُولُ ٱلسُّفَهَآءُ مِنَ ٱلنَّاسِ مَا وَلَّىٰهُمۡ عَن قِبۡلَتِهِمُ ٱلَّتِي كَانُواْ عَلَيۡهَاۚ

395
01:04:01,161 --> 01:04:05,420
قُل لِّلَّهِ ٱلۡمَشۡرِقُ وَٱلۡمَغۡرِبُۚ

396
01:04:05,421 --> 01:04:15,673
يَهۡدِي مَن يَشَآءُ إِلَىٰ صِرَٰطٖ مُّسۡتَقِيمٖ ١٤٢

397
01:04:15,674 --> 01:04:30,720
وَكَذَٰلِكَ جَعَلۡنَٰكُمۡ أُمَّةٗ وَسَطٗا لِّتَكُونُواْ شُهَدَآءَ عَلَى ٱلنَّاسِ وَيَكُونَ ٱلرَّسُولُ عَلَيۡكُمۡ شَهِيدٗاۗ

398
01:04:30,721 --> 01:04:43,973
وَمَا جَعَلۡنَا ٱلۡقِبۡلَةَ ٱلَّتِي كُنتَ عَلَيۡهَآ إِلَّا لِنَعۡلَمَ مَن يَتَّبِعُ ٱلرَّسُولَ

399
01:04:43,974 --> 01:04:55,340
إِلَّا لِنَعۡلَمَ مَن يَتَّبِعُ ٱلرَّسُولَ مِمَّن يَنقَلِبُ عَلَىٰ عَقِبَيۡهِۚ

400
01:04:55,341 --> 01:05:04,093
وَإِن كَانَتۡ لَكَبِيرَةً إِلَّا عَلَى ٱلَّذِينَ هَدَى ٱللَّهُۗ

401
01:05:04,094 --> 01:05:10,080
وَمَا كَانَ ٱللَّهُ لِيُضِيعَ إِيمَٰنَكُمۡۚ

402
01:05:10,081 --> 01:05:19,293
إِنَّ ٱللَّهَ بِٱلنَّاسِ لَرَءُوفٞ رَّحِيمٞ ١٤٣

403
01:05:19,294 --> 01:05:25,687
قَدۡ نَرَىٰ تَقَلُّبَ وَجۡهِكَ فِي ٱلسَّمَآءِۖ

404
01:05:25,688 --> 01:05:33,793
فَلَنُوَلِّيَنَّكَ قِبۡلَةٗ تَرۡضَىٰهَاۚ

405
01:05:33,794 --> 01:05:39,720
فَوَلِّ وَجۡهَكَ شَطۡرَ ٱلۡمَسۡجِدِ ٱلۡحَرَامِۚ

406
01:05:39,721 --> 01:05:46,260
وَحَيۡثُ مَا كُنتُمۡ فَوَلُّواْ وُجُوهَكُمۡ شَطۡرَهُۥۗ

407
01:05:46,261 --> 01:05:56,493
وَإِنَّ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ لَيَعۡلَمُونَ أَنَّهُ ٱلۡحَقُّ مِن رَّبِّهِمۡۗ

408
01:05:56,494 --> 01:06:03,987
وَمَا ٱللَّهُ بِغَٰفِلٍ عَمَّا يَعۡمَلُونَ ١٤٤

409
01:06:03,988 --> 01:06:13,567
وَلَئِنۡ أَتَيۡتَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ بِكُلِّ ءَايَةٖ مَّا تَبِعُواْ قِبۡلَتَكَۚ

410
01:06:13,568 --> 01:06:22,000
وَمَآ أَنتَ بِتَابِعٖ قِبۡلَتَهُمۡۚ

411
01:06:22,001 --> 01:06:28,840
وَمَا بَعۡضُهُم بِتَابِعٖ قِبۡلَةَ بَعۡضٖۚ

412
01:06:28,841 --> 01:06:41,353
وَلَئِنِ ٱتَّبَعۡتَ أَهۡوَآءَهُم مِّنۢ بَعۡدِ مَا جَآءَكَ مِنَ ٱلۡعِلۡمِ إِنَّكَ

413
01:06:41,354 --> 01:06:47,433
إِنَّكَ إِذٗا لَّمِنَ ٱلظَّـٰلِمِينَ ١٤٥

414
01:06:47,434 --> 01:06:58,700
ٱلَّذِينَ ءَاتَيۡنَٰهُمُ ٱلۡكِتَٰبَ يَعۡرِفُونَهُۥ كَمَا يَعۡرِفُونَ أَبۡنَآءَهُمۡۖ

415
01:06:58,701 --> 01:07:08,387
وَإِنَّ فَرِيقٗا مِّنۡهُمۡ لَيَكۡتُمُونَ ٱلۡحَقَّ وَهُمۡ يَعۡلَمُونَ ١٤٦

416
01:07:08,388 --> 01:07:16,407
ٱلۡحَقُّ مِن رَّبِّكَ فَلَا تَكُونَنَّ مِنَ ٱلۡمُمۡتَرِينَ ١٤٧

417
01:07:16,408 --> 01:07:24,953
وَلِكُلّٖ وِجۡهَةٌ هُوَ مُوَلِّيهَاۖ فَٱسۡتَبِقُواْ ٱلۡخَيۡرَٰتِۚ

418
01:07:24,954 --> 01:07:31,693
أَيۡنَ مَا تَكُونُواْ يَأۡتِ بِكُمُ ٱللَّهُ جَمِيعًاۚ

419
01:07:31,694 --> 01:07:39,847
إِنَّ ٱللَّهَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ ١٤٨

420
01:07:39,848 --> 01:07:49,173
وَمِنۡ حَيۡثُ خَرَجۡتَ فَوَلِّ وَجۡهَكَ شَطۡرَ ٱلۡمَسۡجِدِ ٱلۡحَرَامِۖ

421
01:07:49,174 --> 01:07:53,773
وَإِنَّهُۥ لَلۡحَقُّ مِن رَّبِّكَۗ

422
01:07:53,774 --> 01:08:01,233
وَمَا ٱللَّهُ بِغَٰفِلٍ عَمَّا تَعۡمَلُونَ ١٤٩

423
01:08:01,234 --> 01:08:09,360
وَمِنۡ حَيۡثُ خَرَجۡتَ فَوَلِّ وَجۡهَكَ شَطۡرَ ٱلۡمَسۡجِدِ ٱلۡحَرَامِۚ

424
01:08:09,361 --> 01:08:21,480
وَحَيۡثُ مَا كُنتُمۡ فَوَلُّواْ وُجُوهَكُمۡ شَطۡرَهُۥ لِئَلَّا يَكُونَ لِلنَّاسِ عَلَيۡكُمۡ حُجَّةٌ

425
01:08:21,481 --> 01:08:30,580
لِئَلَّا يَكُونَ لِلنَّاسِ عَلَيۡكُمۡ حُجَّةٌ إِلَّا ٱلَّذِينَ ظَلَمُواْ مِنۡهُمۡ

426
01:08:30,581 --> 01:08:41,773
فَلَا تَخۡشَوۡهُمۡ وَٱخۡشَوۡنِي وَلِأُتِمَّ نِعۡمَتِي عَلَيۡكُمۡ وَلَعَلَّكُمۡ تَهۡتَدُونَ ١٥٠

427
01:08:41,774 --> 01:08:52,933
كَمَآ أَرۡسَلۡنَا فِيكُمۡ رَسُولٗا مِّنكُمۡ يَتۡلُواْ عَلَيۡكُمۡ ءَايَٰتِنَا

428
01:08:52,934 --> 01:09:04,847
يَتۡلُواْ عَلَيۡكُمۡ ءَايَٰتِنَا وَيُزَكِّيكُمۡ وَيُعَلِّمُكُمُ ٱلۡكِتَٰبَ وَٱلۡحِكۡمَةَ وَيُعَلِّمُكُم

429
01:09:04,848 --> 01:09:13,660
وَيُعَلِّمُكُم مَّا لَمۡ تَكُونُواْ تَعۡلَمُونَ ١٥١

430
01:09:13,661 --> 01:09:24,593
فَٱذۡكُرُونِيٓ أَذۡكُرۡكُمۡ وَٱشۡكُرُواْ لِي وَلَا تَكۡفُرُونِ ١٥٢

431
01:09:24,594 --> 01:09:36,040
يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ ٱسۡتَعِينُواْ بِٱلصَّبۡرِ وَٱلصَّلَوٰةِۚ

432
01:09:36,041 --> 01:09:43,213
إِنَّ ٱللَّهَ مَعَ ٱلصَّـٰبِرِينَ ١٥٣

433
01:09:43,214 --> 01:09:53,820
وَلَا تَقُولُواْ لِمَن يُقۡتَلُ فِي سَبِيلِ ٱللَّهِ أَمۡوَٰتُۢۚ

434
01:09:53,821 --> 01:10:04,380
بَلۡ أَحۡيَآءٞ وَلَٰكِن لَّا تَشۡعُرُونَ ١٥٤

435
01:10:04,381 --> 01:10:15,927
وَلَنَبۡلُوَنَّكُم بِشَيۡءٖ مِّنَ ٱلۡخَوۡفِ وَٱلۡجُوعِ وَنَقۡصٖ مِّنَ ٱلۡأَمۡوَٰلِ

436
01:10:15,928 --> 01:10:24,820
وَنَقۡصٖ مِّنَ ٱلۡأَمۡوَٰلِ وَٱلۡأَنفُسِ وَٱلثَّمَرَٰتِۗ

437
01:10:24,821 --> 01:10:28,927
وَبَشِّرِ ٱلصَّـٰبِرِينَ ١٥٥

438
01:10:28,928 --> 01:10:39,247
ٱلَّذِينَ إِذَآ أَصَٰبَتۡهُم مُّصِيبَةٞ قَالُوٓاْ

439
01:10:39,248 --> 01:10:51,160
قَالُوٓاْ إِنَّا لِلَّهِ وَإِنَّآ إِلَيۡهِ رَٰجِعُونَ ١٥٦

440
01:10:51,161 --> 01:11:00,693
أُوْلَـٰٓئِكَ عَلَيۡهِمۡ صَلَوَٰتٞ مِّن رَّبِّهِمۡ وَرَحۡمَةٞۖ

441
01:11:00,694 --> 01:11:09,113
وَأُوْلَـٰٓئِكَ هُمُ ٱلۡمُهۡتَدُونَ ١٥٧

442
01:11:09,114 --> 01:11:19,600
إِنَّ ٱلصَّفَا وَٱلۡمَرۡوَةَ مِن شَعَآئِرِ ٱللَّهِۖ

443
01:11:19,601 --> 01:11:29,213
فَمَنۡ حَجَّ ٱلۡبَيۡتَ أَوِ ٱعۡتَمَرَ فَلَا جُنَاحَ عَلَيۡهِ أَن يَطَّوَّفَ بِهِمَاۚ

444
01:11:29,214 --> 01:11:39,400
وَمَن تَطَوَّعَ خَيۡرٗا فَإِنَّ ٱللَّهَ شَاكِرٌ عَلِيمٌ ١٥٨

445
01:11:39,401 --> 01:11:54,400
إِنَّ ٱلَّذِينَ يَكۡتُمُونَ مَآ أَنزَلۡنَا مِنَ ٱلۡبَيِّنَٰتِ وَٱلۡهُدَىٰ مِنۢ بَعۡدِ مَا بَيَّنَّـٰهُ

446
01:11:54,401 --> 01:12:06,153
مِنۢ بَعۡدِ مَا بَيَّنَّـٰهُ لِلنَّاسِ فِي ٱلۡكِتَٰبِ أُوْلَـٰٓئِكَ

447
01:12:06,154 --> 01:12:15,467
أُوْلَـٰٓئِكَ يَلۡعَنُهُمُ ٱللَّهُ وَيَلۡعَنُهُمُ ٱللَّـٰعِنُونَ ١٥٩

448
01:12:15,468 --> 01:12:24,780
إِلَّا ٱلَّذِينَ تَابُواْ وَأَصۡلَحُواْ وَبَيَّنُواْ فَأُوْلَـٰٓئِكَ

449
01:12:24,781 --> 01:12:34,593
فَأُوْلَـٰٓئِكَ أَتُوبُ عَلَيۡهِمۡ وَأَنَا ٱلتَّوَّابُ ٱلرَّحِيمُ ١٦٠

450
01:12:34,594 --> 01:12:45,060
إِنَّ ٱلَّذِينَ كَفَرُواْ وَمَاتُواْ وَهُمۡ كُفَّارٌ أُوْلَـٰٓئِكَ

451
01:12:45,061 --> 01:12:56,967
أُوْلَـٰٓئِكَ عَلَيۡهِمۡ لَعۡنَةُ ٱللَّهِ وَٱلۡمَلَـٰٓئِكَةِ وَٱلنَّاسِ أَجۡمَعِينَ ١٦١

452
01:12:56,968 --> 01:13:07,047
خَٰلِدِينَ فِيهَا لَا يُخَفَّفُ عَنۡهُمُ ٱلۡعَذَابُ وَلَا هُمۡ يُنظَرُونَ ١٦٢

453
01:13:07,048 --> 01:13:11,547
وَإِلَٰهُكُمۡ إِلَٰهٞ وَٰحِدٞۖ

454
01:13:11,548 --> 01:13:21,720
وَإِلَٰهُكُمۡ إِلَٰهٞ وَٰحِدٞۖ لَّآ إِلَٰهَ إِلَّا هُوَ

455
01:13:21,721 --> 01:13:31,147
لَّآ إِلَٰهَ إِلَّا هُوَ ٱلرَّحۡمَٰنُ ٱلرَّحِيمُ ١٦٣

456
01:13:31,148 --> 01:13:42,507
إِنَّ فِي خَلۡقِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَٱخۡتِلَٰفِ ٱلَّيۡلِ وَٱلنَّهَارِ وَٱلۡفُلۡكِ ٱلَّتِي تَجۡرِي

457
01:13:42,508 --> 01:13:52,460
وَٱلۡفُلۡكِ ٱلَّتِي تَجۡرِي فِي ٱلۡبَحۡرِ بِمَا يَنفَعُ ٱلنَّاسَ

458
01:13:52,461 --> 01:14:06,567
وَمَآ أَنزَلَ ٱللَّهُ مِنَ ٱلسَّمَآءِ مِن مَّآءٖ فَأَحۡيَا

459
01:14:06,568 --> 01:14:18,140
فَأَحۡيَا بِهِ ٱلۡأَرۡضَ بَعۡدَ مَوۡتِهَا وَبَثَّ فِيهَا مِن كُلِّ دَآبَّةٖ

460
01:14:18,141 --> 01:14:27,927
وَتَصۡرِيفِ ٱلرِّيَٰحِ وَٱلسَّحَابِ ٱلۡمُسَخَّرِ بَيۡنَ ٱلسَّمَآءِ وَٱلۡأَرۡضِ

461
01:14:27,928 --> 01:14:35,320
لَأٓيَٰتٖ لِّقَوۡمٖ يَعۡقِلُونَ ١٦٤

462
01:14:35,321 --> 01:14:48,107
وَمِنَ ٱلنَّاسِ مَن يَتَّخِذُ مِن دُونِ ٱللَّهِ أَندَادٗا يُحِبُّونَهُمۡ كَحُبِّ ٱللَّهِۖ

463
01:14:48,108 --> 01:14:56,480
وَٱلَّذِينَ ءَامَنُوٓاْ أَشَدُّ حُبّٗا لِّلَّهِۗ

464
01:14:56,481 --> 01:15:09,587
وَلَوۡ يَرَى ٱلَّذِينَ ظَلَمُوٓاْ إِذۡ يَرَوۡنَ ٱلۡعَذَابَ أَنَّ ٱلۡقُوَّةَ لِلَّهِ جَمِيعٗا

465
01:15:09,588 --> 01:15:20,453
أَنَّ ٱلۡقُوَّةَ لِلَّهِ جَمِيعٗا وَأَنَّ ٱللَّهَ شَدِيدُ ٱلۡعَذَابِ ١٦٥

466
01:15:20,454 --> 01:15:33,127
إِذۡ تَبَرَّأَ ٱلَّذِينَ ٱتُّبِعُواْ مِنَ ٱلَّذِينَ ٱتَّبَعُواْ وَرَأَوُاْ ٱلۡعَذَابَ وَتَقَطَّعَتۡ بِهِمُ ٱلۡأَسۡبَابُ ١٦٦

467
01:15:33,128 --> 01:15:42,880
وَقَالَ ٱلَّذِينَ ٱتَّبَعُواْ لَوۡ أَنَّ لَنَا كَرَّةٗ فَنَتَبَرَّأَ مِنۡهُمۡ

468
01:15:42,881 --> 01:15:49,867
فَنَتَبَرَّأَ مِنۡهُمۡ كَمَا تَبَرَّءُواْ مِنَّاۗ

469
01:15:49,868 --> 01:15:57,727
كَذَٰلِكَ يُرِيهِمُ ٱللَّهُ أَعۡمَٰلَهُمۡ حَسَرَٰتٍ عَلَيۡهِمۡۖ

470
01:15:57,728 --> 01:16:04,827
وَمَا هُم بِخَٰرِجِينَ مِنَ ٱلنَّارِ ١٦٧

471
01:16:04,828 --> 01:16:20,453
يَـٰٓأَيُّهَا ٱلنَّاسُ كُلُواْ مِمَّا فِي ٱلۡأَرۡضِ حَلَٰلٗا طَيِّبٗا وَلَا تَتَّبِعُواْ

472
01:16:20,454 --> 01:16:28,380
وَلَا تَتَّبِعُواْ خُطُوَٰتِ ٱلشَّيۡطَٰنِۚ

473
01:16:28,381 --> 01:16:36,067
إِنَّهُۥ لَكُمۡ عَدُوّٞ مُّبِينٌ ١٦٨

474
01:16:36,068 --> 01:16:50,920
إِنَّمَا يَأۡمُرُكُم بِٱلسُّوٓءِ وَٱلۡفَحۡشَآءِ وَأَن تَقُولُواْ

475
01:16:50,921 --> 01:17:00,193
وَأَن تَقُولُواْ عَلَى ٱللَّهِ مَا لَا تَعۡلَمُونَ ١٦٩

476
01:17:00,194 --> 01:17:08,807
وَإِذَا قِيلَ لَهُمُ ٱتَّبِعُواْ مَآ أَنزَلَ ٱللَّهُ قَالُواْ

477
01:17:08,808 --> 01:17:18,240
قَالُواْ بَلۡ نَتَّبِعُ مَآ أَلۡفَيۡنَا عَلَيۡهِ ءَابَآءَنَآۚ

478
01:17:18,241 --> 01:17:30,520
أَوَلَوۡ كَانَ ءَابَآؤُهُمۡ لَا يَعۡقِلُونَ شَيۡـٔٗا وَلَا يَهۡتَدُونَ ١٧٠

479
01:17:30,521 --> 01:17:46,200
وَمَثَلُ ٱلَّذِينَ كَفَرُواْ كَمَثَلِ ٱلَّذِي يَنۡعِقُ بِمَا لَا يَسۡمَعُ إِلَّا دُعَآءٗ وَنِدَآءٗۚ

480
01:17:46,201 --> 01:17:56,240
صُمُّۢ بُكۡمٌ عُمۡيٞ فَهُمۡ لَا يَعۡقِلُونَ ١٧١

481
01:17:56,241 --> 01:18:08,160
يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ كُلُواْ مِن طَيِّبَٰتِ مَا رَزَقۡنَٰكُمۡ

482
01:18:08,161 --> 01:18:17,693
كُلُواْ مِن طَيِّبَٰتِ مَا رَزَقۡنَٰكُمۡ وَٱشۡكُرُواْ لِلَّهِ

483
01:18:17,694 --> 01:18:27,753
وَٱشۡكُرُواْ لِلَّهِ إِن كُنتُمۡ إِيَّاهُ تَعۡبُدُونَ ١٧٢

484
01:18:27,754 --> 01:18:41,847
إِنَّمَا حَرَّمَ عَلَيۡكُمُ ٱلۡمَيۡتَةَ وَٱلدَّمَ وَلَحۡمَ ٱلۡخِنزِيرِ وَمَآ أُهِلَّ بِهِۦ لِغَيۡرِ ٱللَّهِۖ

485
01:18:41,848 --> 01:18:55,773
فَمَنِ ٱضۡطُرَّ غَيۡرَ بَاغٖ وَلَا عَادٖ فَلَآ إِثۡمَ عَلَيۡهِۚ

486
01:18:55,774 --> 01:19:02,420
إِنَّ ٱللَّهَ غَفُورٞ رَّحِيمٌ ١٧٣

487
01:19:02,421 --> 01:19:13,780
إِنَّ ٱلَّذِينَ يَكۡتُمُونَ مَآ أَنزَلَ ٱللَّهُ مِنَ ٱلۡكِتَٰبِ وَيَشۡتَرُونَ بِهِۦ

488
01:19:13,781 --> 01:19:24,360
وَيَشۡتَرُونَ بِهِۦ ثَمَنٗا قَلِيلًا أُوْلَـٰٓئِكَ

489
01:19:24,361 --> 01:19:34,587
أُوْلَـٰٓئِكَ مَا يَأۡكُلُونَ فِي بُطُونِهِمۡ إِلَّا ٱلنَّارَ

490
01:19:34,588 --> 01:19:43,080
وَلَا يُكَلِّمُهُمُ ٱللَّهُ يَوۡمَ ٱلۡقِيَٰمَةِ وَلَا يُزَكِّيهِمۡ

491
01:19:43,081 --> 01:19:48,573
وَلَهُمۡ عَذَابٌ أَلِيمٌ ١٧٤

492
01:19:48,574 --> 01:19:58,680
أُوْلَـٰٓئِكَ ٱلَّذِينَ ٱشۡتَرَوُاْ ٱلضَّلَٰلَةَ بِٱلۡهُدَىٰ وَٱلۡعَذَابَ بِٱلۡمَغۡفِرَةِۚ

493
01:19:58,681 --> 01:20:06,033
فَمَآ أَصۡبَرَهُمۡ عَلَى ٱلنَّارِ ١٧٥

494
01:20:06,034 --> 01:20:12,733
ذَٰلِكَ بِأَنَّ ٱللَّهَ نَزَّلَ ٱلۡكِتَٰبَ بِٱلۡحَقِّۗ

495
01:20:12,734 --> 01:20:23,913
وَإِنَّ ٱلَّذِينَ ٱخۡتَلَفُواْ فِي ٱلۡكِتَٰبِ لَفِي شِقَاقِۭ بَعِيدٖ ١٧٦

496
01:20:23,914 --> 01:20:37,093
لَّيۡسَ ٱلۡبِرَّ أَن تُوَلُّواْ وُجُوهَكُمۡ قِبَلَ ٱلۡمَشۡرِقِ وَٱلۡمَغۡرِبِ وَلَٰكِنَّ ٱلۡبِرَّ مَنۡ ءَامَنَ

497
01:20:37,094 --> 01:20:47,900
وَلَٰكِنَّ ٱلۡبِرَّ مَنۡ ءَامَنَ بِٱللَّهِ وَٱلۡيَوۡمِ ٱلۡأٓخِرِ وَٱلۡمَلَـٰٓئِكَةِ

498
01:20:47,901 --> 01:20:57,467
وَٱلۡمَلَـٰٓئِكَةِ وَٱلۡكِتَٰبِ وَٱلنَّبِيِّـۧنَ وَءَاتَى ٱلۡمَالَ

499
01:20:57,468 --> 01:21:13,227
وَءَاتَى ٱلۡمَالَ عَلَىٰ حُبِّهِۦ ذَوِي ٱلۡقُرۡبَىٰ وَٱلۡيَتَٰمَىٰ وَٱلۡمَسَٰكِينَ وَٱبۡنَ ٱلسَّبِيلِ وَٱلسَّآئِلِينَ وَفِي ٱلرِّقَابِ

500
01:21:13,228 --> 01:21:25,767
وَٱلسَّآئِلِينَ وَفِي ٱلرِّقَابِ وَأَقَامَ ٱلصَّلَوٰةَ وَءَاتَى ٱلزَّكَوٰةَ وَٱلۡمُوفُونَ بِعَهۡدِهِمۡ

501
01:21:25,768 --> 01:21:37,893
وَٱلۡمُوفُونَ بِعَهۡدِهِمۡ إِذَا عَٰهَدُواْۖ وَٱلصَّـٰبِرِينَ فِي ٱلۡبَأۡسَآءِ وَٱلضَّرَّآءِ

502
01:21:37,894 --> 01:21:48,160
وَٱلصَّـٰبِرِينَ فِي ٱلۡبَأۡسَآءِ وَٱلضَّرَّآءِ وَحِينَ ٱلۡبَأۡسِۗ

503
01:21:48,161 --> 01:22:00,460
أُوْلَـٰٓئِكَ ٱلَّذِينَ صَدَقُواْۖ وَأُوْلَـٰٓئِكَ هُمُ ٱلۡمُتَّقُونَ ١٧٧

504
01:22:00,461 --> 01:22:11,693
يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ كُتِبَ عَلَيۡكُمُ ٱلۡقِصَاصُ فِي ٱلۡقَتۡلَىۖ

505
01:22:11,694 --> 01:22:21,527
ٱلۡحُرُّ بِٱلۡحُرِّ وَٱلۡعَبۡدُ بِٱلۡعَبۡدِ وَٱلۡأُنثَىٰ بِٱلۡأُنثَىٰۚ

506
01:22:21,528 --> 01:22:33,073
فَمَنۡ عُفِيَ لَهُۥ مِنۡ أَخِيهِ شَيۡءٞ فَٱتِّبَاعُۢ بِٱلۡمَعۡرُوفِ

507
01:22:33,074 --> 01:22:43,060
فَٱتِّبَاعُۢ بِٱلۡمَعۡرُوفِ وَأَدَآءٌ إِلَيۡهِ بِإِحۡسَٰنٖۗ

508
01:22:43,061 --> 01:22:49,120
ذَٰلِكَ تَخۡفِيفٞ مِّن رَّبِّكُمۡ وَرَحۡمَةٞۗ

509
01:22:49,121 --> 01:22:57,953
فَمَنِ ٱعۡتَدَىٰ بَعۡدَ ذَٰلِكَ فَلَهُۥ عَذَابٌ أَلِيمٞ ١٧٨

510
01:22:57,954 --> 01:23:08,380
وَلَكُمۡ فِي ٱلۡقِصَاصِ حَيَوٰةٞ يَـٰٓأُوْلِي ٱلۡأَلۡبَٰبِ لَعَلَّكُمۡ تَتَّقُونَ ١٧٩

511
01:23:08,381 --> 01:23:23,120
كُتِبَ عَلَيۡكُمۡ إِذَا حَضَرَ أَحَدَكُمُ ٱلۡمَوۡتُ إِن تَرَكَ خَيۡرًا ٱلۡوَصِيَّةُ لِلۡوَٰلِدَيۡنِ وَٱلۡأَقۡرَبِينَ بِٱلۡمَعۡرُوفِۖ

512
01:23:23,121 --> 01:23:35,607
إِن تَرَكَ خَيۡرًا ٱلۡوَصِيَّةُ لِلۡوَٰلِدَيۡنِ وَٱلۡأَقۡرَبِينَ بِٱلۡمَعۡرُوفِۖ حَقًّا عَلَى ٱلۡمُتَّقِينَ ١٨٠

513
01:23:35,608 --> 01:23:48,573
فَمَنْ بَدَّلَهُ بَعْدَمَا سَمِعَهُ فَإِنَّمَا إِثْمُهُ عَلَى الَّذِينَ يُبَدِّلُونَهُ

514
01:23:48,574 --> 01:23:55,113
إِنَّ اللَّهَ سَمِيعٌ عَلِيمٌ ١٨١

515
01:23:55,114 --> 01:24:09,013
فَمَنۡ خَافَ مِن مُّوصٖ جَنَفًا أَوۡ إِثۡمٗا فَأَصۡلَحَ بَيۡنَهُمۡ فَلَآ إِثۡمَ عَلَيۡهِۚ

516
01:24:09,014 --> 01:24:14,120
إِنَّ ٱللَّهَ غَفُورٞ رَّحِيمٞ ١٨٢

517
01:24:14,121 --> 01:24:28,480
يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ كُتِبَ عَلَيۡكُمُ ٱلصِّيَامُ كَمَا كُتِبَ عَلَى ٱلَّذِينَ مِن قَبۡلِكُمۡ

518
01:24:28,481 --> 01:24:38,053
كَمَا كُتِبَ عَلَى ٱلَّذِينَ مِن قَبۡلِكُمۡ لَعَلَّكُمۡ تَتَّقُونَ ١٨٣

519
01:24:38,054 --> 01:24:43,600
أَيَّامٗا مَّعۡدُودَٰتٖۚ

520
01:24:43,601 --> 01:24:55,333
فَمَن كَانَ مِنكُم مَّرِيضًا أَوۡ عَلَىٰ سَفَرٖ فَعِدَّةٞ مِّنۡ أَيَّامٍ أُخَرَۚ

521
01:24:55,334 --> 01:25:05,053
وَعَلَى ٱلَّذِينَ يُطِيقُونَهُۥ فِدۡيَةٞ طَعَامُ مِسۡكِينٖۖ

522
01:25:05,054 --> 01:25:12,127
فَمَن تَطَوَّعَ خَيۡرٗا فَهُوَ خَيۡرٞ لَّهُۥۚ

523
01:25:12,128 --> 01:25:22,067
وَأَن تَصُومُواْ خَيۡرٞ لَّكُمۡ إِن كُنتُمۡ تَعۡلَمُونَ ١٨٤

524
01:25:22,068 --> 01:25:32,540
شَهۡرُ رَمَضَانَ ٱلَّذِيٓ أُنزِلَ فِيهِ ٱلۡقُرۡءَانُ هُدٗى لِّلنَّاسِ

525
01:25:32,541 --> 01:25:41,707
هُدٗى لِّلنَّاسِ وَبَيِّنَٰتٖ مِّنَ ٱلۡهُدَىٰ وَٱلۡفُرۡقَانِۚ

526
01:25:41,708 --> 01:25:49,220
فَمَن شَهِدَ مِنكُمُ ٱلشَّهۡرَ فَلۡيَصُمۡهُۖ

527
01:25:49,221 --> 01:25:58,687
وَمَن كَانَ مَرِيضًا أَوۡ عَلَىٰ سَفَرٖ فَعِدَّةٞ مِّنۡ أَيَّامٍ أُخَرَۗ

528
01:25:58,688 --> 01:26:04,860
يُرِيدُ ٱللَّهُ بِكُمُ ٱلۡيُسۡرَ وَلَا يُرِيدُ بِكُمُ ٱلۡعُسۡرَ

529
01:26:04,861 --> 01:26:12,060
وَلِتُكۡمِلُواْ ٱلۡعِدَّةَ وَلِتُكَبِّرُواْ ٱللَّهَ عَلَىٰ مَا هَدَىٰكُمۡ

530
01:26:12,061 --> 01:26:16,747
وَلَعَلَّكُمۡ تَشۡكُرُونَ ١٨٥

531
01:26:16,748 --> 01:26:26,140
وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌۖ

532
01:26:26,141 --> 01:26:35,660
فَإِنِّي قَرِيبٌۖ أُجِيبُ دَعۡوَةَ ٱلدَّاعِ إِذَا دَعَانِۖ

533
01:26:35,661 --> 01:26:44,480
فَلۡيَسۡتَجِيبُواْ لِي وَلۡيُؤۡمِنُواْ بِي لَعَلَّهُمۡ يَرۡشُدُونَ ١٨٦

534
01:26:44,481 --> 01:26:54,300
أُحِلَّ لَكُمۡ لَيۡلَةَ ٱلصِّيَامِ ٱلرَّفَثُ إِلَىٰ نِسَآئِكُمۡۚ

535
01:26:54,301 --> 01:27:03,507
هُنَّ لِبَاسٞ لَّكُمۡ وَأَنتُمۡ لِبَاسٞ لَّهُنَّۗ

536
01:27:03,508 --> 01:27:16,960
عَلِمَ ٱللَّهُ أَنَّكُمۡ كُنتُمۡ تَخۡتَانُونَ أَنفُسَكُمۡ فَتَابَ عَلَيۡكُمۡ وَعَفَا عَنكُمۡۖ

537
01:27:16,961 --> 01:27:25,080
فَٱلۡـَٰٔنَ بَٰشِرُوهُنَّ وَٱبۡتَغُواْ مَا كَتَبَ ٱللَّهُ لَكُمۡۚ

538
01:27:25,081 --> 01:27:34,847
وَكُلُواْ وَٱشۡرَبُواْ حَتَّىٰ يَتَبَيَّنَ لَكُمُ ٱلۡخَيۡطُ ٱلۡأَبۡيَضُ مِنَ ٱلۡخَيۡطِ ٱلۡأَسۡوَدِ مِنَ ٱلۡفَجۡرِۖ

539
01:27:34,848 --> 01:27:42,147
ثُمَّ أَتِمُّواْ ٱلصِّيَامَ إِلَى ٱلَّيۡلِۚ

540
01:27:42,148 --> 01:27:50,767
وَلَا تُبَٰشِرُوهُنَّ وَأَنتُمۡ عَٰكِفُونَ فِي ٱلۡمَسَٰجِدِۗ

541
01:27:50,768 --> 01:27:56,713
تِلۡكَ حُدُودُ ٱللَّهِ فَلَا تَقۡرَبُوهَاۗ

542
01:27:56,714 --> 01:28:04,980
كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ ءَايَٰتِهِۦ لِلنَّاسِ

543
01:28:04,981 --> 01:28:09,040
لَعَلَّهُمۡ يَتَّقُونَ ١٨٧

544
01:28:09,041 --> 01:28:22,120
وَلَا تَأۡكُلُوٓاْ أَمۡوَٰلَكُم بَيۡنَكُم بِٱلۡبَٰطِلِ وَتُدۡلُواْ بِهَآ إِلَى ٱلۡحُكَّامِ

545
01:28:22,121 --> 01:28:33,513
وَتُدۡلُواْ بِهَآ إِلَى ٱلۡحُكَّامِ لِتَأۡكُلُواْ فَرِيقٗا مِّنۡ أَمۡوَٰلِ ٱلنَّاسِ بِٱلۡإِثۡمِ

546
01:28:33,514 --> 01:28:40,540
وَأَنتُمۡ تَعۡلَمُونَ ١٨٨

547
01:28:40,541 --> 01:28:43,847
يَسۡـَٔلُونَكَ عَنِ ٱلۡأَهِلَّةِۖ

548
01:28:43,848 --> 01:28:49,253
قُلۡ هِيَ مَوَٰقِيتُ لِلنَّاسِ وَٱلۡحَجِّۗ

549
01:28:49,254 --> 01:28:59,807
وَلَيۡسَ ٱلۡبِرُّ بِأَن تَأۡتُواْ ٱلۡبُيُوتَ مِن ظُهُورِهَا وَلَٰكِنَّ ٱلۡبِرَّ مَنِ ٱتَّقَىٰۗ

550
01:28:59,808 --> 01:29:07,540
وَأۡتُواْ ٱلۡبُيُوتَ مِنۡ أَبۡوَٰبِهَاۚ وَٱتَّقُواْ ٱللَّهَ

551
01:29:07,541 --> 01:29:13,113
وَٱتَّقُواْ ٱللَّهَ لَعَلَّكُمۡ تُفۡلِحُونَ ١٨٩

552
01:29:13,114 --> 01:29:21,513
وَقَٰتِلُواْ فِي سَبِيلِ ٱللَّهِ ٱلَّذِينَ يُقَٰتِلُونَكُمۡ وَلَا تَعۡتَدُوٓاْۚ

553
01:29:21,514 --> 01:29:28,213
إِنَّ ٱللَّهَ لَا يُحِبُّ ٱلۡمُعۡتَدِينَ ١٩٠

554
01:29:28,214 --> 01:29:37,040
وَٱقۡتُلُوهُمۡ حَيۡثُ ثَقِفۡتُمُوهُمۡ وَأَخۡرِجُوهُم مِّنۡ حَيۡثُ أَخۡرَجُوكُمۡۚ

555
01:29:37,041 --> 01:29:40,460
وَٱلۡفِتۡنَةُ أَشَدُّ مِنَ ٱلۡقَتۡلِۚ

556
01:29:40,461 --> 01:29:50,647
وَلَا تُقَٰتِلُوهُمۡ عِندَ ٱلۡمَسۡجِدِ ٱلۡحَرَامِ حَتَّىٰ يُقَٰتِلُوكُمۡ فِيهِۖ

557
01:29:50,648 --> 01:29:55,340
فَإِن قَٰتَلُوكُمۡ فَٱقۡتُلُوهُمۡۗ

558
01:29:55,341 --> 01:30:01,933
كَذَٰلِكَ جَزَآءُ ٱلۡكَٰفِرِينَ ١٩١

559
01:30:01,934 --> 01:30:09,240
فَإِنِ ٱنتَهَوۡاْ فَإِنَّ ٱللَّهَ غَفُورٞ رَّحِيمٞ ١٩٢

560
01:30:09,241 --> 01:30:18,207
وَقَٰتِلُوهُمۡ حَتَّىٰ لَا تَكُونَ فِتۡنَةٞ وَيَكُونَ ٱلدِّينُ لِلَّهِۖ

561
01:30:18,208 --> 01:30:26,300
فَإِنِ ٱنتَهَوۡاْ فَلَا عُدۡوَٰنَ إِلَّا عَلَى ٱلظَّـٰلِمِينَ ١٩٣

562
01:30:26,301 --> 01:30:33,780
ٱلشَّهۡرُ ٱلۡحَرَامُ بِٱلشَّهۡرِ ٱلۡحَرَامِ وَٱلۡحُرُمَٰتُ قِصَاصٞۚ

563
01:30:33,781 --> 01:30:41,553
فَمَنِ ٱعۡتَدَىٰ عَلَيۡكُمۡ فَٱعۡتَدُواْ عَلَيۡهِ بِمِثۡلِ مَا ٱعۡتَدَىٰ عَلَيۡكُمۡۚ

564
01:30:41,554 --> 01:30:50,927
وَٱتَّقُواْ ٱللَّهَ وَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ مَعَ ٱلۡمُتَّقِينَ ١٩٤

565
01:30:50,928 --> 01:31:01,900
وَأَنفِقُواْ فِي سَبِيلِ ٱللَّهِ وَلَا تُلۡقُواْ بِأَيۡدِيكُمۡ إِلَى ٱلتَّهۡلُكَةِ وَأَحۡسِنُوٓاْۚ

566
01:31:01,901 --> 01:31:08,593
إِنَّ ٱللَّهَ يُحِبُّ ٱلۡمُحۡسِنِينَ ١٩٥

567
01:31:08,594 --> 01:31:15,167
وَأَتِمُّواْ ٱلۡحَجَّ وَٱلۡعُمۡرَةَ لِلَّهِۚ

568
01:31:15,168 --> 01:31:19,373
فَإِنۡ أُحۡصِرۡتُمۡ فَمَا ٱسۡتَيۡسَرَ مِنَ ٱلۡهَدۡيِۖ

569
01:31:19,374 --> 01:31:25,960
وَلَا تَحۡلِقُواْ رُءُوسَكُمۡ حَتَّىٰ يَبۡلُغَ ٱلۡهَدۡيُ مَحِلَّهُۥۚ

570
01:31:25,961 --> 01:31:36,647
فَمَن كَانَ مِنكُم مَّرِيضًا أَوۡ بِهِۦٓ أَذٗى مِّن رَّأۡسِهِۦ فَفِدۡيَةٞ

571
01:31:36,648 --> 01:31:43,593
فَفِدۡيَةٞ مِّن صِيَامٍ أَوۡ صَدَقَةٍ أَوۡ نُسُكٖۚ

572
01:31:43,594 --> 01:31:55,580
فَإِذَآ أَمِنتُمۡ فَمَن تَمَتَّعَ بِٱلۡعُمۡرَةِ إِلَى ٱلۡحَجِّ فَمَا ٱسۡتَيۡسَرَ مِنَ ٱلۡهَدۡيِۚ

573
01:31:55,581 --> 01:32:06,020
فَمَن لَّمۡ يَجِدۡ فَصِيَامُ ثَلَٰثَةِ أَيَّامٖ فِي ٱلۡحَجِّ وَسَبۡعَةٍ إِذَا رَجَعۡتُمۡۗ

574
01:32:06,021 --> 01:32:10,287
تِلۡكَ عَشَرَةٞ كَامِلَةٞۗ

575
01:32:10,288 --> 01:32:19,147
ذَٰلِكَ لِمَن لَّمۡ يَكُنۡ أَهۡلُهُۥ حَاضِرِي ٱلۡمَسۡجِدِ ٱلۡحَرَامِۚ

576
01:32:19,148 --> 01:32:29,173
وَٱتَّقُواْ ٱللَّهَ وَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ شَدِيدُ ٱلۡعِقَابِ ١٩٦

577
01:32:29,174 --> 01:32:35,113
ٱلۡحَجُّ أَشۡهُرٞ مَّعۡلُومَٰتٞۚ

578
01:32:35,114 --> 01:32:45,953
فَمَن فَرَضَ فِيهِنَّ ٱلۡحَجَّ فَلَا رَفَثَ وَلَا فُسُوقَ وَلَا جِدَالَ فِي ٱلۡحَجِّۗ

579
01:32:45,954 --> 01:32:54,373
وَمَا تَفۡعَلُواْ مِنۡ خَيۡرٖ يَعۡلَمۡهُ ٱللَّهُۗ

580
01:32:54,374 --> 01:33:00,947
وَتَزَوَّدُواْ فَإِنَّ خَيۡرَ ٱلزَّادِ ٱلتَّقۡوَىٰۖ

581
01:33:00,948 --> 01:33:07,747
وَٱتَّقُونِ يَـٰٓأُوْلِي ٱلۡأَلۡبَٰبِ ١٩٧

582
01:33:07,748 --> 01:33:16,820
لَيۡسَ عَلَيۡكُمۡ جُنَاحٌ أَن تَبۡتَغُواْ فَضۡلٗا مِّن رَّبِّكُمۡۚ

583
01:33:16,821 --> 01:33:29,520
فَإِذَآ أَفَضۡتُم مِّنۡ عَرَفَٰتٖ فَٱذۡكُرُواْ ٱللَّهَ عِندَ ٱلۡمَشۡعَرِ ٱلۡحَرَامِۖ

584
01:33:29,521 --> 01:33:33,760
وَٱذۡكُرُوهُ كَمَا هَدَىٰكُمۡ

585
01:33:33,761 --> 01:33:47,013
وَإِن كُنتُم مِّن قَبۡلِهِۦ لَمِنَ ٱلضَّآلِّينَ ١٩٨

586
01:33:47,014 --> 01:33:56,673
ثُمَّ أَفِيضُواْ مِنۡ حَيۡثُ أَفَاضَ ٱلنَّاسُ وَٱسۡتَغۡفِرُواْ ٱللَّهَۚ

587
01:33:56,674 --> 01:34:01,840
إِنَّ ٱللَّهَ غَفُورٞ رَّحِيمٞ ١٩٩

588
01:34:01,841 --> 01:34:14,940
فَإِذَا قَضَيۡتُم مَّنَٰسِكَكُمۡ فَٱذۡكُرُواْ ٱللَّهَ كَذِكۡرِكُمۡ ءَابَآءَكُمۡ أَوۡ أَشَدَّ ذِكۡرٗاۗ

589
01:34:14,941 --> 01:34:24,427
فَمِنَ ٱلنَّاسِ مَن يَقُولُ رَبَّنَآ ءَاتِنَا فِي ٱلدُّنۡيَا

590
01:34:24,428 --> 01:34:31,967
وَمَا لَهُۥ فِي ٱلۡأٓخِرَةِ مِنۡ خَلَٰقٖ ٢٠٠

591
01:34:31,968 --> 01:34:41,280
وَمِنۡهُم مَّن يَقُولُ رَبَّنَآ ءَاتِنَا فِي ٱلدُّنۡيَا حَسَنَةٗ

592
01:34:41,281 --> 01:34:50,640
رَبَّنَآ ءَاتِنَا فِي ٱلدُّنۡيَا حَسَنَةٗ وَفِي ٱلۡأٓخِرَةِ حَسَنَةٗ

593
01:34:50,641 --> 01:34:56,207
وَقِنَا عَذَابَ ٱلنَّارِ ٢٠١

594
01:34:56,208 --> 01:35:05,660
أُوْلَـٰٓئِكَ لَهُمۡ نَصِيبٞ مِّمَّا كَسَبُواْۚ

595
01:35:05,661 --> 01:35:12,220
وَٱللَّهُ سَرِيعُ ٱلۡحِسَابِ ٢٠٢

596
01:35:12,221 --> 01:35:21,973
وَٱذۡكُرُواْ ٱللَّهَ فِيٓ أَيَّامٖ مَّعۡدُودَٰتٖۚ

597
01:35:21,974 --> 01:35:32,260
فَمَن تَعَجَّلَ فِي يَوۡمَيۡنِ فَلَآ إِثۡمَ عَلَيۡهِ

598
01:35:32,261 --> 01:35:41,480
وَمَن تَأَخَّرَ فَلَآ إِثۡمَ عَلَيۡهِۖ لِمَنِ ٱتَّقَىٰۗ

599
01:35:41,481 --> 01:35:50,807
وَٱتَّقُواْ ٱللَّهَ وَٱعۡلَمُوٓاْ أَنَّكُمۡ إِلَيۡهِ تُحۡشَرُونَ ٢٠٣

600
01:35:50,808 --> 01:35:59,933
وَمِنَ ٱلنَّاسِ مَن يُعۡجِبُكَ قَوۡلُهُۥ فِي ٱلۡحَيَوٰةِ ٱلدُّنۡيَا

601
01:35:59,934 --> 01:36:08,460
وَيُشۡهِدُ ٱللَّهَ عَلَىٰ مَا فِي قَلۡبِهِۦ وَهُوَ أَلَدُّ ٱلۡخِصَامِ ٢٠٤

602
01:36:08,461 --> 01:36:17,693
وَإِذَا تَوَلَّىٰ سَعَىٰ فِي ٱلۡأَرۡضِ لِيُفۡسِدَ فِيهَا وَيُهۡلِكَ ٱلۡحَرۡثَ وَٱلنَّسۡلَۚ

603
01:36:17,694 --> 01:36:25,000
وَٱللَّهُ لَا يُحِبُّ ٱلۡفَسَادَ ٢٠٥

604
01:36:25,001 --> 01:36:31,827
وَإِذَا قِيلَ لَهُ ٱتَّقِ ٱللَّهَ أَخَذَتۡهُ ٱلۡعِزَّةُ بِٱلۡإِثۡمِۚ

605
01:36:31,828 --> 01:36:39,933
فَحَسۡبُهُۥ جَهَنَّمُۖ وَلَبِئۡسَ ٱلۡمِهَادُ ٢٠٦

606
01:36:39,934 --> 01:36:51,513
وَمِنَ ٱلنَّاسِ مَن يَشۡرِي نَفۡسَهُ ٱبۡتِغَآءَ مَرۡضَاتِ ٱللَّهِۚ

607
01:36:51,514 --> 01:36:59,913
وَٱللَّهُ رَءُوفُۢ بِٱلۡعِبَادِ ٢٠٧

608
01:36:59,914 --> 01:37:14,047
يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ ٱدۡخُلُواْ فِي ٱلسِّلۡمِ كَآفَّةٗ وَلَا تَتَّبِعُواْ

609
01:37:14,048 --> 01:37:22,400
وَلَا تَتَّبِعُواْ خُطُوَٰتِ ٱلشَّيۡطَٰنِۚ

610
01:37:22,401 --> 01:37:28,880
إِنَّهُۥ لَكُمۡ عَدُوّٞ مُّبِينٞ ٢٠٨

611
01:37:28,881 --> 01:37:40,920
فَإِن زَلَلۡتُم مِّنۢ بَعۡدِ مَا جَآءَتۡكُمُ ٱلۡبَيِّنَٰتُ فَٱعۡلَمُوٓاْ

612
01:37:40,921 --> 01:37:48,720
فَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ عَزِيزٌ حَكِيمٌ ٢٠٩

613
01:37:48,721 --> 01:38:03,780
هَلۡ يَنظُرُونَ إِلَّآ أَن يَأۡتِيَهُمُ ٱللَّهُ فِي ظُلَلٖ مِّنَ ٱلۡغَمَامِ وَٱلۡمَلَـٰٓئِكَةُ وَقُضِيَ ٱلۡأَمۡرُۚ

614
01:38:03,781 --> 01:38:10,467
وَإِلَى ٱللَّهِ تُرۡجَعُ ٱلۡأُمُورُ ٢١٠

615
01:38:10,468 --> 01:38:22,127
سَلۡ بَنِيٓ إِسۡرَـٰٓءِيلَ كَمۡ ءَاتَيۡنَٰهُم مِّنۡ ءَايَةِۭ بَيِّنَةٖۗ

616
01:38:22,128 --> 01:38:33,573
وَمَن يُبَدِّلۡ نِعۡمَةَ ٱللَّهِ مِنۢ بَعۡدِ مَا جَآءَتۡهُ فَإِنَّ ٱللَّهَ

617
01:38:33,574 --> 01:38:39,493
فَإِنَّ ٱللَّهَ شَدِيدُ ٱلۡعِقَابِ ٢١١

618
01:38:39,494 --> 01:38:49,300
زُيِّنَ لِلَّذِينَ كَفَرُواْ ٱلۡحَيَوٰةُ ٱلدُّنۡيَا وَيَسۡخَرُونَ مِنَ ٱلَّذِينَ ءَامَنُواْۘ

619
01:38:49,301 --> 01:38:55,067
وَٱلَّذِينَ ٱتَّقَوۡاْ فَوۡقَهُمۡ يَوۡمَ ٱلۡقِيَٰمَةِۗ

620
01:38:55,068 --> 01:39:04,440
وَٱللَّهُ يَرۡزُقُ مَن يَشَآءُ بِغَيۡرِ حِسَابٖ ٢١٢

621
01:39:04,441 --> 01:39:14,733
كَانَ ٱلنَّاسُ أُمَّةٗ وَٰحِدَةٗ فَبَعَثَ ٱللَّهُ ٱلنَّبِيِّـۧنَ

622
01:39:14,734 --> 01:39:27,873
فَبَعَثَ ٱللَّهُ ٱلنَّبِيِّـۧنَ مُبَشِّرِينَ وَمُنذِرِينَ وَأَنزَلَ مَعَهُمُ ٱلۡكِتَٰبَ بِٱلۡحَقِّ

623
01:39:27,874 --> 01:39:39,493
وَأَنزَلَ مَعَهُمُ ٱلۡكِتَٰبَ بِٱلۡحَقِّ لِيَحۡكُمَ بَيۡنَ ٱلنَّاسِ فِيمَا ٱخۡتَلَفُواْ فِيهِۚ

624
01:39:39,494 --> 01:39:52,800
وَمَا ٱخۡتَلَفَ فِيهِ إِلَّا ٱلَّذِينَ أُوتُوهُ مِنۢ بَعۡدِ مَا جَآءَتۡهُمُ ٱلۡبَيِّنَٰتُ بَغۡيَۢا بَيۡنَهُمۡۖ

625
01:39:52,801 --> 01:40:01,340
فَهَدَى ٱللَّهُ ٱلَّذِينَ ءَامَنُواْ لِمَا ٱخۡتَلَفُواْ فِيهِ مِنَ ٱلۡحَقِّ بِإِذۡنِهِۦۗ

626
01:40:01,341 --> 01:40:12,560
وَٱللَّهُ يَهۡدِي مَن يَشَآءُ إِلَىٰ صِرَٰطٖ مُّسۡتَقِيمٍ ٢١٣

627
01:40:12,561 --> 01:40:25,800
أَمۡ حَسِبۡتُمۡ أَن تَدۡخُلُواْ ٱلۡجَنَّةَ وَلَمَّا يَأۡتِكُم مَّثَلُ ٱلَّذِينَ خَلَوۡاْ مِن قَبۡلِكُمۖ

628
01:40:25,801 --> 01:40:34,987
مَّسَّتۡهُمُ ٱلۡبَأۡسَآءُ وَٱلضَّرَّآءُ وَزُلۡزِلُواْ

629
01:40:34,988 --> 01:40:45,967
وَزُلۡزِلُواْ حَتَّىٰ يَقُولَ ٱلرَّسُولُ وَٱلَّذِينَ ءَامَنُواْ مَعَهُۥ مَتَىٰ نَصۡرُ ٱللَّهِۗ

630
01:40:45,968 --> 01:40:53,520
أَلَآ إِنَّ نَصۡرَ ٱللَّهِ قَرِيبٞ ٢١٤

631
01:40:53,521 --> 01:41:08,133
يَسۡـَٔلُونَكَ مَاذَا يُنفِقُونَۖ قُلۡ مَآ أَنفَقۡتُم مِّنۡ خَيۡرٖ فَلِلۡوَٰلِدَيۡنِ وَٱلۡأَقۡرَبِينَ

632
01:41:08,134 --> 01:41:18,293
فَلِلۡوَٰلِدَيۡنِ وَٱلۡأَقۡرَبِينَ وَٱلۡيَتَٰمَىٰ وَٱلۡمَسَٰكِينِ وَٱبۡنِ ٱلسَّبِيلِۗ

633
01:41:18,294 --> 01:41:26,787
وَمَا تَفۡعَلُواْ مِنۡ خَيۡرٖ فَإِنَّ ٱللَّهَ بِهِۦ عَلِيمٞ ٢١٥

634
01:41:26,788 --> 01:41:32,573
كُتِبَ عَلَيۡكُمُ ٱلۡقِتَالُ وَهُوَ كُرۡهٞ لَّكُمۡۖ

635
01:41:32,574 --> 01:41:42,033
وَعَسَىٰٓ أَن تَكۡرَهُواْ شَيۡـٔٗا وَهُوَ خَيۡرٞ لَّكُمۡۖ

636
01:41:42,034 --> 01:41:51,500
وَعَسَىٰٓ أَن تُحِبُّواْ شَيۡـٔٗا وَهُوَ شَرّٞ لَّكُمۡۚ

637
01:41:51,501 --> 01:41:58,647
وَٱللَّهُ يَعۡلَمُ وَأَنتُمۡ لَا تَعۡلَمُونَ ٢١٦

638
01:41:58,648 --> 01:42:06,273
يَسۡـَٔلُونَكَ عَنِ ٱلشَّهۡرِ ٱلۡحَرَامِ قِتَالٖ فِيهِۖ

639
01:42:06,274 --> 01:42:11,680
قُلۡ قِتَالٞ فِيهِ كَبِيرٞۚ

640
01:42:11,681 --> 01:42:22,380
وَصَدٌّ عَن سَبِيلِ ٱللَّهِ وَكُفۡرُۢ بِهِۦ وَٱلۡمَسۡجِدِ ٱلۡحَرَامِ

641
01:42:22,381 --> 01:42:32,787
وَٱلۡمَسۡجِدِ ٱلۡحَرَامِ وَإِخۡرَاجُ أَهۡلِهِۦ مِنۡهُ أَكۡبَرُ عِندَ ٱللَّهِۚ

642
01:42:32,788 --> 01:42:36,540
وَٱلۡفِتۡنَةُ أَكۡبَرُ مِنَ ٱلۡقَتۡلِۗ

643
01:42:36,541 --> 01:42:46,800
وَلَا يَزَالُونَ يُقَٰتِلُونَكُمۡ حَتَّىٰ يَرُدُّوكُمۡ عَن دِينِكُمۡ إِنِ ٱسۡتَطَٰعُواْۚ

644
01:42:46,801 --> 01:42:58,740
وَمَن يَرۡتَدِدۡ مِنكُمۡ عَن دِينِهِۦ فَيَمُتۡ وَهُوَ كَافِرٞ فَأُوْلَـٰٓئِكَ

645
01:42:58,741 --> 01:43:07,887
فَأُوْلَـٰٓئِكَ حَبِطَتۡ أَعۡمَٰلُهُمۡ فِي ٱلدُّنۡيَا وَٱلۡأٓخِرَةِۖ

646
01:43:07,888 --> 01:43:17,440
وَأُوْلَـٰٓئِكَ أَصۡحَٰبُ ٱلنَّارِۖ هُمۡ فِيهَا خَٰلِدُونَ ٢١٧

647
01:43:17,441 --> 01:43:30,300
إِنَّ ٱلَّذِينَ ءَامَنُواْ وَٱلَّذِينَ هَاجَرُواْ وَجَٰهَدُواْ فِي سَبِيلِ ٱللَّهِ أُوْلَـٰٓئِكَ

648
01:43:30,301 --> 01:43:39,140
أُوْلَـٰٓئِكَ يَرۡجُونَ رَحۡمَتَ ٱللَّهِۚ

649
01:43:39,141 --> 01:43:45,207
وَٱللَّهُ غَفُورٞ رَّحِيمٞ ٢١٨

650
01:43:45,208 --> 01:43:49,327
يَسۡـَٔلُونَكَ عَنِ ٱلۡخَمۡرِ وَٱلۡمَيۡسِرِۖ

651
01:43:49,328 --> 01:43:58,720
قُلۡ فِيهِمَآ إِثۡمٞ كَبِيرٞ وَمَنَٰفِعُ لِلنَّاسِ

652
01:43:58,721 --> 01:44:05,720
وَإِثۡمُهُمَآ أَكۡبَرُ مِن نَّفۡعِهِمَاۗ

653
01:44:05,721 --> 01:44:11,800
وَيَسۡـَٔلُونَكَ مَاذَا يُنفِقُونَۖ قُلِ ٱلۡعَفۡوَۗ

654
01:44:11,801 --> 01:44:19,380
كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ لَكُمُ ٱلۡأٓيَٰتِ

655
01:44:19,381 --> 01:44:29,193
كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ لَكُمُ ٱلۡأٓيَٰتِ لَعَلَّكُمۡ تَتَفَكَّرُونَ ٢١٩

656
01:44:29,194 --> 01:44:32,600
فِي ٱلدُّنۡيَا وَٱلۡأٓخِرَةِۗ

657
01:44:32,601 --> 01:44:40,440
وَيَسۡـَٔلُونَكَ عَنِ ٱلۡيَتَٰمَىٰۖ قُلۡ إِصۡلَاحٞ لَّهُمۡ خَيۡرٞۖ

658
01:44:40,441 --> 01:44:46,253
وَإِن تُخَالِطُوهُمۡ فَإِخۡوَٰنُكُمۡۚ

659
01:44:46,254 --> 01:44:50,680
وَٱللَّهُ يَعۡلَمُ ٱلۡمُفۡسِدَ مِنَ ٱلۡمُصۡلِحِۚ

660
01:44:50,681 --> 01:44:56,620
وَلَوۡ شَآءَ ٱللَّهُ لَأَعۡنَتَكُمۡۚ

661
01:44:56,621 --> 01:45:02,873
إِنَّ ٱللَّهَ عَزِيزٌ حَكِيمٞ ٢٢٠

662
01:45:02,874 --> 01:45:09,533
وَلَا تَنكِحُواْ ٱلۡمُشۡرِكَٰتِ حَتَّىٰ يُؤۡمِنَّۚ

663
01:45:09,534 --> 01:45:18,400
وَلَأَمَةٞ مُّؤۡمِنَةٌ خَيۡرٞ مِّن مُّشۡرِكَةٖ وَلَوۡ أَعۡجَبَتۡكُمۡۗ

664
01:45:18,401 --> 01:45:24,600
وَلَا تُنكِحُواْ ٱلۡمُشۡرِكِينَ حَتَّىٰ يُؤۡمِنُواْۚ

665
01:45:24,601 --> 01:45:33,580
وَلَعَبۡدٞ مُّؤۡمِنٌ خَيۡرٞ مِّن مُّشۡرِكٖ وَلَوۡ أَعۡجَبَكُمۡۗ

666
01:45:33,581 --> 01:45:41,020
أُوْلَـٰٓئِكَ يَدۡعُونَ إِلَى ٱلنَّارِۖ

667
01:45:41,021 --> 01:45:49,520
وَٱللَّهُ يَدۡعُوٓاْ إِلَى ٱلۡجَنَّةِ وَٱلۡمَغۡفِرَةِ بِإِذۡنِهِۦۖ

668
01:45:49,521 --> 01:45:57,680
وَيُبَيِّنُ ءَايَٰتِهِۦ لِلنَّاسِ لَعَلَّهُمۡ يَتَذَكَّرُونَ ٢٢١

669
01:45:57,681 --> 01:46:02,160
وَيَسۡـَٔلُونَكَ عَنِ ٱلۡمَحِيضِۖ

670
01:46:02,161 --> 01:46:11,680
قُلۡ هُوَ أَذٗى فَٱعۡتَزِلُواْ ٱلنِّسَآءَ فِي ٱلۡمَحِيضِ

671
01:46:11,681 --> 01:46:17,227
وَلَا تَقۡرَبُوهُنَّ حَتَّىٰ يَطۡهُرۡنَۖ

672
01:46:17,228 --> 01:46:26,580
فَإِذَا تَطَهَّرۡنَ فَأۡتُوهُنَّ مِنۡ حَيۡثُ أَمَرَكُمُ ٱللَّهُۚ

673
01:46:26,581 --> 01:46:35,973
إِنَّ ٱللَّهَ يُحِبُّ ٱلتَّوَّـٰبِينَ وَيُحِبُّ ٱلۡمُتَطَهِّرِينَ ٢٢٢

674
01:46:35,974 --> 01:46:45,113
نِسَآؤُكُمۡ حَرۡثٞ لَّكُمۡ فَأۡتُواْ حَرۡثَكُمۡ أَنَّىٰ شِئۡتُمۡۖ

675
01:46:45,114 --> 01:46:53,387
فَأۡتُواْ حَرۡثَكُمۡ أَنَّىٰ شِئۡتُمۡۖ وَقَدِّمُواْ لِأَنفُسِكُمۡۚ

676
01:46:53,388 --> 01:47:02,920
وَٱتَّقُواْ ٱللَّهَ وَٱعۡلَمُوٓاْ أَنَّكُم مُّلَٰقُوهُۗ

677
01:47:02,921 --> 01:47:06,853
وَبَشِّرِ ٱلۡمُؤۡمِنِينَ ٢٢٣

678
01:47:06,854 --> 01:47:19,193
وَلَا تَجۡعَلُواْ ٱللَّهَ عُرۡضَةٗ لِّأَيۡمَٰنِكُمۡ أَن تَبَرُّواْ وَتَتَّقُواْ وَتُصۡلِحُواْ بَيۡنَ ٱلنَّاسِۚ

679
01:47:19,194 --> 01:47:24,753
وَٱللَّهُ سَمِيعٌ عَلِيمٞ ٢٢٤

680
01:47:24,754 --> 01:47:32,780
لَّا يُؤَاخِذُكُمُ ٱللَّهُ بِٱللَّغۡوِ فِيٓ أَيۡمَٰنِكُمۡ

681
01:47:32,781 --> 01:47:41,080
وَلَٰكِن يُؤَاخِذُكُم بِمَا كَسَبَتۡ قُلُوبُكُمۡۗ

682
01:47:41,081 --> 01:47:46,100
وَٱللَّهُ غَفُورٌ حَلِيمٞ ٢٢٥

683
01:47:46,101 --> 01:47:54,867
لِّلَّذِينَ يُؤۡلُونَ مِن نِّسَآئِهِمۡ تَرَبُّصُ أَرۡبَعَةِ أَشۡهُرٖۖ

684
01:47:54,868 --> 01:48:04,427
فَإِن فَآءُو فَإِنَّ ٱللَّهَ غَفُورٞ رَّحِيمٞ ٢٢٦

685
01:48:04,428 --> 01:48:11,707
وَإِنۡ عَزَمُواْ ٱلطَّلَٰقَ فَإِنَّ ٱللَّهَ سَمِيعٌ عَلِيمٞ ٢٢٧

686
01:48:11,708 --> 01:48:22,307
وَٱلۡمُطَلَّقَٰتُ يَتَرَبَّصۡنَ بِأَنفُسِهِنَّ ثَلَٰثَةَ قُرُوٓءٖۚ

687
01:48:22,308 --> 01:48:32,920
وَلَا يَحِلُّ لَهُنَّ أَن يَكۡتُمۡنَ مَا خَلَقَ ٱللَّهُ فِيٓ أَرۡحَامِهِنَّ

688
01:48:32,921 --> 01:48:39,973
إِن كُنَّ يُؤۡمِنَّ بِٱللَّهِ وَٱلۡيَوۡمِ ٱلۡأٓخِرِۚ

689
01:48:39,974 --> 01:48:51,307
وَبُعُولَتُهُنَّ أَحَقُّ بِرَدِّهِنَّ فِي ذَٰلِكَ إِنۡ أَرَادُوٓاْ إِصۡلَٰحٗاۚ

690
01:48:51,308 --> 01:48:58,147
وَلَهُنَّ مِثۡلُ ٱلَّذِي عَلَيۡهِنَّ بِٱلۡمَعۡرُوفِۚ

691
01:48:58,148 --> 01:49:02,820
وَلِلرِّجَالِ عَلَيۡهِنَّ دَرَجَةٞۗ

692
01:49:02,821 --> 01:49:08,307
وَٱللَّهُ عَزِيزٌ حَكِيمٌ ٢٢٨

693
01:49:08,308 --> 01:49:12,520
ٱلطَّلَٰقُ مَرَّتَانِۖ

694
01:49:12,521 --> 01:49:21,720
فَإِمۡسَاكُۢ بِمَعۡرُوفٍ أَوۡ تَسۡرِيحُۢ بِإِحۡسَٰنٖۗ

695
01:49:21,721 --> 01:49:35,087
وَلَا يَحِلُّ لَكُمۡ أَن تَأۡخُذُواْ مِمَّآ ءَاتَيۡتُمُوهُنَّ شَيۡـًٔا إِلَّآ أَن يَخَافَآ

696
01:49:35,088 --> 01:49:45,627
إِلَّآ أَن يَخَافَآ أَلَّا يُقِيمَا حُدُودَ ٱللَّهِۖ

697
01:49:45,628 --> 01:49:55,113
فَإِنۡ خِفۡتُمۡ أَلَّا يُقِيمَا حُدُودَ ٱللَّهِ فَلَا جُنَاحَ عَلَيۡهِمَا فِيمَا ٱفۡتَدَتۡ بِهِۦۗ

698
01:49:55,114 --> 01:50:01,240
تِلۡكَ حُدُودُ ٱللَّهِ فَلَا تَعۡتَدُوهَاۚ

699
01:50:01,241 --> 01:50:09,813
وَمَن يَتَعَدَّ حُدُودَ ٱللَّهِ فَأُوْلَـٰٓئِكَ

700
01:50:09,814 --> 01:50:16,200
فَأُوْلَـٰٓئِكَ هُمُ ٱلظَّـٰلِمُونَ ٢٢٩

701
01:50:16,201 --> 01:50:27,427
فَإِن طَلَّقَهَا فَلَا تَحِلُّ لَهُۥ مِنۢ بَعۡدُ حَتَّىٰ تَنكِحَ زَوۡجًا غَيۡرَهُۥۗ

702
01:50:27,428 --> 01:50:36,833
فَإِن طَلَّقَهَا فَلَا جُنَاحَ عَلَيۡهِمَآ أَن يَتَرَاجَعَآ

703
01:50:36,834 --> 01:50:48,620
أَن يَتَرَاجَعَآ إِن ظَنَّآ أَن يُقِيمَا حُدُودَ ٱللَّهِۗ

704
01:50:48,621 --> 01:50:57,393
وَتِلۡكَ حُدُودُ ٱللَّهِ يُبَيِّنُهَا لِقَوۡمٖ يَعۡلَمُونَ ٢٣٠

705
01:50:57,394 --> 01:51:08,127
وَإِذَا طَلَّقۡتُمُ ٱلنِّسَآءَ فَبَلَغۡنَ أَجَلَهُنَّ فَأَمۡسِكُوهُنَّ

706
01:51:08,128 --> 01:51:17,207
فَأَمۡسِكُوهُنَّ بِمَعۡرُوفٍ أَوۡ سَرِّحُوهُنَّ بِمَعۡرُوفٖۚ

707
01:51:17,208 --> 01:51:23,907
وَلَا تُمۡسِكُوهُنَّ ضِرَارٗا لِّتَعۡتَدُواْۚ

708
01:51:23,908 --> 01:51:29,280
وَمَن يَفۡعَلۡ ذَٰلِكَ فَقَدۡ ظَلَمَ نَفۡسَهُۥۚ

709
01:51:29,281 --> 01:51:36,140
وَلَا تَتَّخِذُوٓاْ ءَايَٰتِ ٱللَّهِ هُزُوٗاۚ

710
01:51:36,141 --> 01:51:46,040
وَٱذۡكُرُواْ نِعۡمَتَ ٱللَّهِ عَلَيۡكُمۡ وَمَآ أَنزَلَ عَلَيۡكُم مِّنَ ٱلۡكِتَٰبِ وَٱلۡحِكۡمَةِ

711
01:51:46,041 --> 01:51:55,507
وَمَآ أَنزَلَ عَلَيۡكُم مِّنَ ٱلۡكِتَٰبِ وَٱلۡحِكۡمَةِ يَعِظُكُم بِهِۦۚ

712
01:51:55,508 --> 01:52:04,780
وَٱتَّقُواْ ٱللَّهَ وَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ بِكُلِّ شَيۡءٍ عَلِيمٞ ٢٣١

713
01:52:04,781 --> 01:52:16,400
وَإِذَا طَلَّقۡتُمُ ٱلنِّسَآءَ فَبَلَغۡنَ أَجَلَهُنَّ فَلَا تَعۡضُلُوهُنَّ

714
01:52:16,401 --> 01:52:28,113
فَلَا تَعۡضُلُوهُنَّ أَن يَنكِحۡنَ أَزۡوَٰجَهُنَّ إِذَا تَرَٰضَوۡاْ بَيۡنَهُم بِٱلۡمَعۡرُوفِۗ

715
01:52:28,114 --> 01:52:37,860
ذَٰلِكَ يُوعَظُ بِهِۦ مَن كَانَ مِنكُمۡ يُؤۡمِنُ بِٱللَّهِ وَٱلۡيَوۡمِ ٱلۡأٓخِرِۗ

716
01:52:37,861 --> 01:52:42,380
ذَٰلِكُمۡ أَزۡكَىٰ لَكُمۡ وَأَطۡهَرُۚ

717
01:52:42,381 --> 01:52:50,400
وَٱللَّهُ يَعۡلَمُ وَأَنتُمۡ لَا تَعۡلَمُونَ ٢٣٢

718
01:52:50,401 --> 01:53:02,787
وَٱلۡوَٰلِدَٰتُ يُرۡضِعۡنَ أَوۡلَٰدَهُنَّ حَوۡلَيۡنِ كَامِلَيۡنِۖ لِمَنۡ أَرَادَ أَن يُتِمَّ ٱلرَّضَاعَةَۚ

719
01:53:02,788 --> 01:53:13,087
وَعَلَى ٱلۡمَوۡلُودِ لَهُۥ رِزۡقُهُنَّ وَكِسۡوَتُهُنَّ بِٱلۡمَعۡرُوفِۚ

720
01:53:13,088 --> 01:53:17,887
لَا تُكَلَّفُ نَفۡسٌ إِلَّا وُسۡعَهَاۚ

721
01:53:17,888 --> 01:53:28,553
لَا تُضَآرَّ وَٰلِدَةُۢ بِوَلَدِهَا وَلَا مَوۡلُودٞ لَّهُۥ بِوَلَدِهِۦۚ

722
01:53:28,554 --> 01:53:32,220
وَعَلَى ٱلۡوَارِثِ مِثۡلُ ذَٰلِكَۗ

723
01:53:32,221 --> 01:53:44,147
فَإِنۡ أَرَادَا فِصَالًا عَن تَرَاضٖ مِّنۡهُمَا وَتَشَاوُرٖ فَلَا جُنَاحَ عَلَيۡهِمَاۗ

724
01:53:44,148 --> 01:53:53,620
وَإِنۡ أَرَدتُّمۡ أَن تَسۡتَرۡضِعُوٓاْ أَوۡلَٰدَكُمۡ فَلَا جُنَاحَ عَلَيۡكُمۡ

725
01:53:53,621 --> 01:54:05,187
فَلَا جُنَاحَ عَلَيۡكُمۡ إِذَا سَلَّمۡتُم مَّآ ءَاتَيۡتُم بِٱلۡمَعۡرُوفِۗ

726
01:54:05,188 --> 01:54:15,687
وَٱتَّقُواْ ٱللَّهَ وَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ بِمَا تَعۡمَلُونَ بَصِيرٞ ٢٣٣

727
01:54:15,688 --> 01:54:26,800
وَٱلَّذِينَ يُتَوَفَّوۡنَ مِنكُمۡ وَيَذَرُونَ أَزۡوَٰجٗا يَتَرَبَّصۡنَ بِأَنفُسِهِنَّ

728
01:54:26,801 --> 01:54:37,787
وَيَذَرُونَ أَزۡوَٰجٗا يَتَرَبَّصۡنَ بِأَنفُسِهِنَّ أَرۡبَعَةَ أَشۡهُرٖ وَعَشۡرٗاۖ

729
01:54:37,788 --> 01:54:50,353
فَإِذَا بَلَغۡنَ أَجَلَهُنَّ فَلَا جُنَاحَ عَلَيۡكُمۡ فِيمَا فَعَلۡنَ فِيٓ أَنفُسِهِنَّ بِٱلۡمَعۡرُوفِۗ

730
01:54:50,354 --> 01:54:55,440
وَٱللَّهُ بِمَا تَعۡمَلُونَ خَبِيرٞ ٢٣٤

731
01:54:55,441 --> 01:55:10,320
وَلَا جُنَاحَ عَلَيۡكُمۡ فِيمَا عَرَّضۡتُم بِهِۦ مِنۡ خِطۡبَةِ ٱلنِّسَآءِ أَوۡ أَكۡنَنتُمۡ فِيٓ أَنفُسِكُمۡۚ

732
01:55:10,321 --> 01:55:24,547
عَلِمَ ٱللَّهُ أَنَّكُمۡ سَتَذۡكُرُونَهُنَّ وَلَٰكِن لَّا تُوَاعِدُوهُنَّ سِرًّا إِلَّآ أَن تَقُولُواْ

733
01:55:24,548 --> 01:55:31,667
إِلَّآ أَن تَقُولُواْ قَوۡلٗا مَّعۡرُوفٗاۚ

734
01:55:31,668 --> 01:55:39,007
وَلَا تَعۡزِمُواْ عُقۡدَةَ ٱلنِّكَاحِ حَتَّىٰ يَبۡلُغَ ٱلۡكِتَٰبُ أَجَلَهُۥۚ

735
01:55:39,008 --> 01:55:49,473
وَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ يَعۡلَمُ مَا فِيٓ أَنفُسِكُمۡ فَٱحۡذَرُوهُۚ

736
01:55:49,474 --> 01:55:57,147
وَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ غَفُورٌ حَلِيمٞ ٢٣٥

737
01:55:57,148 --> 01:56:08,107
لَّا جُنَاحَ عَلَيۡكُمۡ إِن طَلَّقۡتُمُ ٱلنِّسَآءَ مَا لَمۡ تَمَسُّوهُنَّ

738
01:56:08,108 --> 01:56:14,913
مَا لَمۡ تَمَسُّوهُنَّ أَوۡ تَفۡرِضُواْ لَهُنَّ فَرِيضَةٗۚ

739
01:56:14,914 --> 01:56:27,387
وَمَتِّعُوهُنَّ عَلَى ٱلۡمُوسِعِ قَدَرُهُۥ وَعَلَى ٱلۡمُقۡتِرِ قَدَرُهُۥ مَتَٰعَۢا بِٱلۡمَعۡرُوفِۖ

740
01:56:27,388 --> 01:56:31,107
حَقًّا عَلَى ٱلۡمُحۡسِنِينَ ٢٣٦

741
01:56:31,108 --> 01:56:44,120
وَإِن طَلَّقۡتُمُوهُنَّ مِن قَبۡلِ أَن تَمَسُّوهُنَّ وَقَدۡ فَرَضۡتُمۡ لَهُنَّ فَرِيضَةٗ

742
01:56:44,121 --> 01:56:55,887
فَنِصۡفُ مَا فَرَضۡتُمۡ إِلَّآ أَن يَعۡفُونَ أَوۡ يَعۡفُوَاْ ٱلَّذِي بِيَدِهِۦ عُقۡدَةُ ٱلنِّكَاحِۚ

743
01:56:55,888 --> 01:57:02,820
وَأَن تَعۡفُوٓاْ أَقۡرَبُ لِلتَّقۡوَىٰۚ

744
01:57:02,821 --> 01:57:07,680
وَلَا تَنسَوُاْ ٱلۡفَضۡلَ بَيۡنَكُمۡۚ

745
01:57:07,681 --> 01:57:13,547
إِنَّ ٱللَّهَ بِمَا تَعۡمَلُونَ بَصِيرٌ ٢٣٧

746
01:57:13,548 --> 01:57:23,040
حَٰفِظُواْ عَلَى ٱلصَّلَوَٰتِ وَٱلصَّلَوٰةِ ٱلۡوُسۡطَىٰ وَقُومُواْ لِلَّهِ قَٰنِتِينَ ٢٣٨

747
01:57:23,041 --> 01:57:28,107
فَإِنۡ خِفۡتُمۡ فَرِجَالًا أَوۡ رُكۡبَانٗاۖ

748
01:57:28,108 --> 01:57:35,860
فَإِذَآ أَمِنتُمۡ فَٱذۡكُرُواْ ٱللَّهَ كَمَا عَلَّمَكُم

749
01:57:35,861 --> 01:57:45,060
فَٱذۡكُرُواْ ٱللَّهَ كَمَا عَلَّمَكُم مَّا لَمۡ تَكُونُواْ تَعۡلَمُونَ ٢٣٩

750
01:57:45,061 --> 01:57:58,273
وَٱلَّذِينَ يُتَوَفَّوۡنَ مِنكُمۡ وَيَذَرُونَ أَزۡوَٰجٗا وَصِيَّةٗ لِّأَزۡوَٰجِهِم مَّتَٰعًا إِلَى ٱلۡحَوۡلِ

751
01:57:58,274 --> 01:58:03,533
مَّتَٰعًا إِلَى ٱلۡحَوۡلِ غَيۡرَ إِخۡرَاجٖۚ

752
01:58:03,534 --> 01:58:16,040
فَإِنۡ خَرَجۡنَ فَلَا جُنَاحَ عَلَيۡكُمۡ فِي مَا فَعَلۡنَ فِيٓ أَنفُسِهِنَّ مِن مَّعۡرُوفٖۗ

753
01:58:16,041 --> 01:58:21,613
وَٱللَّهُ عَزِيزٌ حَكِيمٞ ٢٤٠

754
01:58:21,614 --> 01:58:30,453
وَلِلۡمُطَلَّقَٰتِ مَتَٰعُۢ بِٱلۡمَعۡرُوفِۖ حَقًّا عَلَى ٱلۡمُتَّقِينَ ٢٤١

755
01:58:30,454 --> 01:58:41,080
كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ لَكُمۡ ءَايَٰتِهِۦ لَعَلَّكُمۡ تَعۡقِلُونَ ٢٤٢

756
01:58:41,081 --> 01:58:52,900
أَلَمۡ تَرَ إِلَى ٱلَّذِينَ خَرَجُواْ مِن دِيَٰرِهِمۡ وَهُمۡ أُلُوفٌ حَذَرَ ٱلۡمَوۡتِ فَقَالَ لَهُمُ ٱللَّهُ مُوتُواْ

757
01:58:52,901 --> 01:58:59,540
فَقَالَ لَهُمُ ٱللَّهُ مُوتُواْ ثُمَّ أَحۡيَٰهُمۡۚ

758
01:58:59,541 --> 01:59:06,573
إِنَّ ٱللَّهَ لَذُو فَضۡلٍ عَلَى ٱلنَّاسِ

759
01:59:06,574 --> 01:59:13,980
وَلَٰكِنَّ أَكۡثَرَ ٱلنَّاسِ لَا يَشۡكُرُونَ ٢٤٣

760
01:59:13,981 --> 01:59:24,747
وَقَٰتِلُواْ فِي سَبِيلِ ٱللَّهِ وَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ سَمِيعٌ عَلِيمٞ ٢٤٤

761
01:59:24,748 --> 01:59:33,520
مَّن ذَا ٱلَّذِي يُقۡرِضُ ٱللَّهَ قَرۡضًا حَسَنٗا فَيُضَٰعِفَهُۥ لَهُۥٓ

762
01:59:33,521 --> 01:59:40,773
فَيُضَٰعِفَهُۥ لَهُۥٓ أَضۡعَافٗا كَثِيرَةٗۚ

763
01:59:40,774 --> 01:59:49,060
وَٱللَّهُ يَقۡبِضُ وَيَبۡصُۜطُ وَإِلَيۡهِ تُرۡجَعُونَ ٢٤٥

764
01:59:49,061 --> 02:00:02,327
أَلَمۡ تَرَ إِلَى ٱلۡمَلَإِ مِنۢ بَنِيٓ إِسۡرَـٰٓءِيلَ مِنۢ بَعۡدِ مُوسَىٰٓ إِذۡ قَالُواْ

765
02:00:02,328 --> 02:00:12,227
إِذۡ قَالُواْ لِنَبِيّٖ لَّهُمُ ٱبۡعَثۡ لَنَا مَلِكٗا نُّقَٰتِلۡ فِي سَبِيلِ ٱللَّهِۖ

766
02:00:12,228 --> 02:00:20,893
قَالَ هَلۡ عَسَيۡتُمۡ إِن كُتِبَ عَلَيۡكُمُ ٱلۡقِتَالُ أَلَّا تُقَٰتِلُواْۖ

767
02:00:20,894 --> 02:00:34,353
قَالُواْ وَمَا لَنَآ أَلَّا نُقَٰتِلَ فِي سَبِيلِ ٱللَّهِ وَقَدۡ أُخۡرِجۡنَا مِن دِيَٰرِنَا وَأَبۡنَآئِنَاۖ

768
02:00:34,354 --> 02:00:43,640
فَلَمَّا كُتِبَ عَلَيۡهِمُ ٱلۡقِتَالُ تَوَلَّوۡاْ إِلَّا قَلِيلٗا مِّنۡهُمۡۚ

769
02:00:43,641 --> 02:00:50,253
وَٱللَّهُ عَلِيمُۢ بِٱلظَّـٰلِمِينَ ٢٤٦

770
02:00:50,254 --> 02:00:59,207
وَقَالَ لَهُمۡ نَبِيُّهُمۡ إِنَّ ٱللَّهَ قَدۡ بَعَثَ لَكُمۡ طَالُوتَ مَلِكٗاۚ

771
02:00:59,208 --> 02:01:12,447
قَالُوٓاْ أَنَّىٰ يَكُونُ لَهُ ٱلۡمُلۡكُ عَلَيۡنَا وَنَحۡنُ أَحَقُّ بِٱلۡمُلۡكِ مِنۡهُ وَلَمۡ يُؤۡتَ سَعَةٗ مِّنَ ٱلۡمَالِۚ

772
02:01:12,448 --> 02:01:21,833
قَالَ إِنَّ ٱللَّهَ ٱصۡطَفَىٰهُ عَلَيۡكُمۡ وَزَادَهُۥ بَسۡطَةٗ فِي ٱلۡعِلۡمِ وَٱلۡجِسۡمِۖ

773
02:01:21,834 --> 02:01:29,460
وَٱللَّهُ يُؤۡتِي مُلۡكَهُۥ مَن يَشَآءُۚ

774
02:01:29,461 --> 02:01:35,120
وَٱللَّهُ وَٰسِعٌ عَلِيمٞ ٢٤٧

775
02:01:35,121 --> 02:01:48,420
وَقَالَ لَهُمۡ نَبِيُّهُمۡ إِنَّ ءَايَةَ مُلۡكِهِۦٓ أَن يَأۡتِيَكُمُ ٱلتَّابُوتُ فِيهِ سَكِينَةٞ مِّن رَّبِّكُمۡ

776
02:01:48,421 --> 02:02:02,573
فِيهِ سَكِينَةٞ مِّن رَّبِّكُمۡ وَبَقِيَّةٞ مِّمَّا تَرَكَ ءَالُ مُوسَىٰ وَءَالُ هَٰرُونَ تَحۡمِلُهُ ٱلۡمَلَـٰٓئِكَةُۚ

777
02:02:02,574 --> 02:02:12,853
إِنَّ فِي ذَٰلِكَ لَأٓيَةٗ لَّكُمۡ إِن كُنتُم مُّؤۡمِنِينَ ٢٤٨

778
02:02:12,854 --> 02:02:23,240
فَلَمَّا فَصَلَ طَالُوتُ بِٱلۡجُنُودِ قَالَ إِنَّ ٱللَّهَ مُبۡتَلِيكُم بِنَهَرٖ

779
02:02:23,241 --> 02:02:34,553
فَمَن شَرِبَ مِنۡهُ فَلَيۡسَ مِنِّي وَمَن لَّمۡ يَطۡعَمۡهُ فَإِنَّهُۥ مِنِّيٓ

780
02:02:34,554 --> 02:02:44,347
وَمَن لَّمۡ يَطۡعَمۡهُ فَإِنَّهُۥ مِنِّيٓ إِلَّا مَنِ ٱغۡتَرَفَ غُرۡفَةَۢ بِيَدِهِۦۚ

781
02:02:44,348 --> 02:02:49,747
فَشَرِبُواْ مِنۡهُ إِلَّا قَلِيلٗا مِّنۡهُمۡۚ

782
02:02:49,748 --> 02:02:57,907
فَلَمَّا جَاوَزَهُۥ هُوَ وَٱلَّذِينَ ءَامَنُواْ مَعَهُۥ قَالُواْ

783
02:02:57,908 --> 02:03:03,827
قَالُواْ لَا طَاقَةَ لَنَا ٱلۡيَوۡمَ بِجَالُوتَ وَجُنُودِهِۦۚ

784
02:03:03,828 --> 02:03:13,967
قَالَ ٱلَّذِينَ يَظُنُّونَ أَنَّهُم مُّلَٰقُواْ ٱللَّهِ كَم مِّن فِئَةٖ قَلِيلَةٍ

785
02:03:13,968 --> 02:03:24,267
كَم مِّن فِئَةٖ قَلِيلَةٍ غَلَبَتۡ فِئَةٗ كَثِيرَةَۢ بِإِذۡنِ ٱللَّهِۗ

786
02:03:24,268 --> 02:03:29,127
وَٱللَّهُ مَعَ ٱلصَّـٰبِرِينَ ٢٤٩

787
02:03:29,128 --> 02:03:36,293
وَلَمَّا بَرَزُواْ لِجَالُوتَ وَجُنُودِهِۦ قَالُواْ

788
02:03:36,294 --> 02:03:46,553
قَالُواْ رَبَّنَآ أَفۡرِغۡ عَلَيۡنَا صَبۡرٗا وَثَبِّتۡ أَقۡدَامَنَا

789
02:03:46,554 --> 02:03:55,673
وَثَبِّتۡ أَقۡدَامَنَا وَٱنصُرۡنَا عَلَى ٱلۡقَوۡمِ ٱلۡكَٰفِرِينَ ٢٥٠

790
02:03:55,674 --> 02:04:01,513
فَهَزَمُوهُم بِإِذۡنِ ٱللَّهِ

791
02:04:01,514 --> 02:04:14,833
وَقَتَلَ دَاوُۥدُ جَالُوتَ وَءَاتَىٰهُ ٱللَّهُ ٱلۡمُلۡكَ وَٱلۡحِكۡمَةَ وَعَلَّمَهُۥ مِمَّا يَشَآءُۗ

792
02:04:14,834 --> 02:04:23,580
وَلَوۡلَا دَفۡعُ ٱللَّهِ ٱلنَّاسَ بَعۡضَهُم بِبَعۡضٖ لَّفَسَدَتِ ٱلۡأَرۡضُ

793
02:04:23,581 --> 02:04:30,333
وَلَٰكِنَّ ٱللَّهَ ذُو فَضۡلٍ عَلَى ٱلۡعَٰلَمِينَ ٢٥١

794
02:04:30,334 --> 02:04:36,633
تِلۡكَ ءَايَٰتُ ٱللَّهِ نَتۡلُوهَا عَلَيۡكَ بِٱلۡحَقِّۚ

795
02:04:36,634 --> 02:04:43,640
وَإِنَّكَ لَمِنَ ٱلۡمُرۡسَلِينَ ٢٥٢

796
02:04:43,641 --> 02:04:48,227
تِلۡكَ ٱلرُّسُلُ فَضَّلۡنَا بَعۡضَهُمۡ عَلَىٰ بَعۡضٖۘ

797
02:04:48,228 --> 02:04:56,760
مِّنۡهُم مَّن كَلَّمَ ٱللَّهُۖ وَرَفَعَ بَعۡضَهُمۡ دَرَجَٰتٖۚ

798
02:04:56,761 --> 02:05:04,327
وَءَاتَيۡنَا عِيسَى ٱبۡنَ مَرۡيَمَ ٱلۡبَيِّنَٰتِ وَأَيَّدۡنَٰهُ بِرُوحِ ٱلۡقُدُسِۗ

799
02:05:04,328 --> 02:05:12,467
وَلَوۡ شَآءَ ٱللَّهُ مَا ٱقۡتَتَلَ ٱلَّذِينَ مِنۢ بَعۡدِهِم

800
02:05:12,468 --> 02:05:23,047
مِنۢ بَعۡدِهِم مِّنۢ بَعۡدِ مَا جَآءَتۡهُمُ ٱلۡبَيِّنَٰتُ وَلَٰكِنِ ٱخۡتَلَفُواْ

801
02:05:23,048 --> 02:05:31,067
وَلَٰكِنِ ٱخۡتَلَفُواْ فَمِنۡهُم مَّنۡ ءَامَنَ وَمِنۡهُم مَّن كَفَرَۚ

802
02:05:31,068 --> 02:05:36,720
وَلَوۡ شَآءَ ٱللَّهُ مَا ٱقۡتَتَلُواْ

803
02:05:36,721 --> 02:05:42,600
وَلَٰكِنَّ ٱللَّهَ يَفۡعَلُ مَا يُرِيدُ ٢٥٣

804
02:05:42,601 --> 02:05:52,993
يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ أَنفِقُواْ

805
02:05:52,994 --> 02:06:04,400
أَنفِقُواْ مِمَّا رَزَقۡنَٰكُم مِّن قَبۡلِ أَن يَأۡتِيَ يَوۡمٞ

806
02:06:04,401 --> 02:06:15,833
مِّن قَبۡلِ أَن يَأۡتِيَ يَوۡمٞ لَّا بَيۡعٞ فِيهِ وَلَا خُلَّةٞ وَلَا شَفَٰعَةٞۗ

807
02:06:15,834 --> 02:06:21,033
وَٱلۡكَٰفِرُونَ هُمُ ٱلظَّـٰلِمُونَ ٢٥٤

808
02:06:21,034 --> 02:06:31,400
ٱللَّهُ لَآ إِلَٰهَ إِلَّا هُوَ ٱلۡحَيُّ ٱلۡقَيُّومُۚ

809
02:06:31,401 --> 02:06:39,487
لَا تَأۡخُذُهُۥ سِنَةٞ وَلَا نَوۡمٞۚ

810
02:06:39,488 --> 02:06:44,253
لَّهُۥ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِۗ

811
02:06:44,254 --> 02:06:53,980
مَن ذَا ٱلَّذِي يَشۡفَعُ عِندَهُۥٓ إِلَّا بِإِذۡنِهِۦۚ

812
02:06:53,981 --> 02:06:59,747
يَعۡلَمُ مَا بَيۡنَ أَيۡدِيهِمۡ وَمَا خَلۡفَهُمۡۖ

813
02:06:59,748 --> 02:07:09,973
وَلَا يُحِيطُونَ بِشَيۡءٖ مِّنۡ عِلۡمِهِۦٓ إِلَّا بِمَا شَآءَۚ

814
02:07:09,974 --> 02:07:14,707
وَسِعَ كُرۡسِيُّهُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضَۖ

815
02:07:14,708 --> 02:07:24,753
وَلَا يَـُٔودُهُۥ حِفۡظُهُمَاۚ وَهُوَ ٱلۡعَلِيُّ ٱلۡعَظِيمُ ٢٥٥

816
02:07:24,754 --> 02:07:31,867
لَآ إِكۡرَاهَ فِي ٱلدِّينِۖ

817
02:07:31,868 --> 02:07:36,040
قَد تَّبَيَّنَ ٱلرُّشۡدُ مِنَ ٱلۡغَيِّۚ

818
02:07:36,041 --> 02:07:48,927
فَمَن يَكۡفُرۡ بِٱلطَّـٰغُوتِ وَيُؤۡمِنۢ بِٱللَّهِ فَقَدِ ٱسۡتَمۡسَكَ بِٱلۡعُرۡوَةِ ٱلۡوُثۡقَىٰ

819
02:07:48,928 --> 02:07:57,993
فَقَدِ ٱسۡتَمۡسَكَ بِٱلۡعُرۡوَةِ ٱلۡوُثۡقَىٰ لَا ٱنفِصَامَ لَهَاۗ

820
02:07:57,994 --> 02:08:04,993
وَٱللَّهُ سَمِيعٌ عَلِيمٌ ٢٥٦

821
02:08:04,994 --> 02:08:09,693
ٱللَّهُ وَلِيُّ ٱلَّذِينَ ءَامَنُواْ

822
02:08:09,694 --> 02:08:17,693
يُخۡرِجُهُم مِّنَ ٱلظُّلُمَٰتِ إِلَى ٱلنُّورِۖ

823
02:08:17,694 --> 02:08:28,913
وَٱلَّذِينَ كَفَرُوٓاْ أَوۡلِيَآؤُهُمُ ٱلطَّـٰغُوتُ يُخۡرِجُونَهُم

824
02:08:28,914 --> 02:08:37,853
يُخۡرِجُونَهُم مِّنَ ٱلنُّورِ إِلَى ٱلظُّلُمَٰتِۗ

825
02:08:37,854 --> 02:08:49,293
أُوْلَـٰٓئِكَ أَصۡحَٰبُ ٱلنَّارِۖ هُمۡ فِيهَا خَٰلِدُونَ ٢٥٧

826
02:08:49,294 --> 02:09:02,667
أَلَمۡ تَرَ إِلَى ٱلَّذِي حَآجَّ إِبۡرَٰهِـۧمَ فِي رَبِّهِۦٓ أَنۡ ءَاتَىٰهُ ٱللَّهُ ٱلۡمُلۡكَ

827
02:09:02,668 --> 02:09:10,300
إِذۡ قَالَ إِبۡرَٰهِـۧمُ رَبِّيَ ٱلَّذِي يُحۡيِۦ وَيُمِيتُ

828
02:09:10,301 --> 02:09:15,920
قَالَ أَنَا۠ أُحۡيِۦ وَأُمِيتُۖ

829
02:09:15,921 --> 02:09:29,567
قَالَ إِبۡرَٰهِـۧمُ فَإِنَّ ٱللَّهَ يَأۡتِي بِٱلشَّمۡسِ مِنَ ٱلۡمَشۡرِقِ فَأۡتِ بِهَا مِنَ ٱلۡمَغۡرِبِ فَبُهِتَ ٱلَّذِي كَفَرَۗ

830
02:09:29,568 --> 02:09:35,653
وَٱللَّهُ لَا يَهۡدِي ٱلۡقَوۡمَ ٱلظَّـٰلِمِينَ ٢٥٨

831
02:09:35,654 --> 02:09:45,607
أَوۡ كَٱلَّذِي مَرَّ عَلَىٰ قَرۡيَةٖ وَهِيَ خَاوِيَةٌ عَلَىٰ عُرُوشِهَا

832
02:09:45,608 --> 02:09:58,600
قَالَ أَنَّىٰ يُحۡيِۦ هَٰذِهِ ٱللَّهُ بَعۡدَ مَوۡتِهَاۖ فَأَمَاتَهُ ٱللَّهُ مِاْئَةَ عَامٖ ثُمَّ بَعَثَهُۥۖ

833
02:09:58,601 --> 02:10:00,573
قَالَ كَمۡ لَبِثۡتَۖ

834
02:10:00,574 --> 02:10:07,140
قَالَ لَبِثۡتُ يَوۡمًا أَوۡ بَعۡضَ يَوۡمٖۖ

835
02:10:07,141 --> 02:10:16,973
قَالَ بَل لَّبِثۡتَ مِاْئَةَ عَامٖ فَٱنظُرۡ إِلَىٰ طَعَامِكَ وَشَرَابِكَ

836
02:10:16,974 --> 02:10:24,900
فَٱنظُرۡ إِلَىٰ طَعَامِكَ وَشَرَابِكَ لَمۡ يَتَسَنَّهۡۖ

837
02:10:24,901 --> 02:10:34,560
وَٱنظُرۡ إِلَىٰ حِمَارِكَ وَلِنَجۡعَلَكَ ءَايَةٗ لِّلنَّاسِۖ

838
02:10:34,561 --> 02:10:44,647
وَٱنظُرۡ إِلَى ٱلۡعِظَامِ كَيۡفَ نُنشِزُهَا ثُمَّ نَكۡسُوهَا لَحۡمٗاۚ

839
02:10:44,648 --> 02:10:57,280
فَلَمَّا تَبَيَّنَ لَهُۥ قَالَ أَعۡلَمُ أَنَّ ٱللَّهَ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٞ ٢٥٩

840
02:10:57,281 --> 02:11:04,860
وَإِذۡ قَالَ إِبۡرَٰهِـۧمُ رَبِّ أَرِنِي كَيۡفَ تُحۡيِ ٱلۡمَوۡتَىٰۖ

841
02:11:04,861 --> 02:11:07,747
قَالَ أَوَلَمۡ تُؤۡمِنۖ

842
02:11:07,748 --> 02:11:15,060
قَالَ بَلَىٰ وَلَٰكِن لِّيَطۡمَئِنَّ قَلۡبِيۖ

843
02:11:15,061 --> 02:11:23,380
قَالَ فَخُذۡ أَرۡبَعَةٗ مِّنَ ٱلطَّيۡرِ فَصُرۡهُنَّ إِلَيۡكَ

844
02:11:23,381 --> 02:11:34,827
فَصُرۡهُنَّ إِلَيۡكَ ثُمَّ ٱجۡعَلۡ عَلَىٰ كُلِّ جَبَلٖ مِّنۡهُنَّ جُزۡءٗا

845
02:11:34,828 --> 02:11:40,393
ثُمَّ ٱدۡعُهُنَّ يَأۡتِينَكَ سَعۡيٗاۚ

846
02:11:40,394 --> 02:11:48,407
وَٱعۡلَمۡ أَنَّ ٱللَّهَ عَزِيزٌ حَكِيمٞ ٢٦٠

847
02:11:48,408 --> 02:11:57,687
مَّثَلُ ٱلَّذِينَ يُنفِقُونَ أَمۡوَٰلَهُمۡ فِي سَبِيلِ ٱللَّهِ كَمَثَلِ حَبَّةٍ

848
02:11:57,688 --> 02:12:09,073
كَمَثَلِ حَبَّةٍ أَنۢبَتَتۡ سَبۡعَ سَنَابِلَ فِي كُلِّ سُنۢبُلَةٖ مِّاْئَةُ حَبَّةٖۗ

849
02:12:09,074 --> 02:12:16,660
وَٱللَّهُ يُضَٰعِفُ لِمَن يَشَآءُۚ

850
02:12:16,661 --> 02:12:22,033
وَٱللَّهُ وَٰسِعٌ عَلِيمٌ ٢٦١

851
02:12:22,034 --> 02:12:35,067
ٱلَّذِينَ يُنفِقُونَ أَمۡوَٰلَهُمۡ فِي سَبِيلِ ٱللَّهِ ثُمَّ لَا يُتۡبِعُونَ مَآ أَنفَقُواْ

852
02:12:35,068 --> 02:12:47,480
ثُمَّ لَا يُتۡبِعُونَ مَآ أَنفَقُواْ مَنّٗا وَلَآ أَذٗى لَّهُمۡ أَجۡرُهُمۡ

853
02:12:47,481 --> 02:12:57,973
لَّهُمۡ أَجۡرُهُمۡ عِندَ رَبِّهِمۡ وَلَا خَوۡفٌ عَلَيۡهِمۡ وَلَا هُمۡ يَحۡزَنُونَ ٢٦٢

854
02:12:57,974 --> 02:13:11,147
قَوۡلٞ مَّعۡرُوفٞ وَمَغۡفِرَةٌ خَيۡرٞ مِّن صَدَقَةٖ يَتۡبَعُهَآ أَذٗىۗ

855
02:13:11,148 --> 02:13:15,840
وَٱللَّهُ غَنِيٌّ حَلِيمٞ ٢٦٣

856
02:13:15,841 --> 02:13:27,960
يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ لَا تُبۡطِلُواْ صَدَقَٰتِكُم بِٱلۡمَنِّ وَٱلۡأَذَىٰ

857
02:13:27,961 --> 02:13:37,780
لَا تُبۡطِلُواْ صَدَقَٰتِكُم بِٱلۡمَنِّ وَٱلۡأَذَىٰ كَٱلَّذِي يُنفِقُ مَالَهُۥ

858
02:13:37,781 --> 02:13:50,387
كَٱلَّذِي يُنفِقُ مَالَهُۥ رِئَآءَ ٱلنَّاسِ وَلَا يُؤۡمِنُ بِٱللَّهِ وَٱلۡيَوۡمِ ٱلۡأٓخِرِۖ

859
02:13:50,388 --> 02:14:03,453
فَمَثَلُهُۥ كَمَثَلِ صَفۡوَانٍ عَلَيۡهِ تُرَابٞ فَأَصَابَهُۥ وَابِلٞ فَتَرَكَهُۥ صَلۡدٗاۖ

860
02:14:03,454 --> 02:14:11,120
لَّا يَقۡدِرُونَ عَلَىٰ شَيۡءٖ مِّمَّا كَسَبُواْۗ

861
02:14:11,121 --> 02:14:17,613
وَٱللَّهُ لَا يَهۡدِي ٱلۡقَوۡمَ ٱلۡكَٰفِرِينَ ٢٦٤

862
02:14:17,614 --> 02:14:32,440
وَمَثَلُ ٱلَّذِينَ يُنفِقُونَ أَمۡوَٰلَهُمُ ٱبۡتِغَآءَ مَرۡضَاتِ ٱللَّهِ وَتَثۡبِيتٗا مِّنۡ أَنفُسِهِمۡ

863
02:14:32,441 --> 02:14:48,860
وَتَثۡبِيتٗا مِّنۡ أَنفُسِهِمۡ كَمَثَلِ جَنَّةِۭ بِرَبۡوَةٍ أَصَابَهَا وَابِلٞ فَـَٔاتَتۡ أُكُلَهَا ضِعۡفَيۡنِ

864
02:14:48,861 --> 02:14:57,353
فَـَٔاتَتۡ أُكُلَهَا ضِعۡفَيۡنِ فَإِن لَّمۡ يُصِبۡهَا وَابِلٞ فَطَلّٞۗ

865
02:14:57,354 --> 02:15:02,733
وَٱللَّهُ بِمَا تَعۡمَلُونَ بَصِيرٌ ٢٦٥

866
02:15:02,734 --> 02:15:18,393
أَيَوَدُّ أَحَدُكُمۡ أَن تَكُونَ لَهُۥ جَنَّةٞ مِّن نَّخِيلٖ وَأَعۡنَابٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ

867
02:15:18,394 --> 02:15:36,560
وَأَعۡنَابٖ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُ لَهُۥ فِيهَا مِن كُلِّ ٱلثَّمَرَٰتِ وَأَصَابَهُ ٱلۡكِبَرُ وَلَهُۥ ذُرِّيَّةٞ ضُعَفَآءُ

868
02:15:36,561 --> 02:15:45,300
فَأَصَابَهَآ إِعۡصَارٞ فِيهِ نَارٞ فَٱحۡتَرَقَتۡۗ

869
02:15:45,301 --> 02:15:55,640
كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ لَكُمُ ٱلۡأٓيَٰتِ لَعَلَّكُمۡ تَتَفَكَّرُونَ ٢٦٦

870
02:15:55,641 --> 02:16:07,180
يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ أَنفِقُواْ مِن طَيِّبَٰتِ مَا كَسَبۡتُمۡ

871
02:16:07,181 --> 02:16:19,180
أَنفِقُواْ مِن طَيِّبَٰتِ مَا كَسَبۡتُمۡ وَمِمَّآ أَخۡرَجۡنَا لَكُم مِّنَ ٱلۡأَرۡضِۖ

872
02:16:19,181 --> 02:16:29,040
وَلَا تَيَمَّمُواْ ٱلۡخَبِيثَ مِنۡهُ تُنفِقُونَ وَلَسۡتُم بِـَٔاخِذِيهِ

873
02:16:29,041 --> 02:16:38,147
وَلَسۡتُم بِـَٔاخِذِيهِ إِلَّآ أَن تُغۡمِضُواْ فِيهِۚ

874
02:16:38,148 --> 02:16:45,040
وَٱعۡلَمُوٓاْ أَنَّ ٱللَّهَ غَنِيٌّ حَمِيدٌ ٢٦٧

875
02:16:45,041 --> 02:16:56,240
ٱلشَّيۡطَٰنُ يَعِدُكُمُ ٱلۡفَقۡرَ وَيَأۡمُرُكُم بِٱلۡفَحۡشَآءِۖ

876
02:16:56,241 --> 02:17:03,993
وَٱللَّهُ يَعِدُكُم مَّغۡفِرَةٗ مِّنۡهُ وَفَضۡلٗاۗ

877
02:17:03,994 --> 02:17:09,967
وَٱللَّهُ وَٰسِعٌ عَلِيمٞ ٢٦٨

878
02:17:09,968 --> 02:17:17,213
يُؤۡتِي ٱلۡحِكۡمَةَ مَن يَشَآءُۚ

879
02:17:17,214 --> 02:17:26,453
وَمَن يُؤۡتَ ٱلۡحِكۡمَةَ فَقَدۡ أُوتِيَ خَيۡرٗا كَثِيرٗاۗ

880
02:17:26,454 --> 02:17:34,407
وَمَا يَذَّكَّرُ إِلَّآ أُوْلُواْ ٱلۡأَلۡبَٰبِ ٢٦٩

881
02:17:34,408 --> 02:17:47,113
وَمَآ أَنفَقۡتُم مِّن نَّفَقَةٍ أَوۡ نَذَرۡتُم مِّن نَّذۡرٖ فَإِنَّ ٱللَّهَ يَعۡلَمُهُۥۗ

882
02:17:47,114 --> 02:17:53,540
وَمَا لِلظَّـٰلِمِينَ مِنۡ أَنصَارٍ ٢٧٠

883
02:17:53,541 --> 02:18:00,060
إِن تُبۡدُواْ ٱلصَّدَقَٰتِ فَنِعِمَّا هِيَۖ

884
02:18:00,061 --> 02:18:10,120
وَإِن تُخۡفُوهَا وَتُؤۡتُوهَا ٱلۡفُقَرَآءَ فَهُوَ خَيۡرٞ لَّكُمۡۚ

885
02:18:10,121 --> 02:18:16,993
وَيُكَفِّرُ عَنكُم مِّن سَيِّـَٔاتِكُمۡۗ

886
02:18:16,994 --> 02:18:22,593
وَٱللَّهُ بِمَا تَعۡمَلُونَ خَبِيرٞ ٢٧١

887
02:18:22,594 --> 02:18:32,387
لَّيۡسَ عَلَيۡكَ هُدَىٰهُمۡ وَلَٰكِنَّ ٱللَّهَ يَهۡدِي مَن يَشَآءُۗ

888
02:18:32,388 --> 02:18:40,900
وَمَا تُنفِقُواْ مِنۡ خَيۡرٖ فَلِأَنفُسِكُمۡۚ

889
02:18:40,901 --> 02:18:51,087
وَمَا تُنفِقُونَ إِلَّا ٱبۡتِغَآءَ وَجۡهِ ٱللَّهِۚ

890
02:18:51,088 --> 02:19:02,380
وَمَا تُنفِقُواْ مِنۡ خَيۡرٖ يُوَفَّ إِلَيۡكُمۡ وَأَنتُمۡ لَا تُظۡلَمُونَ ٢٧٢

891
02:19:02,381 --> 02:19:16,447
لِلۡفُقَرَآءِ ٱلَّذِينَ أُحۡصِرُواْ فِي سَبِيلِ ٱللَّهِ لَا يَسۡتَطِيعُونَ ضَرۡبٗا فِي ٱلۡأَرۡضِ يَحۡسَبُهُمُ ٱلۡجَاهِلُ

892
02:19:16,448 --> 02:19:27,440
يَحۡسَبُهُمُ ٱلۡجَاهِلُ أَغۡنِيَآءَ مِنَ ٱلتَّعَفُّفِ تَعۡرِفُهُم بِسِيمَٰهُمۡ

893
02:19:27,441 --> 02:19:33,460
لَا يَسۡـَٔلُونَ ٱلنَّاسَ إِلۡحَافٗاۗ

894
02:19:33,461 --> 02:19:44,453
وَمَا تُنفِقُواْ مِنۡ خَيۡرٖ فَإِنَّ ٱللَّهَ بِهِۦ عَلِيمٌ ٢٧٣

895
02:19:44,454 --> 02:19:55,680
ٱلَّذِينَ يُنفِقُونَ أَمۡوَٰلَهُم بِٱلَّيۡلِ وَٱلنَّهَارِ سِرّٗا وَعَلَانِيَةٗ

896
02:19:55,681 --> 02:20:04,900
سِرّٗا وَعَلَانِيَةٗ فَلَهُمۡ أَجۡرُهُمۡ عِندَ رَبِّهِمۡ

897
02:20:04,901 --> 02:20:12,720
وَلَا خَوۡفٌ عَلَيۡهِمۡ وَلَا هُمۡ يَحۡزَنُونَ ٢٧٤

898
02:20:12,721 --> 02:20:24,580
ٱلَّذِينَ يَأۡكُلُونَ ٱلرِّبَوٰاْ لَا يَقُومُونَ إِلَّا كَمَا يَقُومُ ٱلَّذِي يَتَخَبَّطُهُ ٱلشَّيۡطَٰنُ مِنَ ٱلۡمَسِّۚ

899
02:20:24,581 --> 02:20:34,193
ذَٰلِكَ بِأَنَّهُمۡ قَالُوٓاْ إِنَّمَا ٱلۡبَيۡعُ مِثۡلُ ٱلرِّبَوٰاْۗ

900
02:20:34,194 --> 02:20:38,887
وَأَحَلَّ ٱللَّهُ ٱلۡبَيۡعَ وَحَرَّمَ ٱلرِّبَوٰاْۚ

901
02:20:38,888 --> 02:20:50,560
فَمَن جَآءَهُۥ مَوۡعِظَةٞ مِّن رَّبِّهِۦ فَٱنتَهَىٰ فَلَهُۥ مَا سَلَفَ

902
02:20:50,800 --> 02:20:58,773
فَلَهُۥ مَا سَلَفَ وَأَمۡرُهُۥٓ إِلَى ٱللَّهِۖ

903
02:20:58,774 --> 02:21:09,253
وَمَنۡ عَادَ فَأُوْلَـٰٓئِكَ أَصۡحَٰبُ ٱلنَّارِۖ هُمۡ فِيهَا خَٰلِدُونَ ٢٧٥

904
02:21:09,254 --> 02:21:15,013
يَمۡحَقُ ٱللَّهُ ٱلرِّبَوٰاْ وَيُرۡبِي ٱلصَّدَقَٰتِۗ

905
02:21:15,014 --> 02:21:22,987
وَٱللَّهُ لَا يُحِبُّ كُلَّ كَفَّارٍ أَثِيمٍ ٢٧٦

906
02:21:22,988 --> 02:21:31,900
إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّـٰلِحَٰتِ وَأَقَامُواْ ٱلصَّلَوٰةَ

907
02:21:31,901 --> 02:21:43,213
وَأَقَامُواْ ٱلصَّلَوٰةَ وَءَاتَوُاْ ٱلزَّكَوٰةَ لَهُمۡ أَجۡرُهُمۡ عِندَ رَبِّهِمۡ وَلَا خَوۡفٌ عَلَيۡهِمۡ

908
02:21:43,214 --> 02:21:50,907
وَلَا خَوۡفٌ عَلَيۡهِمۡ وَلَا هُمۡ يَحۡزَنُونَ ٢٧٧

909
02:21:50,908 --> 02:22:00,727
يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُواْ ٱتَّقُواْ ٱللَّهَ وَذَرُواْ مَا بَقِيَ مِنَ ٱلرِّبَوٰٓاْ

910
02:22:00,728 --> 02:22:11,493
وَذَرُواْ مَا بَقِيَ مِنَ ٱلرِّبَوٰٓاْ إِن كُنتُم مُّؤۡمِنِينَ ٢٧٨

911
02:22:11,494 --> 02:22:18,933
فَإِن لَّمۡ تَفۡعَلُواْ فَأۡذَنُواْ بِحَرۡبٖ مِّنَ ٱللَّهِ وَرَسُولِهِۦۖ

912
02:22:18,934 --> 02:22:29,680
وَإِن تُبۡتُمۡ فَلَكُمۡ رُءُوسُ أَمۡوَٰلِكُمۡ لَا تَظۡلِمُونَ وَلَا تُظۡلَمُونَ ٢٧٩

913
02:22:29,681 --> 02:22:37,453
وَإِن كَانَ ذُو عُسۡرَةٖ فَنَظِرَةٌ إِلَىٰ مَيۡسَرَةٖۚ

914
02:22:37,454 --> 02:22:47,073
وَأَن تَصَدَّقُواْ خَيۡرٞ لَّكُمۡ إِن كُنتُمۡ تَعۡلَمُونَ ٢٨٠

915
02:22:47,074 --> 02:22:56,407
وَٱتَّقُواْ يَوۡمٗا تُرۡجَعُونَ فِيهِ إِلَى ٱللَّهِۖ

916
02:22:56,408 --> 02:23:06,613
ثُمَّ تُوَفَّىٰ كُلُّ نَفۡسٖ مَّا كَسَبَتۡ وَهُمۡ لَا يُظۡلَمُونَ ٢٨١

917
02:23:06,614 --> 02:23:23,360
يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ إِذَا تَدَايَنتُم بِدَيۡنٍ إِلَىٰٓ أَجَلٖ مُّسَمّٗى فَٱكۡتُبُوهُۚ

918
02:23:23,361 --> 02:23:28,767
وَلۡيَكۡتُب بَّيۡنَكُمۡ كَاتِبُۢ بِٱلۡعَدۡلِۚ

919
02:23:28,768 --> 02:23:38,020
وَلَا يَأۡبَ كَاتِبٌ أَن يَكۡتُبَ كَمَا عَلَّمَهُ ٱللَّهُۚ

920
02:23:38,021 --> 02:23:49,187
فَلۡيَكۡتُبۡ وَلۡيُمۡلِلِ ٱلَّذِي عَلَيۡهِ ٱلۡحَقُّ وَلۡيَتَّقِ ٱللَّهَ رَبَّهُۥ وَلَا يَبۡخَسۡ مِنۡهُ شَيۡـٔٗاۚ

921
02:23:49,188 --> 02:24:03,340
فَإِن كَانَ ٱلَّذِي عَلَيۡهِ ٱلۡحَقُّ سَفِيهًا أَوۡ ضَعِيفًا أَوۡ لَا يَسۡتَطِيعُ أَن يُمِلَّ هُوَ فَلۡيُمۡلِلۡ وَلِيُّهُۥ بِٱلۡعَدۡلِۚ

922
02:24:03,341 --> 02:24:08,867
وَٱسۡتَشۡهِدُواْ شَهِيدَيۡنِ مِن رِّجَالِكُمۡۖ

923
02:24:08,868 --> 02:24:21,167
فَإِن لَّمۡ يَكُونَا رَجُلَيۡنِ فَرَجُلٞ وَٱمۡرَأَتَانِ مِمَّن تَرۡضَوۡنَ مِنَ ٱلشُّهَدَآءِ

924
02:24:21,168 --> 02:24:37,193
فَرَجُلٞ وَٱمۡرَأَتَانِ مِمَّن تَرۡضَوۡنَ مِنَ ٱلشُّهَدَآءِ أَن تَضِلَّ إِحۡدَىٰهُمَا فَتُذَكِّرَ إِحۡدَىٰهُمَا ٱلۡأُخۡرَىٰۚ

925
02:24:37,194 --> 02:24:44,587
وَلَا يَأۡبَ ٱلشُّهَدَآءُ إِذَا مَا دُعُواْۚ

926
02:24:44,588 --> 02:24:55,047
وَلَا تَسۡـَٔمُوٓاْ أَن تَكۡتُبُوهُ صَغِيرًا أَوۡ كَبِيرًا إِلَىٰٓ أَجَلِهِۦۚ

927
02:24:55,048 --> 02:25:05,993
ذَٰلِكُمۡ أَقۡسَطُ عِندَ ٱللَّهِ وَأَقۡوَمُ لِلشَّهَٰدَةِ وَأَدۡنَىٰٓ أَلَّا تَرۡتَابُوٓاْ

928
02:25:05,994 --> 02:25:16,813
إِلَّآ أَن تَكُونَ تِجَٰرَةً حَاضِرَةٗ تُدِيرُونَهَا بَيۡنَكُمۡ

929
02:25:16,814 --> 02:25:23,020
فَلَيۡسَ عَلَيۡكُمۡ جُنَاحٌ أَلَّا تَكۡتُبُوهَاۗ

930
02:25:23,021 --> 02:25:29,600
وَأَشۡهِدُوٓاْ إِذَا تَبَايَعۡتُمۡۚ

931
02:25:29,601 --> 02:25:38,060
وَلَا يُضَآرَّ كَاتِبٞ وَلَا شَهِيدٞۚ

932
02:25:38,061 --> 02:25:45,893
وَإِن تَفۡعَلُواْ فَإِنَّهُۥ فُسُوقُۢ بِكُمۡۗ

933
02:25:45,894 --> 02:25:51,260
وَٱتَّقُواْ ٱللَّهَۖ

934
02:25:51,261 --> 02:25:56,573
وَيُعَلِّمُكُمُ ٱللَّهُۗ

935
02:25:56,574 --> 02:26:03,373
وَٱللَّهُ بِكُلِّ شَيۡءٍ عَلِيمٞ ٢٨٢

936
02:26:03,374 --> 02:26:15,433
وَإِن كُنتُمۡ عَلَىٰ سَفَرٖ وَلَمۡ تَجِدُواْ كَاتِبٗا فَرِهَٰنٞ مَّقۡبُوضَةٞۖ

937
02:26:15,434 --> 02:26:27,973
فَإِنۡ أَمِنَ بَعۡضُكُم بَعۡضٗا فَلۡيُؤَدِّ ٱلَّذِي ٱؤۡتُمِنَ أَمَٰنَتَهُۥ وَلۡيَتَّقِ ٱللَّهَ رَبَّهُۥۗ

938
02:26:27,974 --> 02:26:31,267
وَلَا تَكۡتُمُواْ ٱلشَّهَٰدَةَۚ

939
02:26:31,268 --> 02:26:39,400
وَمَن يَكۡتُمۡهَا فَإِنَّهُۥٓ ءَاثِمٞ قَلۡبُهُۥۗ

940
02:26:39,401 --> 02:26:44,920
وَٱللَّهُ بِمَا تَعۡمَلُونَ عَلِيمٞ ٢٨٣

941
02:26:44,921 --> 02:26:50,453
لِّلَّهِ مَا فِي ٱلسَّمَٰوَٰتِ وَمَا فِي ٱلۡأَرۡضِۗ

942
02:26:50,454 --> 02:27:02,813
وَإِن تُبۡدُواْ مَا فِيٓ أَنفُسِكُمۡ أَوۡ تُخۡفُوهُ يُحَاسِبۡكُم بِهِ ٱللَّهُۖ

943
02:27:02,814 --> 02:27:12,167
فَيَغۡفِرُ لِمَن يَشَآءُ وَيُعَذِّبُ مَن يَشَآءُۗ

944
02:27:12,168 --> 02:27:18,033
وَٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ قَدِيرٌ ٢٨٤

945
02:27:18,034 --> 02:27:28,407
ءَامَنَ ٱلرَّسُولُ بِمَآ أُنزِلَ إِلَيۡهِ مِن رَّبِّهِۦ وَٱلۡمُؤۡمِنُونَۚ

946
02:27:28,408 --> 02:27:37,280
كُلٌّ ءَامَنَ بِٱللَّهِ وَمَلَـٰٓئِكَتِهِۦ وَكُتُبِهِۦ وَرُسُلِهِۦ

947
02:27:37,281 --> 02:27:42,340
لَا نُفَرِّقُ بَيۡنَ أَحَدٖ مِّن رُّسُلِهِۦۚ

948
02:27:42,341 --> 02:27:47,100
وَقَالُواْ سَمِعۡنَا وَأَطَعۡنَاۖ

949
02:27:47,101 --> 02:27:53,353
غُفۡرَانَكَ رَبَّنَا وَإِلَيۡكَ ٱلۡمَصِيرُ ٢٨٥

950
02:27:53,354 --> 02:27:59,580
لَا يُكَلِّفُ ٱللَّهُ نَفۡسًا إِلَّا وُسۡعَهَاۚ

951
02:27:59,581 --> 02:28:04,513
لَهَا مَا كَسَبَتۡ وَعَلَيۡهَا مَا ٱكۡتَسَبَتۡۗ

952
02:28:04,514 --> 02:28:14,233
رَبَّنَا لَا تُؤَاخِذۡنَآ إِن نَّسِينَآ أَوۡ أَخۡطَأۡنَاۚ

953
02:28:14,234 --> 02:28:27,613
رَبَّنَا وَلَا تَحۡمِلۡ عَلَيۡنَآ إِصۡرٗا كَمَا حَمَلۡتَهُۥ عَلَى ٱلَّذِينَ مِن قَبۡلِنَاۚ

954
02:28:27,614 --> 02:28:34,733
رَبَّنَا وَلَا تُحَمِّلۡنَا مَا لَا طَاقَةَ لَنَا بِهِۦۖ

955
02:28:34,734 --> 02:28:40,907
وَٱعۡفُ عَنَّا وَٱغۡفِرۡ لَنَا وَٱرۡحَمۡنَآۚ

956
02:28:40,908 --> 02:28:47,680
أَنتَ مَوۡلَىٰنَا فَٱنصُرۡنَا

957
02:28:47,681 --> 02:28:58,429
فَٱنصُرۡنَا عَلَى ٱلۡقَوۡمِ ٱلۡكَٰفِرِينَ ٢٨٦